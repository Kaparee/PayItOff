<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:PayItOff.MauiClient"
             xmlns:helpers="clr-namespace:PayItOff.MauiClient.Helpers"
             x:Class="PayItOff.MauiClient.App">
    <Application.Resources>
        <ResourceDictionary>
            <helpers:InverseStringNullOrEmptyConverter x:Key="InverseStringNullOrEmptyConverter" />
            <helpers:AllTrueConverter x:Key="AllTrueConverter" />
            <helpers:IsAlertErrorToColorConverter x:Key="IsAlertErrorToColorConverter" />
            <helpers:IntToBoolConverter x:Key="IntToBoolConverter" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
