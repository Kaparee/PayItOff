<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PayItOff.MauiClient.Controls.SidebarMenu"
             x:Name="thisSidebar">

    <ContentView.Resources>
        <ResourceDictionary>
            <Style x:Key="MenuItemStyle" TargetType="Grid">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup Name="CommonStates">
                            <VisualState Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="Transparent" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="#1E232D" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>
        </ResourceDictionary>
    </ContentView.Resources>

    <Border BackgroundColor="{StaticResource SurfaceDark}" StrokeThickness="0">
        <Grid RowDefinitions="*, Auto" Padding="0,25,0,25">

            <ScrollView Grid.Row="0" VerticalScrollBarVisibility="Never">
                <VerticalStackLayout Spacing="10">
                    <Label Text="PayItOff!"
                           FontSize="42"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextMain}"
                           Margin="25,30,25,40"/>

                    <!-- HOME -->
                    <Grid Style="{StaticResource MenuItemStyle}" ColumnDefinitions="6, *" Padding="10">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="//MainPage" />
                        </Grid.GestureRecognizers>

                        <!-- ZIELONY WSKAŹNIK (Z CornerRadius) -->
                        <BoxView Grid.Column="0" WidthRequest="4" HeightRequest="44" VerticalOptions="Center" Color="Transparent" CornerRadius="2">
                            <BoxView.Triggers>
                                <DataTrigger TargetType="BoxView" Binding="{Binding ActiveTab, Source={x:Reference thisSidebar}}" Value="Home">
                                    <Setter Property="Color" Value="#00FF7F" />
                                </DataTrigger>
                            </BoxView.Triggers>
                        </BoxView>

                        <HorizontalStackLayout Grid.Column="1" Spacing="15" Padding="15,12" Opacity="0.7">
                            <HorizontalStackLayout.Triggers>
                                <DataTrigger TargetType="HorizontalStackLayout" Binding="{Binding ActiveTab, Source={x:Reference thisSidebar}}" Value="Home">
                                    <Setter Property="Opacity" Value="1.0" />
                                </DataTrigger>
                            </HorizontalStackLayout.Triggers>
                            <Image Source="home_icon.png" WidthRequest="44" HeightRequest="44" />
                            <Label Text="Menu Główne" FontAttributes="Bold" VerticalOptions="Center" FontSize="22" TextColor="{StaticResource TextSubtle}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding ActiveTab, Source={x:Reference thisSidebar}}" Value="Home">
                                        <Setter Property="TextColor" Value="White" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </HorizontalStackLayout>
                    </Grid>

                    <!-- GRUPY -->
                    <Grid Style="{StaticResource MenuItemStyle}" ColumnDefinitions="6, *" Padding="10">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="//GroupsPage" />
                        </Grid.GestureRecognizers>
                        <BoxView Grid.Column="0" WidthRequest="4" HeightRequest="44" VerticalOptions="Center" Color="Transparent" CornerRadius="2">
                            <BoxView.Triggers>
                                <DataTrigger TargetType="BoxView" Binding="{Binding ActiveTab, Source={x:Reference thisSidebar}}" Value="Groups">
                                    <Setter Property="Color" Value="#00FF7F" />
                                </DataTrigger>
                            </BoxView.Triggers>
                        </BoxView>

                        <HorizontalStackLayout Grid.Column="1" Spacing="15" Padding="15,12" Opacity="0.7">
                            <HorizontalStackLayout.Triggers>
                                <DataTrigger TargetType="HorizontalStackLayout" Binding="{Binding ActiveTab, Source={x:Reference thisSidebar}}" Value="Groups">
                                    <Setter Property="Opacity" Value="1.0" />
                                </DataTrigger>
                            </HorizontalStackLayout.Triggers>
                            <Image Source="groups_icon.png" WidthRequest="44" HeightRequest="44" />
                            <Label Text="Twoje Grupy" FontAttributes="Bold" VerticalOptions="Center" FontSize="22" TextColor="{StaticResource TextSubtle}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding ActiveTab, Source={x:Reference thisSidebar}}" Value="Groups">
                                        <Setter Property="TextColor" Value="White" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </HorizontalStackLayout>
                    </Grid>

                    <!-- ZNAJOMI -->
                    <Grid Style="{StaticResource MenuItemStyle}" ColumnDefinitions="6, *" Padding="10">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="//FriendsPage" />
                        </Grid.GestureRecognizers>
                        <BoxView Grid.Column="0" WidthRequest="4" HeightRequest="44" VerticalOptions="Center" Color="Transparent" CornerRadius="2">
                            <BoxView.Triggers>
                                <DataTrigger TargetType="BoxView" Binding="{Binding ActiveTab, Source={x:Reference thisSidebar}}" Value="Friends">
                                    <Setter Property="Color" Value="#00FF7F" />
                                </DataTrigger>
                            </BoxView.Triggers>
                        </BoxView>
                        <HorizontalStackLayout Grid.Column="1" Spacing="15" Padding="15,12" Opacity="0.7">
                            <HorizontalStackLayout.Triggers>
                                <DataTrigger TargetType="HorizontalStackLayout" Binding="{Binding ActiveTab, Source={x:Reference thisSidebar}}" Value="Friends">
                                    <Setter Property="Opacity" Value="1.0" />
                                </DataTrigger>
                            </HorizontalStackLayout.Triggers>
                            <Image Source="friends_icon.png" WidthRequest="44" HeightRequest="44" />
                            <Label Text="Twoi Znajomi" FontAttributes="Bold" VerticalOptions="Center" FontSize="22" TextColor="{StaticResource TextSubtle}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding ActiveTab, Source={x:Reference thisSidebar}}" Value="Friends">
                                        <Setter Property="TextColor" Value="White" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </HorizontalStackLayout>
                    </Grid>

                    <!-- KONTO -->
                    <Grid Style="{StaticResource MenuItemStyle}" ColumnDefinitions="6, *" Padding="10">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="//AccountPage" />
                        </Grid.GestureRecognizers>
                        <BoxView Grid.Column="0" WidthRequest="4" HeightRequest="44" VerticalOptions="Center" Color="Transparent" CornerRadius="2">
                            <BoxView.Triggers>
                                <DataTrigger TargetType="BoxView" Binding="{Binding ActiveTab, Source={x:Reference thisSidebar}}" Value="Account">
                                    <Setter Property="Color" Value="#00FF7F" />
                                </DataTrigger>
                            </BoxView.Triggers>
                        </BoxView>
                        <HorizontalStackLayout Grid.Column="1" Spacing="15" Padding="15,12" Opacity="0.7">
                            <HorizontalStackLayout.Triggers>
                                <DataTrigger TargetType="HorizontalStackLayout" Binding="{Binding ActiveTab, Source={x:Reference thisSidebar}}" Value="Account">
                                    <Setter Property="Opacity" Value="1.0" />
                                </DataTrigger>
                            </HorizontalStackLayout.Triggers>
                            <Image Source="wallet_icon.png" WidthRequest="44" HeightRequest="44" />
                            <Label Text="Twoje Konto" FontAttributes="Bold" VerticalOptions="Center" FontSize="22" TextColor="{StaticResource TextSubtle}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding ActiveTab, Source={x:Reference thisSidebar}}" Value="Account">
                                        <Setter Property="TextColor" Value="White" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </HorizontalStackLayout>
                    </Grid>

                    <!-- POWIADOMIENIA -->
                    <Grid Style="{StaticResource MenuItemStyle}" ColumnDefinitions="6, *" Padding="10">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="//NotificationsPage" />
                        </Grid.GestureRecognizers>
                        <BoxView Grid.Column="0" WidthRequest="4" HeightRequest="44" VerticalOptions="Center" Color="Transparent" CornerRadius="2">
                            <BoxView.Triggers>
                                <DataTrigger TargetType="BoxView" Binding="{Binding ActiveTab, Source={x:Reference thisSidebar}}" Value="Notifications">
                                    <Setter Property="Color" Value="#00FF7F" />
                                </DataTrigger>
                            </BoxView.Triggers>
                        </BoxView>
                        <HorizontalStackLayout Grid.Column="1" Spacing="15" Padding="15,12" Opacity="0.7">
                            <HorizontalStackLayout.Triggers>
                                <DataTrigger TargetType="HorizontalStackLayout" Binding="{Binding ActiveTab, Source={x:Reference thisSidebar}}" Value="Notifications">
                                    <Setter Property="Opacity" Value="1.0" />
                                </DataTrigger>
                            </HorizontalStackLayout.Triggers>
                            <Image Source="notifications_icon.png" WidthRequest="44" HeightRequest="44" />
                            <Label Text="Powiadomienia" FontAttributes="Bold" VerticalOptions="Center" FontSize="22" TextColor="{StaticResource TextSubtle}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding ActiveTab, Source={x:Reference thisSidebar}}" Value="Notifications">
                                        <Setter Property="TextColor" Value="White" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </HorizontalStackLayout>
                    </Grid>

                    <!-- ARCHIWUM -->
                    <Grid Style="{StaticResource MenuItemStyle}" ColumnDefinitions="6, *" Padding="10">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="//ArchivePage" />
                        </Grid.GestureRecognizers>
                        <BoxView Grid.Column="0" WidthRequest="4" HeightRequest="44" VerticalOptions="Center" Color="Transparent" CornerRadius="2">
                            <BoxView.Triggers>
                                <DataTrigger TargetType="BoxView" Binding="{Binding ActiveTab, Source={x:Reference thisSidebar}}" Value="Archive">
                                    <Setter Property="Color" Value="#00FF7F" />
                                </DataTrigger>
                            </BoxView.Triggers>
                        </BoxView>
                        <HorizontalStackLayout Grid.Column="1" Spacing="15" Padding="15,12" Opacity="0.7">
                            <HorizontalStackLayout.Triggers>
                                <DataTrigger TargetType="HorizontalStackLayout" Binding="{Binding ActiveTab, Source={x:Reference thisSidebar}}" Value="Archive">
                                    <Setter Property="Opacity" Value="1.0" />
                                </DataTrigger>
                            </HorizontalStackLayout.Triggers>
                            <Image Source="archive_icon.png" WidthRequest="44" HeightRequest="44" />
                            <Label Text="Archiwum" FontAttributes="Bold" VerticalOptions="Center" FontSize="22" TextColor="{StaticResource TextSubtle}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding ActiveTab, Source={x:Reference thisSidebar}}" Value="Archive">
                                        <Setter Property="TextColor" Value="White" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </HorizontalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </ScrollView>

            <!-- WYLOGOWANIE -->
            <VerticalStackLayout Grid.Row="1" Spacing="5">
                <BoxView HeightRequest="1" Color="{StaticResource Border}" Opacity="0.5"/>
                <Grid Style="{StaticResource MenuItemStyle}" ColumnDefinitions="6, *" Padding="10">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding LogoutCommand}" />
                    </Grid.GestureRecognizers>
                    <BoxView Grid.Column="0" WidthRequest="4" Color="Transparent" />
                    <HorizontalStackLayout Grid.Column="1" Spacing="15" Padding="15,12">
                        <Image Source="logout_icon.png" WidthRequest="32" HeightRequest="32" VerticalOptions="Center"/>
                        <Label Text="Wyloguj się" TextColor="{StaticResource StatusRed}" VerticalOptions="Center" FontSize="20" FontAttributes="Bold"/>
                    </HorizontalStackLayout>
                </Grid>
            </VerticalStackLayout>
        </Grid>
    </Border>
</ContentView>
