<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:PayItOff.MauiClient.Controls"
             xmlns:viewmodels="clr-namespace:PayItOff.MauiClient.ViewModels"
             xmlns:converters="clr-namespace:PayItOff.MauiClient.Converters"
             x:Class="PayItOff.MauiClient.Views.FriendsPage"
             Title="{Binding Title}"
             BackgroundColor="{StaticResource MainBackground}"
             Shell.NavBarIsVisible="False"
             x:Name="thisPage">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:InverseBoolConverter x:Key="InverseBool" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <!-- WARSTWA 1: GŁÓWNY INTERFEJS -->
        <Grid ColumnDefinitions="{OnIdiom Phone='0, *', Default='360, *'}">

            <!-- MENU BOCZNE -->
            <controls:SidebarMenu Grid.Column="0"
                                   ActiveTab="Friends"
                                   IsVisible="{OnIdiom Phone=False, Default=True}" />

            <!-- ZAWARTOŚĆ GŁÓWNA -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Menu na telefonie -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto, *" IsVisible="{OnIdiom Phone=True, Default=False}" Margin="{OnPlatform iOS='0,40,0,0', Android='0,25,0,0', Default='0,10,0,0'}">
                    <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                        <Image Source="payitoff_logo_img.png" WidthRequest="32" HeightRequest="32" VerticalOptions="Center" />
                        <Label Text="PayItOff" FontSize="20" FontAttributes="Bold" TextColor="White" VerticalOptions="Center"/>
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Grid.Column="1" HorizontalOptions="End" Spacing="10" VerticalOptions="Center" BackgroundColor="Transparent">
                        <HorizontalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleMenuCommand}" />
                        </HorizontalStackLayout.GestureRecognizers>
                        <Label Text="MENU" TextColor="White" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                        <Image Source="phone_menu_icon.png" WidthRequest="28" HeightRequest="28" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Grid>

                <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
                    <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto" Padding="{OnIdiom Phone='15,20,15,40', Default='40,30,40,40'}">

                <!-- Sekcja podsumowania (top dłużnicy i top długi) -->
                <Grid Grid.Row="0" ColumnDefinitions="{OnIdiom Phone='*', Default='*, *'}" RowDefinitions="{OnIdiom Phone='Auto, Auto', Default='*'}" ColumnSpacing="25" RowSpacing="20" Margin="0,0,0,30">
                    <!-- Karta: top dłużnicy -->
                    <Border Grid.Column="0" StrokeShape="RoundRectangle 15" BackgroundColor="{StaticResource SurfaceDark}" Padding="5, 20" StrokeThickness="0">
                        <Grid RowDefinitions="Auto, *, Auto, Auto" RowSpacing="15">
                            <Label Grid.Row="0" Text="Top Dłużnicy" TextColor="{StaticResource StatusGreen}" FontSize="{OnIdiom Phone=22, Default=32}" HorizontalOptions="Center" FontAttributes="Bold" />
                                    <CollectionView Grid.Row="1" ItemsSource="{Binding TopDebtors}">
                                        <CollectionView.EmptyView>
                                            <Label Text="Brak dłużników" TextColor="{StaticResource TextSubtle}" HorizontalOptions="Center" Padding="30"/>
                                        </CollectionView.EmptyView>
                                        <CollectionView.ItemTemplate>
                                            <DataTemplate>
                                                <ContentView Padding="0,0,0,5">
                                                    <Border StrokeShape="RoundRectangle 10" BackgroundColor="{StaticResource MainBackground}" Padding="15,15" StrokeThickness="0">
                                                        <Grid ColumnDefinitions="70, *, Auto" ColumnSpacing="20">
                                                            <!-- Awatar -->
                                                            <Border Grid.Column="0" HeightRequest="70" WidthRequest="70" StrokeShape="RoundRectangle 15" StrokeThickness="0" VerticalOptions="Center" BackgroundColor="#1E232D">
                                                                <Grid>
                                                                    <Image Source="default_user_avatar.png" Aspect="AspectFill" IsVisible="{Binding AvatarUrl, Converter={StaticResource InverseStringNullOrEmptyConverter}}" />
                                                                    <Image Source="{Binding AvatarUrl}" Aspect="AspectFill" />
                                                                </Grid>
                                                            </Border>

                                                            <!-- Dane znajomego -->
                                                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                                                <Label Text="{Binding FullName}" TextColor="{StaticResource TextMain}" FontAttributes="Bold" FontSize="{OnIdiom Phone=12, Default=18}"/>
                                                            </VerticalStackLayout>

                                                            <!-- Kwota -->
                                                            <Label Grid.Column="2" Text="{Binding IncomeFormatted}" TextColor="{StaticResource StatusGreen}" FontAttributes="Bold" FontSize="{OnIdiom Phone=12, Default=20}" VerticalOptions="Center" HorizontalOptions="End"/>
                                                        </Grid>
                                                    </Border>
                                                </ContentView>
                                            </DataTemplate>
                                        </CollectionView.ItemTemplate>
                                    </CollectionView>

                                    <BoxView Grid.Row="2" HeightRequest="1" Color="{StaticResource Border}" Margin="0,5"/>
                            <Label Grid.Row="3" Text="{Binding BindingContext.TotalOwedToMe, Source={x:Reference thisPage}, StringFormat='Suma: {0:N2} zł'}" TextColor="{StaticResource TextMain}" HorizontalOptions="End" FontAttributes="Bold" FontSize="18" Padding="10,0"/>
                        </Grid>
                    </Border>

                    <!-- Karta: top długi -->
                    <Border Grid.Column="{OnIdiom Phone=0, Default=1}" Grid.Row="{OnIdiom Phone=1, Default=0}" StrokeShape="RoundRectangle 15" BackgroundColor="{StaticResource SurfaceDark}" Padding="5, 20" StrokeThickness="0">
                        <Grid RowDefinitions="Auto, *, Auto, Auto" RowSpacing="15">
                            <Label Grid.Row="0" Text="Top Długi" TextColor="{StaticResource StatusRed}" FontSize="{OnIdiom Phone=22, Default=32}" HorizontalOptions="Center" FontAttributes="Bold" />
                                    <CollectionView Grid.Row="1" ItemsSource="{Binding TopDebts}">
                                        <CollectionView.EmptyView>
                                            <Label Text="Brak wierzycieli" TextColor="{StaticResource TextSubtle}" HorizontalOptions="Center" Padding="30"/>
                                        </CollectionView.EmptyView>
                                        <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                        <ContentView Padding="0,0,0,5">
                                            <Border StrokeShape="RoundRectangle 10" BackgroundColor="{StaticResource MainBackground}" Padding="15,15" StrokeThickness="0">
                                                <Grid ColumnDefinitions="70, *, Auto" ColumnSpacing="20">
                                                    <!-- Awatar -->
                                                    <Border Grid.Column="0" HeightRequest="70" WidthRequest="70" StrokeShape="RoundRectangle 15" StrokeThickness="0" VerticalOptions="Center" BackgroundColor="#1E232D">
                                                        <Grid>
                                                            <Image Source="default_user_avatar.png" Aspect="AspectFill" IsVisible="{Binding AvatarUrl, Converter={StaticResource InverseStringNullOrEmptyConverter}}" />
                                                            <Image Source="{Binding AvatarUrl}" Aspect="AspectFill" />
                                                        </Grid>
                                                    </Border>

                                                    <!-- Dane znajomego -->
                                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                                        <Label Text="{Binding FullName}" TextColor="{StaticResource TextMain}" FontAttributes="Bold" FontSize="{OnIdiom Phone=12, Default=18}"/>
                                                    </VerticalStackLayout>

                                                    <!-- Kwota -->
                                                    <Label Grid.Column="2" Text="{Binding ExpenseFormatted}" TextColor="{StaticResource StatusRed}" FontAttributes="Bold" FontSize="{OnIdiom Phone=12, Default=20}" VerticalOptions="Center" HorizontalOptions="End"/>
                                                </Grid>
                                            </Border>
                                        </ContentView>
                                    </DataTemplate>
                                        </CollectionView.ItemTemplate>
                                    </CollectionView>

                            <BoxView Grid.Row="2" HeightRequest="1" Color="{StaticResource Border}" Margin="0,5"/>
                            <Label Grid.Row="3" Text="{Binding BindingContext.TotalOwed, Source={x:Reference thisPage}, StringFormat='Suma: {0:N2} zł'}" TextColor="{StaticResource TextMain}" HorizontalOptions="End" FontAttributes="Bold" FontSize="18" Padding="10,0"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- NAGŁÓWEK I WYSZUKIWARKA -->
                <Grid Grid.Row="1" ColumnDefinitions="{OnIdiom Phone='*, Auto', Default='320, *, 320'}" ColumnSpacing="15" HeightRequest="{OnIdiom Phone=-1, Default=60}" Margin="0,0,0,20">
                    <!-- Wyszukiwarka (po lewej) -->
                    <Border Grid.Column="0" HorizontalOptions="{OnIdiom Phone='Fill', Default='Start'}" VerticalOptions="Center"
                            StrokeShape="RoundRectangle 20" BackgroundColor="Transparent"
                            Stroke="#444" StrokeThickness="1" WidthRequest="{OnIdiom Phone=-1, Default=320}" HeightRequest="40" Padding="15,0">
                        <SearchBar Placeholder="Wpisz dane znajomego..."
                                   PlaceholderColor="#666" TextColor="White" FontSize="14"
                                   VerticalOptions="Center" BackgroundColor="Transparent"
                                   Text="{Binding SearchQuery}" CancelButtonColor="{StaticResource TextSubtle}"
                                   Margin="-10,0,0,0"/>
                    </Border>

                    <!-- Napis Znajomi (na środku, ukryty na telefonie) -->
                    <Label Grid.Column="1" IsVisible="{OnIdiom Phone=False, Default=True}" Text="Znajomi" TextColor="White" FontSize="26" FontAttributes="Bold"
                            HorizontalOptions="Center" VerticalOptions="Center" />

                    <!-- Przycisk zaproszenia (po prawej) -->
                    <Border StrokeShape="RoundRectangle 10" Grid.Column="{OnIdiom Phone=1, Default=2}" BackgroundColor="Transparent" StrokeThickness="0" HeightRequest="45" WidthRequest="45"
                            HorizontalOptions="End" VerticalOptions="Center" ToolTipProperties.Text="Dodaj znajomego">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ShowInvitePopupCommand}" />
                        </Border.GestureRecognizers>
                        <Image Source="friends_icon_green.png" WidthRequest="{OnIdiom Phone=22, Default=28}" HeightRequest="{OnIdiom Phone=22, Default=28}" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                </Grid>

                <!-- Zakładki / filtry znajomych -->
                <Grid Grid.Row="2" ColumnDefinitions="*, *, *" ColumnSpacing="15" Margin="0,0,0,20">
                    <!-- Zakładka 1: znajomi -->
                    <Border StrokeShape="RoundRectangle 10" Grid.Column="0" BackgroundColor="{StaticResource SurfaceDark}" Padding="15" StrokeThickness="2" Stroke="Transparent">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding ActiveFilter}" Value="Friends">
                                <Setter Property="Stroke" Value="#7F00FF" />
                                <Setter Property="BackgroundColor" Value="#251E38" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ChangeFilterCommand}" CommandParameter="Friends" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout HorizontalOptions="Center">
                            <Label Text="{Binding FriendsCount}" FontSize="{OnIdiom Phone=20, Default=24}" FontAttributes="Bold" TextColor="{StaticResource TextMain}" HorizontalOptions="Center"/>
                            <Label Text="Znajomi" FontSize="12" TextColor="{StaticResource TextSubtle}" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Zakładka 2: wysłane -->
                    <Border StrokeShape="RoundRectangle 10" Grid.Column="1" BackgroundColor="{StaticResource SurfaceDark}" Padding="15" StrokeThickness="2" Stroke="Transparent">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding ActiveFilter}" Value="Sent">
                                <Setter Property="Stroke" Value="#F59E0B" />
                                <Setter Property="BackgroundColor" Value="#2A241A" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ChangeFilterCommand}" CommandParameter="Sent" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout HorizontalOptions="Center">
                            <Label Text="{Binding SentCount}" FontSize="{OnIdiom Phone=20, Default=24}" FontAttributes="Bold" TextColor="#F59E0B" HorizontalOptions="Center"/>
                            <Label Text="Wysłane" FontSize="12" TextColor="{StaticResource TextSubtle}" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Zakładka 3: oczekujące -->
                    <Border StrokeShape="RoundRectangle 10" Grid.Column="2" BackgroundColor="{StaticResource SurfaceDark}" Padding="15" StrokeThickness="2" Stroke="Transparent">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding ActiveFilter}" Value="Pending">
                                <Setter Property="Stroke" Value="{StaticResource StatusGreen}" />
                                <Setter Property="BackgroundColor" Value="#1A2A22" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ChangeFilterCommand}" CommandParameter="Pending" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout HorizontalOptions="Center">
                            <Label Text="{Binding PendingCount}" FontSize="{OnIdiom Phone=20, Default=24}" FontAttributes="Bold" TextColor="{StaticResource StatusGreen}" HorizontalOptions="Center"/>
                            <Label Text="Oczekujące" FontSize="12" TextColor="{StaticResource TextSubtle}" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- NAGŁÓWKI KOLUMN TABELI -->
                <Grid Grid.Row="3" IsVisible="{OnIdiom Phone=False, Default=True}" ColumnDefinitions="60, 2*, 1.5*, 1.8*, 1.5*, 1.2*, 90" ColumnSpacing="15" Padding="20,0" Margin="0,0,0,15">
                    <Label Grid.Column="1" Text="Imię i nazwisko" TextColor="{StaticResource TextSubtle}" FontSize="13" FontAttributes="Bold" VerticalOptions="Center"/>
                    <Label Grid.Column="2" Text="Nazwa użytkownika" TextColor="{StaticResource TextSubtle}" FontSize="13" FontAttributes="Bold" VerticalOptions="Center"/>
                    <Label Grid.Column="3" Text="Numer telefonu" TextColor="{StaticResource TextSubtle}" FontSize="13" FontAttributes="Bold" VerticalOptions="Center"/>
                    <Label Grid.Column="4" Text="Wspólne grupy" TextColor="{StaticResource TextSubtle}" FontSize="13" FontAttributes="Bold" VerticalOptions="Center"/>
                    <Label Grid.Column="5" Text="Różnica" TextColor="{StaticResource TextSubtle}" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="Start"/>
                </Grid>

                <!-- OBSZAR LISTY -->
                <VerticalStackLayout Grid.Row="4" BindableLayout.ItemsSource="{Binding Friends}" Spacing="0">
                    <BindableLayout.EmptyView>
                        <Label Text="{Binding EmptyListMessage}" TextColor="{StaticResource TextSubtle}" HorizontalOptions="Center" Padding="40" FontSize="16" FontAttributes="Bold" />
                    </BindableLayout.EmptyView>
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="0,0,0,15">
                                <!-- KARTA ZNAJOMEGO -->
                                <Border StrokeShape="RoundRectangle 15"
                                        BackgroundColor="{StaticResource SurfaceDark}"
                                        Padding="20" StrokeThickness="1" Stroke="{StaticResource Border}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding BindingContext.ShowFriendDetailsPopupCommand, Source={x:Reference thisPage}}" CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsSentPending}" Value="True">
                                            <Setter Property="Stroke" Value="#F59E0B" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsReceivedPending}" Value="True">
                                            <Setter Property="Stroke" Value="#10B981" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Grid ColumnDefinitions="{OnIdiom Phone='60, *, Auto', Default='60, 2*, 1.5*, 1.8*, 1.5*, 1.2*, 90'}" ColumnSpacing="15">

                                        <!-- Awatar Znajomego -->
                                        <Border Grid.Column="0" HeightRequest="60" WidthRequest="60"
                                                StrokeShape="RoundRectangle 30" StrokeThickness="0" BackgroundColor="#1E232D">
                                            <Grid>
                                                <Image Source="default_user_avatar.png" Aspect="AspectFill" IsVisible="{Binding AvatarUrl, Converter={StaticResource InverseStringNullOrEmptyConverter}}" />
                                                <Image Source="{Binding AvatarUrl}" Aspect="AspectFill" />
                                            </Grid>
                                        </Border>

                                        <!-- Imię i nazwisko (i saldo na telefonie) -->
                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                            <Label Text="{Binding FullName, TargetNullValue='Brak danych'}" TextColor="White" FontSize="16" FontAttributes="Bold" MaxLines="2" LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding BalanceAbsoluteFormatted}" TextColor="{Binding BalanceColor}" FontSize="14" FontAttributes="Bold" IsVisible="{OnIdiom Phone=True, Default=False}" />
                                        </VerticalStackLayout>

                                        <!-- Nazwa użytkownika -->
                                        <Label Grid.Column="2" IsVisible="{OnIdiom Phone=False, Default=True}" Text="{Binding Nickname, TargetNullValue='Brak danych'}" TextColor="White" FontSize="15" VerticalOptions="Center" MaxLines="1" LineBreakMode="TailTruncation">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding HasNickname}" Value="False">
                                                    <Setter Property="TextColor" Value="{StaticResource TextSubtle}" />
                                                    <Setter Property="FontSize" Value="13" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>

                                        <!-- Numer telefonu -->
                                        <Label Grid.Column="3" IsVisible="{OnIdiom Phone=False, Default=True}" Text="{Binding PhoneNumber, TargetNullValue='Brak danych'}" TextColor="White" FontSize="15" VerticalOptions="Center" MaxLines="1" LineBreakMode="TailTruncation">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding HasPhoneNumber}" Value="False">
                                                    <Setter Property="TextColor" Value="{StaticResource TextSubtle}" />
                                                    <Setter Property="FontSize" Value="13" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>

                                        <!-- Wspólne grupy -->
                                        <Grid Grid.Column="4" IsVisible="{OnIdiom Phone=False, Default=True}" VerticalOptions="Center">
                                            <HorizontalStackLayout BindableLayout.ItemsSource="{Binding SharedGroupsDisplay}" Spacing="-12" IsVisible="{Binding HasSharedGroups}">
                                                <HorizontalStackLayout.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding BindingContext.ShowSharedGroupsPopupCommand, Source={x:Reference thisPage}}" CommandParameter="{Binding .}" />
                                                </HorizontalStackLayout.GestureRecognizers>
                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border WidthRequest="44" HeightRequest="44" StrokeShape="RoundRectangle 22" Stroke="{StaticResource SurfaceDark}" StrokeThickness="2" BackgroundColor="#1E232D"
                                                                ZIndex="{Binding ZIndex}">
                                                            <Grid>
                                                                <Grid IsVisible="{Binding IsMoreIndicator, Converter={StaticResource InverseBool}}">
                                                                    <Image Source="default_group_avatar.png" Aspect="AspectFill" IsVisible="{Binding AvatarUrl, Converter={StaticResource InverseStringNullOrEmptyConverter}}" />
                                                                    <Image Source="{Binding AvatarUrl}" Aspect="AspectFill" />
                                                                </Grid>
                                                                <Grid IsVisible="{Binding IsMoreIndicator}" BackgroundColor="#242F41">
                                                                    <Label Text="{Binding MoreText}" TextColor="White" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                                                                </Grid>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                            </HorizontalStackLayout>
                                            <Label Text="Brak wspólnych grup" TextColor="{StaticResource TextSubtle}" FontSize="13" VerticalOptions="Center" IsVisible="{Binding HasSharedGroups, Converter={StaticResource InverseBool}}" />
                                        </Grid>

                                        <!-- Różnica -->
                                        <Label Grid.Column="5"
                                               IsVisible="{OnIdiom Phone=False, Default=True}"
                                               Text="{Binding BalanceAbsoluteFormatted}"
                                               TextColor="{Binding BalanceColor}"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               VerticalOptions="Center"
                                               HorizontalOptions="Start"/>

                                        <!-- Przyciski akcji -->
                                        <HorizontalStackLayout Grid.Column="{OnIdiom Phone=2, Default=6}" Spacing="10" VerticalOptions="Center" HorizontalOptions="Center">
                                            <!-- ZAAKCEPTOWANI: Usuń -->
                                            <Border WidthRequest="36" HeightRequest="36" StrokeShape="RoundRectangle 8" Stroke="#EF4444" StrokeThickness="1" BackgroundColor="Transparent" ToolTipProperties.Text="Usuń znajomego" IsVisible="{Binding IsAccepted}">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:FriendsViewModel}}, Path=RemoveFriendCommand}" CommandParameter="{Binding .}" />
                                                </Border.GestureRecognizers>
                                                <Image Source="friend_remove_icon.png" WidthRequest="18" HeightRequest="18" HorizontalOptions="Center" VerticalOptions="Center"/>
                                            </Border>

                                            <!-- WYSŁANE: Wycofaj -->
                                            <Border WidthRequest="36" HeightRequest="36" StrokeShape="RoundRectangle 8" Stroke="#EF4444" StrokeThickness="1" BackgroundColor="Transparent" ToolTipProperties.Text="Wycofaj zaproszenie" IsVisible="{Binding IsSentPending}">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:FriendsViewModel}}, Path=RemoveFriendCommand}" CommandParameter="{Binding .}" />
                                                </Border.GestureRecognizers>
                                                <Image Source="x_icon.png" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                                            </Border>

                                            <!-- OCZEKUJĄCE: Zaakceptuj -->
                                            <Border WidthRequest="36" HeightRequest="36" StrokeShape="RoundRectangle 8" Stroke="#10B981" StrokeThickness="1" BackgroundColor="Transparent" ToolTipProperties.Text="Zaakceptuj zaproszenie" IsVisible="{Binding IsReceivedPending}">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:FriendsViewModel}}, Path=AcceptInviteCommand}" CommandParameter="{Binding .}" />
                                                </Border.GestureRecognizers>
                                                <Image Source="check_mark_icon.png" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                                            </Border>

                                            <!-- OCZEKUJĄCE: Odrzuć -->
                                            <Border WidthRequest="36" HeightRequest="36" StrokeShape="RoundRectangle 8" Stroke="#EF4444" StrokeThickness="1" BackgroundColor="Transparent" ToolTipProperties.Text="Odrzuć zaproszenie" IsVisible="{Binding IsReceivedPending}">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:FriendsViewModel}}, Path=RemoveFriendCommand}" CommandParameter="{Binding .}" />
                                                </Border.GestureRecognizers>
                                                <Image Source="x_icon.png" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                                            </Border>

                                        </HorizontalStackLayout>
                                    </Grid>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </Grid>
            </ScrollView>
            </Grid>
        </Grid>

        <!-- Mobile Menu Overlay -->
        <Grid IsVisible="{Binding IsMenuVisible}" BackgroundColor="#CC121212" ZIndex="100">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding ToggleMenuCommand}" />
            </Grid.GestureRecognizers>
            <controls:SidebarMenu HorizontalOptions="Start" ActiveTab="Friends" WidthRequest="300"/>
        </Grid>

        <!-- WARSTWA 2: popup wyszukiwania znajomego -->
        <Grid IsVisible="{Binding IsInvitePopupVisible}" Style="{StaticResource PopupOverlayStyle}">
            <Border StrokeShape="RoundRectangle 10" Style="{StaticResource PopupContainerStyle}" WidthRequest="450">
                <VerticalStackLayout Spacing="25">
                    <!-- Nagłówek -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Wyszukaj znajomego" FontSize="22" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center"/>
                        <Label Text="Wpisz dane do jednego z poniższych pól" FontSize="14" TextColor="{StaticResource TextSubtle}" HorizontalOptions="Center"/>
                    </VerticalStackLayout>

                    <!-- Pole 1: Nazwa użytkownika -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Nazwa użytkownika" TextColor="{StaticResource TextSubtle}" FontSize="13" HorizontalOptions="Center"/>
                        <Border StrokeShape="RoundRectangle 10" BackgroundColor="#242F41" StrokeThickness="0" Padding="15,0" HeightRequest="40">
                            <Entry Text="{Binding InviteNickname}"
                                   Placeholder="Wpisz tutaj nazwę użytkownika..."
                                   TextColor="White"
                                   PlaceholderColor="#666"
                                   BackgroundColor="Transparent"
                                   VerticalOptions="Center"
                                   HorizontalTextAlignment="Center"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Pole 2: adres e-mail -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Adres E-Mail" TextColor="{StaticResource TextSubtle}" FontSize="13" HorizontalOptions="Center"/>
                        <Border StrokeShape="RoundRectangle 10" BackgroundColor="#242F41" StrokeThickness="0" Padding="15,0" HeightRequest="40">
                            <Entry Text="{Binding InviteEmail}"
                                   Placeholder="Wpisz tutaj adres email..."
                                   Keyboard="Email"
                                   TextColor="White"
                                   PlaceholderColor="#666"
                                   BackgroundColor="Transparent"
                                   VerticalOptions="Center"
                                   HorizontalTextAlignment="Center"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Pole 3: numer telefonu -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Numer Telefonu" TextColor="{StaticResource TextSubtle}" FontSize="13" HorizontalOptions="Center"/>
                        <Border StrokeShape="RoundRectangle 10" BackgroundColor="#242F41" StrokeThickness="0" Padding="15,0" HeightRequest="40">
                            <Entry Text="{Binding InvitePhoneNumber}"
                                   Placeholder="Wpisz tutaj numer telefonu..."
                                   Keyboard="Telephone"
                                   TextColor="White"
                                   PlaceholderColor="#666"
                                   BackgroundColor="Transparent"
                                   VerticalOptions="Center"
                                   HorizontalTextAlignment="Center"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Znaleziony użytkownik (bloczek z awatarem, imieniem i nazwiskiem oraz nickiem) -->
                    <Border IsVisible="{Binding IsSearchedUserVisible}" BackgroundColor="#242F41" Padding="15" StrokeShape="RoundRectangle 15" StrokeThickness="1" Stroke="#10B981">
                        <Grid ColumnDefinitions="50, *, Auto" ColumnSpacing="15" VerticalOptions="Center">
                            <!-- Awatar -->
                            <Border Grid.Column="0" HeightRequest="50" WidthRequest="50" StrokeShape="RoundRectangle 25" StrokeThickness="0" BackgroundColor="#1E232D" VerticalOptions="Center">
                                <Grid>
                                    <Image Source="default_user_avatar.png" Aspect="AspectFill" IsVisible="{Binding SearchedUser.AvatarUrl, Converter={StaticResource InverseStringNullOrEmptyConverter}}" />
                                    <Image Source="{Binding SearchedUser.AvatarUrl}" Aspect="AspectFill" />
                                </Grid>
                            </Border>
                            <!-- Dane -->
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <HorizontalStackLayout Spacing="5">
                                    <Label Text="{Binding SearchedUser.Name}" TextColor="White" FontAttributes="Bold" FontSize="15" />
                                    <Label Text="{Binding SearchedUser.Surname}" TextColor="White" FontAttributes="Bold" FontSize="15" />
                                </HorizontalStackLayout>
                                <Label Text="{Binding SearchedUser.Nickname, StringFormat='@{0}'}" TextColor="{StaticResource TextSubtle}" FontSize="12" />
                            </VerticalStackLayout>
                            <!-- Odznaka -->
                            <Border StrokeShape="RoundRectangle 10" Grid.Column="2" BackgroundColor="#1A2A22" Stroke="#10B981" StrokeThickness="1" Padding="8,4" VerticalOptions="Center">
                                <Label Text="Znaleziono" TextColor="{StaticResource StatusGreen}" FontSize="11" FontAttributes="Bold" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Przyciski akcji -->
                    <Grid ColumnDefinitions="Auto, Auto" HorizontalOptions="Center" ColumnSpacing="20" Margin="0,10,0,0">
                        <controls:AppButton Grid.Column="0" Text="Cofnij" Command="{Binding CloseInvitePopupCommand}" ButtonBackgroundColor="{StaticResource StatusRed}" ButtonTextColor="{StaticResource TextMain}" WidthRequest="120" />
                        <controls:AppButton Grid.Column="1" Text="Zatwierdź" Command="{Binding ConfirmInviteCommand}" ButtonBackgroundColor="{StaticResource StatusGreen}" ButtonTextColor="{StaticResource TextMain}" WidthRequest="120" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- WARSTWA 3: popup potwierdzenia usunięcia znajomego -->
        <Grid IsVisible="{Binding IsDeletePopupVisible}" Style="{StaticResource PopupOverlayStyle}">
            <Border StrokeShape="RoundRectangle 10" Style="{StaticResource PopupContainerStyle}" WidthRequest="450">
                <VerticalStackLayout Spacing="25">
                    <!-- Nagłówek -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{Binding DeletePopupTitle}" FontSize="22" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center"/>
                        <Label Text="{Binding DeletePopupSubtitle}" FontSize="14" TextColor="{StaticResource TextSubtle}" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>

                    <!-- Profil znajomego do usunięcia -->
                    <Border BackgroundColor="{StaticResource MainBackground}" Padding="20" StrokeShape="RoundRectangle 15" StrokeThickness="0">
                        <Grid ColumnDefinitions="60, *" ColumnSpacing="20">
                            <!-- Awatar -->
                            <Border Grid.Column="0" HeightRequest="60" WidthRequest="60" StrokeShape="RoundRectangle 30" StrokeThickness="0" BackgroundColor="#1E232D" VerticalOptions="Center">
                                <Grid>
                                    <Image Source="default_user_avatar.png" Aspect="AspectFill" IsVisible="{Binding FriendToDelete.AvatarUrl, Converter={StaticResource InverseStringNullOrEmptyConverter}}" />
                                    <Image Source="{Binding FriendToDelete.AvatarUrl}" Aspect="AspectFill" />
                                </Grid>
                            </Border>
                            <!-- Dane -->
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                                <Label Text="{Binding FriendToDelete.FullName}" TextColor="White" FontAttributes="Bold" FontSize="18"/>
                                <Label Text="{Binding FriendToDelete.Nickname, StringFormat='@{0}'}" TextColor="{StaticResource TextSubtle}" FontSize="14"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- Przyciski akcji -->
                    <Grid ColumnDefinitions="Auto, Auto" HorizontalOptions="Center" ColumnSpacing="20" Margin="0,10,0,0">
                        <controls:AppButton Grid.Column="0" Text="Anuluj" Command="{Binding CancelDeleteFriendCommand}" ButtonBackgroundColor="{StaticResource SurfaceDark}" ButtonTextColor="{StaticResource TextMain}" WidthRequest="120" />
                        <controls:AppButton Grid.Column="1" Text="Potwierdź" Command="{Binding ConfirmDeleteFriendCommand}" ButtonBackgroundColor="{StaticResource StatusRed}" ButtonTextColor="{StaticResource TextMain}" WidthRequest="120" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- WARSTWA 4: popup powiadomienia (alert) -->
        <Grid IsVisible="{Binding IsAlertPopupVisible}" Style="{StaticResource PopupOverlayStyle}">
            <Border StrokeShape="RoundRectangle 10" Style="{StaticResource PopupContainerStyle}" WidthRequest="450" StrokeThickness="1.5">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding IsAlertError}" Value="True">
                        <Setter Property="Stroke" Value="#EF4444" />
                    </DataTrigger>
                    <DataTrigger TargetType="Border" Binding="{Binding IsAlertError}" Value="False">
                        <Setter Property="Stroke" Value="#10B981" />
                    </DataTrigger>
                </Border.Triggers>
                <VerticalStackLayout Spacing="25" HorizontalOptions="Center">
                    <!-- Ikona statusu -->
                    <Grid HeightRequest="70" WidthRequest="70" HorizontalOptions="Center">
                        <Border StrokeThickness="0" StrokeShape="RoundRectangle 35" WidthRequest="70" HeightRequest="70">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsAlertError}" Value="True">
                                    <Setter Property="BackgroundColor" Value="#2D1F24" />
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding IsAlertError}" Value="False">
                                    <Setter Property="BackgroundColor" Value="#1A2A22" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Grid>
                                <!-- Wykrzyknik dla błędu -->
                                <Image Source="x_icon.png" WidthRequest="30" HeightRequest="30" HorizontalOptions="Center" VerticalOptions="Center"
                                       IsVisible="{Binding IsAlertError}" />
                                <!-- Ptaszek dla sukcesu -->
                                <Image Source="check_mark_icon.png" WidthRequest="30" HeightRequest="30" HorizontalOptions="Center" VerticalOptions="Center"
                                       IsVisible="{Binding IsAlertError, Converter={StaticResource InverseBool}}" />
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Nagłówek i treść -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{Binding AlertTitle}" FontSize="22" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                        <Label Text="{Binding AlertMessage}" FontSize="14" TextColor="{StaticResource TextSubtle}" HorizontalOptions="Center" HorizontalTextAlignment="Center" MaxLines="5" LineBreakMode="WordWrap"/>
                    </VerticalStackLayout>

                    <!-- Przycisk Zamknięcia -->
                    <controls:AppButton Text="OK" Command="{Binding CloseAlertPopupCommand}" WidthRequest="120" HorizontalOptions="Center"
                                        ButtonBackgroundColor="{Binding IsAlertError, Converter={StaticResource IsAlertErrorToColorConverter}}" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- WARSTWA 6: popup szczegółów znajomego na mobilce -->
        <Grid IsVisible="{Binding IsFriendDetailsPopupVisible}" Style="{StaticResource PopupOverlayStyle}">
            <Border StrokeShape="RoundRectangle 10" Style="{StaticResource PopupContainerStyle}" WidthRequest="400">
                <VerticalStackLayout Spacing="15" Padding="0">
                    <Grid>
                        <Label Text="Szczegóły znajomego" FontSize="18" FontAttributes="Bold" TextColor="White" HorizontalOptions="Start" VerticalOptions="Center"/>
                        <Label Text="✕" FontSize="24" TextColor="{StaticResource TextSubtle}" HorizontalOptions="End" VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding CloseFriendDetailsPopupCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>

                    <Border BackgroundColor="#1E232D" Padding="15" StrokeShape="RoundRectangle 10" StrokeThickness="0">
                        <Grid ColumnDefinitions="50, *" ColumnSpacing="15">
                            <Border Grid.Column="0" HeightRequest="50" WidthRequest="50" StrokeShape="RoundRectangle 25" StrokeThickness="0" BackgroundColor="#2A303C" VerticalOptions="Center">
                                <Grid>
                                    <Image Source="default_user_avatar.png" Aspect="AspectFill" IsVisible="{Binding SelectedFriendForDetails.AvatarUrl, Converter={StaticResource InverseStringNullOrEmptyConverter}}" />
                                    <Image Source="{Binding SelectedFriendForDetails.AvatarUrl}" Aspect="AspectFill" />
                                </Grid>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label Text="{Binding SelectedFriendForDetails.FullName, TargetNullValue='Brak danych'}" TextColor="White" FontSize="18" FontAttributes="Bold" />
                                <Label Text="{Binding SelectedFriendForDetails.Nickname, StringFormat='@{0}', TargetNullValue='@brak'}" TextColor="{StaticResource TextSubtle}" FontSize="14" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <VerticalStackLayout Spacing="10">
                        <Label Text="Numer telefonu" TextColor="{StaticResource TextSubtle}" FontSize="12" />
                        <Label Text="{Binding SelectedFriendForDetails.PhoneNumber, TargetNullValue='Brak danych'}" TextColor="White" FontSize="16" />

                        <BoxView HeightRequest="1" Color="{StaticResource Border}" Margin="0,5" />

                        <Label Text="Różnica (Bilans)" TextColor="{StaticResource TextSubtle}" FontSize="12" />
                        <Label Text="{Binding SelectedFriendForDetails.BalanceAbsoluteFormatted}" TextColor="{Binding SelectedFriendForDetails.BalanceColor}" FontSize="18" FontAttributes="Bold" />

                        <BoxView HeightRequest="1" Color="{StaticResource Border}" Margin="0,5" />

                        <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                            <Label Grid.Column="0" Text="Wspólne grupy" TextColor="{StaticResource TextSubtle}" FontSize="12" VerticalOptions="Center" />
                            <HorizontalStackLayout Grid.Column="1" BindableLayout.ItemsSource="{Binding SelectedFriendForDetails.SharedGroupsDisplay}" Spacing="-12" IsVisible="{Binding SelectedFriendForDetails.HasSharedGroups}">
                                <HorizontalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ShowSharedGroupsPopupCommand}" CommandParameter="{Binding SelectedFriendForDetails}" />
                                </HorizontalStackLayout.GestureRecognizers>
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Border WidthRequest="36" HeightRequest="36" StrokeShape="RoundRectangle 18" Stroke="{StaticResource SurfaceDark}" StrokeThickness="2" BackgroundColor="#1E232D" ZIndex="{Binding ZIndex}">
                                            <Grid>
                                                <Grid IsVisible="{Binding IsMoreIndicator, Converter={StaticResource InverseBool}}">
                                                    <Image Source="default_group_avatar.png" Aspect="AspectFill" IsVisible="{Binding AvatarUrl, Converter={StaticResource InverseStringNullOrEmptyConverter}}" />
                                                    <Image Source="{Binding AvatarUrl}" Aspect="AspectFill" />
                                                </Grid>
                                                <Grid IsVisible="{Binding IsMoreIndicator}" BackgroundColor="#242F41">
                                                    <Label Text="{Binding MoreText}" TextColor="White" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </HorizontalStackLayout>
                            <Label Grid.Column="1" Text="Brak wspólnych grup" TextColor="{StaticResource TextSubtle}" FontSize="12" VerticalOptions="Center" IsVisible="{Binding SelectedFriendForDetails.HasSharedGroups, Converter={StaticResource InverseBool}}" />
                        </Grid>
                    </VerticalStackLayout>

                    <controls:AppButton Text="Zamknij" Command="{Binding CloseFriendDetailsPopupCommand}" ButtonBackgroundColor="{StaticResource SurfaceDark}" ButtonTextColor="{StaticResource TextMain}" Margin="0,10,0,0"/>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- WARSTWA 5: popup wspólnych grup -->
        <Grid IsVisible="{Binding IsSharedGroupsPopupVisible}" Style="{StaticResource PopupOverlayStyle}" ZIndex="200">
            <Border StrokeShape="RoundRectangle 10" Style="{StaticResource PopupContainerStyle}" WidthRequest="400">
                <VerticalStackLayout Spacing="20">
                    <Grid>
                        <Label Text="{Binding SelectedFriendFullName, StringFormat='Wspólne grupy z: {0}'}" FontSize="18" FontAttributes="Bold" TextColor="White" HorizontalOptions="Start" VerticalOptions="Center" MaxLines="1" LineBreakMode="TailTruncation" Margin="0,0,30,0"/>
                        <Image Source="x_icon.png" WidthRequest="24" HeightRequest="24" HorizontalOptions="End" VerticalOptions="Center">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding CloseSharedGroupsPopupCommand}" />
                            </Image.GestureRecognizers>
                        </Image>
                    </Grid>

                    <CollectionView ItemsSource="{Binding SelectedFriendSharedGroups}" HeightRequest="250" Margin="0,10,0,0">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <ContentView Padding="0,0,0,10">
                                    <Border StrokeShape="RoundRectangle 12" BackgroundColor="{StaticResource SurfaceDark}" StrokeThickness="1" Stroke="{StaticResource Border}" Padding="15">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding BindingContext.GoToGroupCommand, Source={x:Reference thisPage}}" CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Grid ColumnDefinitions="Auto, *">
                                            <Border Grid.Column="0" HeightRequest="40" WidthRequest="40" StrokeShape="RoundRectangle 20" StrokeThickness="0" Margin="0,0,15,0" BackgroundColor="#1E232D">
                                                <Grid>
                                                    <Image Source="default_group_avatar.png" Aspect="AspectFill" IsVisible="{Binding AvatarUrl, Converter={StaticResource InverseStringNullOrEmptyConverter}}" />
                                                    <Image Source="{Binding AvatarUrl}" Aspect="AspectFill" />
                                                </Grid>
                                            </Border>
                                            <Label Grid.Column="1" Text="{Binding Name}" TextColor="White" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" />
                                        </Grid>
                                    </Border>
                                </ContentView>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <controls:AppButton Text="Zamknij" Command="{Binding CloseSharedGroupsPopupCommand}" ButtonBackgroundColor="{StaticResource SurfaceDark}" ButtonTextColor="{StaticResource TextMain}" Margin="0,10,0,0"/>
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>
</ContentPage>



