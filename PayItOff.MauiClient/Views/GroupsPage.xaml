<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:PayItOff.MauiClient.Controls"
             xmlns:vm="clr-namespace:PayItOff.MauiClient.ViewModels"
             xmlns:models="using:PayItOff.Shared.Responses"
             x:Class="PayItOff.MauiClient.Views.GroupsPage"
             BackgroundColor="{StaticResource MainBackground}"
             Shell.NavBarIsVisible="False"
             x:Name="thisPage">

    <Grid>
        
        <Grid ColumnDefinitions="{OnIdiom Phone='0, *', Default='360, *'}">

            
            <controls:SidebarMenu Grid.Column="0"
                                  ActiveTab="Groups"
                                  IsVisible="{OnIdiom Phone=False, Default=True}" />

            
            <Grid Grid.Column="1" RowDefinitions="80, Auto, *" Padding="40,0,40,40">

                
                <Border Grid.Row="0" HorizontalOptions="End" VerticalOptions="Center"
                        StrokeShape="RoundRectangle 20" BackgroundColor="Transparent"
                        Stroke="#444" StrokeThickness="1" WidthRequest="320" HeightRequest="40" Padding="15,0">
                    <SearchBar Placeholder="Wpisz szukaną grupę..."
                               PlaceholderColor="#666" TextColor="White" FontSize="14"
                               VerticalOptions="Center" BackgroundColor="Transparent"
                               Text="{Binding SearchQuery}" CancelButtonColor="{StaticResource TextSubtle}"
                               Margin="-10,0,0,0"/>
                </Border>

                
                <BoxView Grid.Row="1" HeightRequest="1" Color="{StaticResource Border}" Opacity="0.5" Margin="-40,0"/>

                
                <ScrollView Grid.Row="2" VerticalScrollBarVisibility="Never" Padding="0,30,0,0">
                    <VerticalStackLayout Spacing="20">

                        <CollectionView ItemsSource="{Binding Groups}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:GroupInfoResponse">
                                    <Grid Padding="0,0,0,20">
                                        
                                        <Border StrokeShape="RoundRectangle 15"
                                                BackgroundColor="{StaticResource SurfaceDark}"
                                                Padding="20" StrokeThickness="0">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:GroupsViewModel}}, Path=NavigateToGroupDetailsCommand}"
                                                    CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>

                                            <Grid ColumnDefinitions="60, *, Auto" ColumnSpacing="20">
                                                
                                                <Border Grid.Column="0" HeightRequest="60" WidthRequest="60"
                                                        StrokeShape="RoundRectangle 30" StrokeThickness="0" BackgroundColor="#1E232D">
                                                    <Grid>
                                                        
                                                        <Path Aspect="Uniform" WidthRequest="26" HeightRequest="26" HorizontalOptions="Center" VerticalOptions="Center" Fill="#444"
                                                              Data="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/>

                                                        <Image Source="{Binding AvatarUrl}" Aspect="AspectFill" />
                                                    </Grid>
                                                </Border>

                                                
                                                <Label Grid.Column="1" Text="{Binding Name}" TextColor="White"
                                                       FontAttributes="Bold" FontSize="20" VerticalOptions="Center"/>

                                                
                                                <Grid Grid.Column="2" ColumnDefinitions="95, 95, 115" ColumnSpacing="10" VerticalOptions="Center" Margin="0,0,30,0">
                                                    <VerticalStackLayout Grid.Column="0">
                                                        <Label Text="Przychód" TextColor="{StaticResource TextSubtle}" FontSize="12" HorizontalOptions="Center"/>
                                                        <Label Text="{Binding Income, StringFormat='{0:N2} zł'}" TextColor="{StaticResource StatusGreen}" FontAttributes="Bold" FontSize="16" HorizontalOptions="Center"/>
                                                    </VerticalStackLayout>

                                                    <VerticalStackLayout Grid.Column="1">
                                                        <Label Text="Wydatek" TextColor="{StaticResource TextSubtle}" FontSize="12" HorizontalOptions="Center"/>
                                                        <Label Text="{Binding Expense, StringFormat='{0:N2} zł'}" TextColor="{StaticResource StatusRed}" FontAttributes="Bold" FontSize="16" HorizontalOptions="Center"/>
                                                    </VerticalStackLayout>

                                                    <VerticalStackLayout Grid.Column="2">
                                                        <Label Text="Suma" TextColor="{StaticResource TextSubtle}" FontSize="12" HorizontalOptions="End"/>
                                                        <Label Text="{Binding Balance, StringFormat='{0:N2} zł'}" TextColor="White" FontAttributes="Bold" FontSize="18" HorizontalOptions="End"/>
                                                    </VerticalStackLayout>
                                                </Grid>
                                            </Grid>
                                        </Border>

                                        
                                        <Border HorizontalOptions="End" VerticalOptions="Start"
                                                Margin="0,15,15,0" HeightRequest="30" WidthRequest="30"
                                                BackgroundColor="Transparent" StrokeThickness="0">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:GroupsViewModel}}, Path=ToggleFavoriteCommand}"
                                                                      CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            
                                            <Image WidthRequest="22" HeightRequest="22" HorizontalOptions="Center" VerticalOptions="Center" Source="star_icon_default.png">
                                                <Image.Triggers>
                                                    <DataTrigger TargetType="Image" Binding="{Binding IsFavorite}" Value="True">
                                                        <Setter Property="Source" Value="star_icon_fav.png" />
                                                    </DataTrigger>
                                                </Image.Triggers>
                                            </Image>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        
                        <Border StrokeShape="RoundRectangle 15" BackgroundColor="{StaticResource SurfaceDark}" Padding="0"
                                StrokeThickness="0" HeightRequest="70" Margin="0,10,0,0">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ShowCreatePopupCommand}"/>
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout HorizontalOptions="Center" Spacing="15" VerticalOptions="Center">
                                <Image Source="plus_icon.png" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" Margin="0,-4,0,0"/>
                                <Label Text="Utwórz nową grupę" TextColor="White" FontAttributes="Bold" FontSize="18" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                        </Border>

                    </VerticalStackLayout>
                </ScrollView>
            </Grid>
        </Grid>

        
        <Grid IsVisible="{Binding IsCreatePopupVisible}" Style="{StaticResource PopupOverlayStyle}">
            <Border Style="{StaticResource PopupContainerStyle}" WidthRequest="420">
                <VerticalStackLayout Spacing="30">
                    <Label Text="Nowa Grupa" FontSize="26" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center"/>

                    
                    <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                        <Border Stroke="#7F00FF" StrokeThickness="2" HeightRequest="120" WidthRequest="120" HorizontalOptions="Center">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding PickPhotoCommand}" />
                            </Border.GestureRecognizers>
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="60" />
                            </Border.StrokeShape>
                            <Grid>
                                <BoxView Color="#2B2B3D" CornerRadius="60" />
                                <Image Source="camera_icon.png" WidthRequest="40" HeightRequest="40" HorizontalOptions="Center" VerticalOptions="Center" />
                                <Image Source="{Binding SelectedAvatarSource}" Aspect="AspectFill" />
                            </Grid>
                        </Border>
                        <Label Text="Kliknij, aby wybrać zdjęcie" TextColor="#7F00FF" FontSize="12" HorizontalOptions="Center" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="10">
                        <Label Text="Nazwa grupy" TextColor="{StaticResource TextSubtle}" FontSize="13" Margin="5,0,0,0"/>
                        <Border StrokeShape="RoundRectangle 10" BackgroundColor="Transparent" Stroke="#444" StrokeThickness="1" Padding="15,0" HeightRequest="45">
                            <Entry Text="{Binding NewGroupName}" Placeholder="Np. Wakacje 2024" TextColor="White" PlaceholderColor="#666" BackgroundColor="Transparent" VerticalOptions="Center"/>
                        </Border>
                    </VerticalStackLayout>

                    
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="15" Margin="0,10,0,0">
                        <Button Grid.Column="0" Text="Anuluj" Command="{Binding ClosePopupCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                        <Button Grid.Column="1" Text="Utwórz" Command="{Binding ConfirmCreateGroupCommand}" Style="{StaticResource SuccessButtonStyle}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- Custom Alert Popup -->
        <Grid IsVisible="{Binding IsCustomAlertVisible}" Style="{StaticResource PopupOverlayStyle}" ZIndex="500">
            <Border Style="{StaticResource PopupContainerStyle}" MaximumWidthRequest="400">
                <VerticalStackLayout Spacing="15">
                    <Label Text="{Binding CustomAlertTitle}" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource TextMain}" HorizontalOptions="Center"/>
                    <Label Text="{Binding CustomAlertMessage}" FontSize="14" TextColor="{StaticResource TextSubtle}" LineBreakMode="WordWrap" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,15,0,0">
                        <Button Grid.Column="0" Text="{Binding CustomAlertCancelText}" Command="{Binding CloseAlertCommand}" CommandParameter="False" Style="{StaticResource SecondaryButtonStyle}" IsVisible="{Binding IsCustomAlertCancelVisible}"/>
                        <Button Grid.Column="{Binding AlertAcceptColumn}" Grid.ColumnSpan="{Binding AlertAcceptColumnSpan}" Text="{Binding CustomAlertAcceptText}" Command="{Binding CloseAlertCommand}" CommandParameter="True" Style="{StaticResource PrimaryButtonStyle}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>
</ContentPage>