<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:PayItOff.MauiClient.Controls"
             xmlns:vm="clr-namespace:PayItOff.MauiClient.ViewModels"
             xmlns:models="using:PayItOff.Shared.Responses"
             x:Class="PayItOff.MauiClient.Views.GroupsPage"
             BackgroundColor="{StaticResource MainBackground}"
             Shell.NavBarIsVisible="False"
             x:Name="thisPage">

    <Grid>

        <Grid ColumnDefinitions="{OnIdiom Phone='0, *', Default='360, *'}">


            <controls:SidebarMenu Grid.Column="0"
                                  ActiveTab="Groups"
                                  IsVisible="{OnIdiom Phone=False, Default=True}" />

            <Grid Grid.Column="1" RowDefinitions="Auto, 80, Auto, *" Padding="{OnIdiom Phone='15', Default='40,0,40,40'}">

                <!-- MENU NA TELEFON -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto, *" IsVisible="{OnIdiom Phone=True, Default=False}" Margin="{OnPlatform iOS='0,40,0,0', Android='0,25,0,0', Default='0,10,0,0'}">
                    <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                        <Image Source="payitoff_logo_img.png" WidthRequest="32" HeightRequest="32" VerticalOptions="Center" />
                        <Label Text="PayItOff" FontSize="20" FontAttributes="Bold" TextColor="White" VerticalOptions="Center"/>
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Grid.Column="1" HorizontalOptions="End" Spacing="10" VerticalOptions="Center" BackgroundColor="Transparent">
                        <HorizontalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleMenuCommand}" />
                        </HorizontalStackLayout.GestureRecognizers>
                        <Label Text="MENU" TextColor="White" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                        <Image Source="phone_menu_icon.png" WidthRequest="28" HeightRequest="28" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Grid>


                <Border Grid.Row="1" HorizontalOptions="End" VerticalOptions="Center"
                        StrokeShape="RoundRectangle 20" BackgroundColor="Transparent"
                        Stroke="#444" StrokeThickness="1" WidthRequest="{OnIdiom Phone='350', Default='320'}" HeightRequest="40" Padding="15,0">
                    <SearchBar Placeholder="Wpisz szukaną grupę..."
                               PlaceholderColor="#666" TextColor="White" FontSize="14"
                               VerticalOptions="Center" BackgroundColor="Transparent"
                               Text="{Binding SearchQuery}" CancelButtonColor="{StaticResource TextSubtle}"
                               Margin="-10,0,0,0"/>
                </Border>

                <BoxView Grid.Row="2" HeightRequest="1" Color="{StaticResource Border}" Opacity="0.5" Margin="{OnIdiom Phone='-15,0', Default='-40,0'}"/>


                <ScrollView Grid.Row="3" VerticalScrollBarVisibility="Never" Padding="0,30,0,0">
                    <VerticalStackLayout Spacing="20">

                        <CollectionView ItemsSource="{Binding Groups}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:GroupInfoResponse">
                                    <Grid Padding="0,0,0,20">

                                        <Border StrokeShape="RoundRectangle 15"
                                                BackgroundColor="{StaticResource SurfaceDark}"
                                                Padding="20" StrokeThickness="0">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:GroupsViewModel}}, Path=NavigateToGroupDetailsCommand}"
                                                    CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>

                                            <Grid ColumnDefinitions="{OnIdiom Phone='50, *, Auto', Default='60, *, Auto'}" ColumnSpacing="{OnIdiom Phone=10, Default=20}">

                                                <Border Grid.Column="0" HeightRequest="{OnIdiom Phone=50, Default=60}" WidthRequest="{OnIdiom Phone=50, Default=60}"
                                                        StrokeShape="{OnIdiom Phone='RoundRectangle 25', Default='RoundRectangle 30'}" StrokeThickness="0" BackgroundColor="#1E232D">
                                                    <Grid>

                                                        <Image Source="default_group_avatar.png" Aspect="AspectFill" IsVisible="{Binding AvatarUrl, Converter={StaticResource InverseStringNullOrEmptyConverter}}" />

                                                        <Image Source="{Binding AvatarUrl}" Aspect="AspectFill" />
                                                    </Grid>
                                                </Border>


                                                <Label Grid.Column="1" Text="{Binding Name}" TextColor="White" LineBreakMode="TailTruncation"
                                                       FontAttributes="Bold" FontSize="{OnIdiom Phone=16, Default=20}" VerticalOptions="Center"/>


                                                <HorizontalStackLayout Grid.Column="2" Spacing="10" VerticalOptions="Center" Margin="{OnIdiom Phone='0,0,25,0', Default='0,0,30,0'}">
                                                    <VerticalStackLayout IsVisible="{OnIdiom Phone=False, Default=True}" WidthRequest="95">
                                                        <Label Text="Przychód" TextColor="{StaticResource TextSubtle}" FontSize="12" HorizontalOptions="Center"/>
                                                        <Label Text="{Binding Income, StringFormat='{0:N2} zł'}" TextColor="{StaticResource StatusGreen}" FontAttributes="Bold" FontSize="16" HorizontalOptions="Center" LineBreakMode="TailTruncation"/>
                                                    </VerticalStackLayout>

                                                    <VerticalStackLayout IsVisible="{OnIdiom Phone=False, Default=True}" WidthRequest="95">
                                                        <Label Text="Wydatek" TextColor="{StaticResource TextSubtle}" FontSize="12" HorizontalOptions="Center"/>
                                                        <Label Text="{Binding Expense, StringFormat='{0:N2} zł'}" TextColor="{StaticResource StatusRed}" FontAttributes="Bold" FontSize="16" HorizontalOptions="Center" LineBreakMode="TailTruncation"/>
                                                    </VerticalStackLayout>

                                                    <VerticalStackLayout WidthRequest="{OnIdiom Phone=85, Default=115}">
                                                        <Label Text="Suma" TextColor="{StaticResource TextSubtle}" FontSize="{OnIdiom Phone=11, Default=12}" HorizontalOptions="End"/>
                                                        <Label Text="{Binding Balance, StringFormat='{0:N2} zł'}" TextColor="White" FontAttributes="Bold" FontSize="{OnIdiom Phone=16, Default=18}" HorizontalOptions="End" LineBreakMode="TailTruncation"/>
                                                    </VerticalStackLayout>
                                                </HorizontalStackLayout>
                                            </Grid>
                                        </Border>


                                        <Border StrokeShape="RoundRectangle 10" HorizontalOptions="End" VerticalOptions="Start"
                                                Margin="0,15,15,0" HeightRequest="30" WidthRequest="30"
                                                BackgroundColor="Transparent" StrokeThickness="0">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:GroupsViewModel}}, Path=ToggleFavoriteCommand}"
                                                                      CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>

                                            <Image WidthRequest="22" HeightRequest="22" HorizontalOptions="Center" VerticalOptions="Center" Source="star_icon_default.png">
                                                <Image.Triggers>
                                                    <DataTrigger TargetType="Image" Binding="{Binding IsFavorite}" Value="True">
                                                        <Setter Property="Source" Value="star_icon_fav.png" />
                                                    </DataTrigger>
                                                </Image.Triggers>
                                            </Image>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>


                        <Border IsVisible="{OnIdiom Phone=False, Default=True}"
                                StrokeShape="RoundRectangle 15" BackgroundColor="{StaticResource SurfaceDark}" Padding="0"
                                StrokeThickness="0" HeightRequest="70" Margin="0,10,0,0">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ShowCreatePopupCommand}"/>
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout HorizontalOptions="Center" Spacing="15" VerticalOptions="Center">
                                <Image Source="plus_icon.png" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" Margin="0,-4,0,0"/>
                                <Label Text="Utwórz nową grupę" TextColor="White" FontAttributes="Bold" FontSize="18" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                        </Border>

                    </VerticalStackLayout>
                </ScrollView>


                <Border Grid.Row="1"
                        IsVisible="{Binding IsInviteListButtonVisible}"
                        HorizontalOptions="Start"
                        VerticalOptions="Center"
                        Margin="0"
                        WidthRequest="160"
                        HeightRequest="60"
                        StrokeShape="RoundRectangle 30"
                        BackgroundColor= "Transparent"
                        Stroke="{StaticResource StatusGreen}"
                        StrokeThickness="1"
                        ZIndex="10">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,4" Radius="10" Opacity="0.5"/>
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ShowInvitationPopupCommand}"/>
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10" HorizontalOptions="Center" VerticalOptions="Center">
                        <Image Grid.Column="0" Source="add_friend_to_group_icon.png" WidthRequest="{OnIdiom Phone=22, Default=28}" HeightRequest="{OnIdiom Phone=22, Default=28}" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="Nowe zaproszenia!" TextColor="{StaticResource StatusGreen}" FontSize="13" FontAttributes="Bold" VerticalOptions="Center"/>
                    </Grid>
                </Border>

                <Border Grid.Row="3"
                        IsVisible="{OnIdiom Phone=True, Default=False}"
                        HorizontalOptions="End"
                        VerticalOptions="End"
                        Margin="0,0,5,20"
                        WidthRequest="60"
                        HeightRequest="60"
                        StrokeShape="RoundRectangle 30"
                        BackgroundColor="#7F00FF"
                        StrokeThickness="0"
                        ZIndex="10">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,4" Radius="10" Opacity="0.5"/>
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ShowCreatePopupCommand}"/>
                    </Border.GestureRecognizers>
                    <Image Source="plus_icon.png" WidthRequest="24" HeightRequest="24" HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>
            </Grid>
        </Grid>


        <Grid IsVisible="{Binding IsCreatePopupVisible}" Style="{StaticResource PopupOverlayStyle}">
            <Border StrokeShape="RoundRectangle 10" Style="{StaticResource PopupContainerStyle}" WidthRequest="{OnIdiom Phone=340, Default=420}">
                <VerticalStackLayout Spacing="30">
                    <Label Text="Nowa Grupa" FontSize="26" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center"/>


                    <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                        <Border StrokeShape="RoundRectangle 10" Stroke="#7F00FF" StrokeThickness="2" HeightRequest="120" WidthRequest="120" HorizontalOptions="Center">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding PickPhotoCommand}" />
                            </Border.GestureRecognizers>
                            <Border.StrokeShape>
                                <RoundRectangle />
                            </Border.StrokeShape>
                            <Grid>
                                <BoxView Color="#2B2B3D" />
                                <Image Source="camera_icon.png" WidthRequest="40" HeightRequest="40" HorizontalOptions="Center" VerticalOptions="Center" />
                                <Image Source="{Binding SelectedAvatarSource}" Aspect="AspectFill" />
                            </Grid>
                        </Border>
                        <Label Text="Kliknij, aby wybrać zdjęcie" TextColor="#7F00FF" FontSize="12" HorizontalOptions="Center" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="10">
                        <Label Text="Nazwa grupy" TextColor="{StaticResource TextSubtle}" FontSize="13" Margin="5,0,0,0"/>
                        <Border StrokeShape="RoundRectangle 10" BackgroundColor="Transparent" Stroke="#444" StrokeThickness="1" Padding="15,0" HeightRequest="45">
                            <Entry Text="{Binding NewGroupName}" Placeholder="Np. Wakacje 2024" TextColor="White" PlaceholderColor="#666" BackgroundColor="Transparent" VerticalOptions="Center"/>
                        </Border>
                    </VerticalStackLayout>


                    <Grid ColumnDefinitions="*, *" ColumnSpacing="15" Margin="0,10,0,0">
                        <controls:AppButton Grid.Column="0" Text="Anuluj" Command="{Binding ClosePopupCommand}" ButtonBackgroundColor="{StaticResource SurfaceDark}" ButtonTextColor="{StaticResource TextMain}" />
                        <controls:AppButton Grid.Column="1" Text="Utwórz" Command="{Binding ConfirmCreateGroupCommand}" ButtonBackgroundColor="{StaticResource StatusGreen}" ButtonTextColor="{StaticResource TextMain}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <Grid IsVisible="{Binding IsInviteListPopupVisible}" Style="{StaticResource PopupOverlayStyle}">
            <Border StrokeShape="RoundRectangle 10" Style="{StaticResource PopupContainerStyle}" WidthRequest="{OnIdiom Phone=340, Default=420}">
                <VerticalStackLayout Spacing="30">
                    <Label Text="Twoje Zaproszenia" FontSize="26" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center"/>

                    <CollectionView ItemsSource="{Binding Invites}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:GroupPendingInvitationResponse">
                                <Grid Padding="0,0,0,20">
                                    <Grid ColumnDefinitions="Auto, *, Auto, Auto" ColumnSpacing="15" Padding="0,5">
                                        <Border Grid.Column="0" HeightRequest="40" WidthRequest="40" StrokeShape="RoundRectangle 20" StrokeThickness="0" BackgroundColor="#1E232D">
                                            <Grid>
                                                <Image Source="default_group_avatar.png" Aspect="AspectFill" IsVisible="{Binding GroupAvatarUrl, Converter={StaticResource InverseStringNullOrEmptyConverter}}" />
                                                <Image Source="{Binding GroupAvatarUrl}" Aspect="AspectFill" />
                                            </Grid>
                                        </Border>

                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                            <Label Text="{Binding GroupName}" TextColor="White" FontAttributes="Bold" FontSize="16" LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding Role, StringFormat='Rola: {0}'}" TextColor="{StaticResource TextSubtle}" FontSize="12" />
                                        </VerticalStackLayout>

                                        <Border Grid.Column="2" StrokeShape="RoundRectangle 5" StrokeThickness="1" Stroke="{StaticResource StatusGreen}" BackgroundColor="Transparent" WidthRequest="36" HeightRequest="36" Padding="8">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:GroupsViewModel}}, Path=AcceptInviteCommand}" CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Image Source="check_mark_icon.png" HorizontalOptions="Center" VerticalOptions="Center"/>
                                        </Border>

                                        <Border Grid.Column="3" StrokeShape="RoundRectangle 5" StrokeThickness="1" Stroke="{StaticResource StatusRed}" BackgroundColor="Transparent" WidthRequest="36" HeightRequest="36" Padding="8">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:GroupsViewModel}}, Path=DeclineInviteCommand}" CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Image Source="x_icon.png" HorizontalOptions="Center" VerticalOptions="Center"/>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>


                    <Grid ColumnDefinitions="*" ColumnSpacing="15" Margin="0,10,0,0">
                        <controls:AppButton Grid.Column="0" Text="Zamknij" Command="{Binding CloseInvitationPopupCommand}" ButtonBackgroundColor="{StaticResource SurfaceDark}" ButtonTextColor="{StaticResource TextMain}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- Mobile Menu Overlay -->
        <Grid IsVisible="{Binding IsMenuVisible}" BackgroundColor="#CC121212" ZIndex="100">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding ToggleMenuCommand}" />
            </Grid.GestureRecognizers>
            <controls:SidebarMenu HorizontalOptions="Start" ActiveTab="Groups" WidthRequest="300"/>
        </Grid>

        <!-- Custom Alert Popup -->
        <Grid IsVisible="{Binding IsCustomAlertVisible}" Style="{StaticResource PopupOverlayStyle}" ZIndex="500">
            <Border StrokeShape="RoundRectangle 10" Style="{StaticResource PopupContainerStyle}" MaximumWidthRequest="400">
                <VerticalStackLayout Spacing="15">
                    <Label Text="{Binding CustomAlertTitle}" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource TextMain}" HorizontalOptions="Center"/>
                    <Label Text="{Binding CustomAlertMessage}" FontSize="14" TextColor="{StaticResource TextSubtle}" LineBreakMode="WordWrap" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,15,0,0">
                        <controls:AppButton Grid.Column="0" Text="{Binding CustomAlertCancelText}" Command="{Binding CloseAlertCommand}" CommandParameter="False" ButtonBackgroundColor="{StaticResource SurfaceDark}" ButtonTextColor="{StaticResource TextMain}" IsVisible="{Binding IsCustomAlertCancelVisible}"/>
                        <controls:AppButton Grid.Column="{Binding AlertAcceptColumn}" Grid.ColumnSpan="{Binding AlertAcceptColumnSpan}" Text="{Binding CustomAlertAcceptText}" Command="{Binding CloseAlertCommand}" CommandParameter="True" ButtonBackgroundColor="{StaticResource PrimaryViolet}" ButtonTextColor="{StaticResource TextMain}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>
</ContentPage>


