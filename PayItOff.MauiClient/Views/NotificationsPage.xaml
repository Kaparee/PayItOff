<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:PayItOff.MauiClient.Controls"
             x:Class="PayItOff.MauiClient.Views.NotificationsPage"
             BackgroundColor="{StaticResource MainBackground}"
             Shell.NavBarIsVisible="False">

    <Grid>

        <Grid ColumnDefinitions="{OnIdiom Phone='0, *', Default='360, *'}">


            <controls:SidebarMenu Grid.Column="0"
                                  ActiveTab="Notifications"
                                  IsVisible="{OnIdiom Phone=False, Default=True}" />


            <ScrollView Grid.Column="1" VerticalScrollBarVisibility="Always">
                <Grid Padding="{OnIdiom Phone='15', Default='40'}" RowDefinitions="Auto, Auto, *" RowSpacing="30">


                    <HorizontalStackLayout Grid.Row="0" HorizontalOptions="End" IsVisible="{OnIdiom Phone=True, Default=False}" Margin="0,10,0,0">
                        <HorizontalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleMenuCommand}" />
                        </HorizontalStackLayout.GestureRecognizers>
                        <Image Source="phone_menu_icon.png" WidthRequest="28" HeightRequest="28" VerticalOptions="Center"/>
                        <Label Text="Menu" TextColor="{StaticResource TextMain}" FontAttributes="Bold" VerticalOptions="Center" Margin="5,0,0,0" FontSize="18"/>
                    </HorizontalStackLayout>


                    <BoxView Grid.Row="1" HeightRequest="1" Color="{StaticResource Border}" VerticalOptions="Start" Margin="-40,10,-40,0" IsVisible="{OnIdiom Phone=False, Default=True}" Opacity="0.5"/>




                    <VerticalStackLayout Grid.Row="2" Spacing="20">
                        <Grid ColumnDefinitions="Auto, Auto, Auto, *, Auto, Auto" ColumnSpacing="10" Margin="0,0,0,10">
                            <Border Grid.Column="0" StrokeShape="RoundRectangle 20" BackgroundColor="{Binding FilterAllColor}" Padding="20,10" StrokeThickness="0">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ToggleFilterCommand}" CommandParameter="All" />
                                </Border.GestureRecognizers>
                                <Label Text="{Binding TotalCount, StringFormat='Wszystkie {0}'}" TextColor="{StaticResource TextMain}" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" FontSize="14" />
                            </Border>
                            <Border Grid.Column="1" StrokeShape="RoundRectangle 20" BackgroundColor="{Binding FilterUnreadColor}" Padding="20,10" StrokeThickness="0">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ToggleFilterCommand}" CommandParameter="Unread" />
                                </Border.GestureRecognizers>
                                <Label Text="{Binding UnreadCount, StringFormat='Nieprzeczytane {0}'}" TextColor="{StaticResource TextSubtle}" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" FontSize="14" />
                            </Border>
                            <Border Grid.Column="2" StrokeShape="RoundRectangle 20" BackgroundColor="{Binding FilterActionColor}" Padding="20,10" StrokeThickness="0">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ToggleFilterCommand}" CommandParameter="ActionRequired" />
                                </Border.GestureRecognizers>
                                <Label Text="{Binding ActionRequiredCount, StringFormat='Wymaga akcji {0}'}" TextColor="{StaticResource TextSubtle}" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" FontSize="14" />
                            </Border>

                            <Border Grid.Column="4" StrokeShape="RoundRectangle 20" StrokeThickness="1" Stroke="#303846" BackgroundColor="Transparent" Padding="15,8" HorizontalOptions="End">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding MarkAllAsReadCommand}" />
                                </Border.GestureRecognizers>
                                <Label Text="Oznacz wszystkie jako przeczytane" TextColor="{StaticResource TextSubtle}" HorizontalOptions="Center" VerticalOptions="Center" FontSize="14" />
                            </Border>
                            <Border Grid.Column="5" StrokeShape="RoundRectangle 20" StrokeThickness="1" Stroke="{StaticResource StatusRed}" BackgroundColor="Transparent" Padding="15,8" HorizontalOptions="End">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding DeleteAllNotificationsCommand}" />
                                </Border.GestureRecognizers>
                                <Label Text="Usuń wszystkie powiadomienia" TextColor="{StaticResource StatusRed}" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" FontSize="14" />
                            </Border>
                        </Grid>

                            <CollectionView ItemsSource="{Binding Notifications}">
                                <CollectionView.EmptyView>
                                    <Label Text="Brak powiadomień" TextColor="{StaticResource TextSubtle}" HorizontalOptions="Center" Padding="30"/>
                                </CollectionView.EmptyView>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <ContentView Padding="0,0,0,10">
                                            <ContentView.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.MarkAsReadCommand}"
                                                    CommandParameter="{Binding .}" />
                                            </ContentView.GestureRecognizers>

                                            <Border BackgroundColor="{Binding BackgroundColor}" Padding="0" StrokeShape="RoundRectangle 12" StrokeThickness="0">
                                                <Grid ColumnDefinitions="Auto, 60, *, Auto, Auto" ColumnSpacing="15">

                                                    <BoxView Grid.Column="0" WidthRequest="6" Color="{Binding LeftBarColor}" VerticalOptions="FillAndExpand" />

                                                    <Image Grid.Column="1" Source="{Binding IconSource}" WidthRequest="26" HeightRequest="26" VerticalOptions="Center" HorizontalOptions="Center" />

                                                    <Label Grid.Column="2" Text="{Binding Body}" TextColor="{Binding TextColor}" FontAttributes="Bold" FontSize="14" VerticalOptions="Center" LineBreakMode="WordWrap" Margin="0,15" />

                                                    <Label Grid.Column="3" Text="{Binding TimeDisplay}" TextColor="{StaticResource TextSubtle}" FontSize="12" VerticalOptions="Center" Margin="0,0,15,0" />

                                                    <HorizontalStackLayout Grid.Column="4" Spacing="10" VerticalOptions="Center" Margin="0,0,15,0">

                                                        <Border IsVisible="{Binding IsActionRequired}" StrokeShape="RoundRectangle 5" StrokeThickness="1" Stroke="{StaticResource StatusGreen}" BackgroundColor="Transparent" WidthRequest="32" HeightRequest="32" Padding="6">
                                                            <Border.GestureRecognizers>
                                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.AcceptActionCommand}" CommandParameter="{Binding .}" />
                                                            </Border.GestureRecognizers>
                                                            <Image Source="check_mark_icon.png" Aspect="AspectFit" />
                                                        </Border>
                                                        <Border IsVisible="{Binding IsActionRequired}" StrokeShape="RoundRectangle 5" StrokeThickness="1" Stroke="{StaticResource StatusRed}" BackgroundColor="Transparent" WidthRequest="32" HeightRequest="32" Padding="6">
                                                            <Border.GestureRecognizers>
                                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeclineActionCommand}" CommandParameter="{Binding .}" />
                                                            </Border.GestureRecognizers>
                                                            <Image Source="x_icon.png" Aspect="AspectFit" />
                                                        </Border>

                                                        <Border StrokeShape="RoundRectangle 5" StrokeThickness="1" Stroke="#404040" BackgroundColor="Transparent" WidthRequest="32" HeightRequest="32" Padding="6">
                                                            <Border.GestureRecognizers>
                                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteNotificationCommand}" CommandParameter="{Binding .}" />
                                                            </Border.GestureRecognizers>
                                                            <Image Source="delete_icon.png" Aspect="AspectFit" Opacity="0.7"/>
                                                        </Border>

                                                    </HorizontalStackLayout>
                                                </Grid>
                                            </Border>
                                        </ContentView>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                    </VerticalStackLayout>


                </Grid>
            </ScrollView>
        </Grid>


        <Grid IsVisible="{Binding IsMenuVisible}" BackgroundColor="#CC121212" ZIndex="100">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding ToggleMenuCommand}" />
            </Grid.GestureRecognizers>
            <Border HorizontalOptions="End" VerticalOptions="Start" Margin="0,60,20,0" WidthRequest="220" BackgroundColor="{StaticResource SurfaceDark}" StrokeShape="RoundRectangle 15" StrokeThickness="0" Padding="15">
                <VerticalStackLayout Spacing="15">
                    <Label Text="PayItOff!" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource TextMain}" Margin="0,0,0,10"/>

                    <HorizontalStackLayout Spacing="15" Padding="15,12">
                        <HorizontalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="//MainPage" />
                        </HorizontalStackLayout.GestureRecognizers>
                        <Image Source="home_icon.png" WidthRequest="24" HeightRequest="24" Opacity="0.7"/>
                        <Label Text="Menu Główne" TextColor="{StaticResource TextSubtle}" VerticalOptions="Center" FontSize="16"/>
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="15" Padding="15,12">
                        <HorizontalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="//GroupsPage" />
                        </HorizontalStackLayout.GestureRecognizers>
                        <Image Source="groups_icon.png" WidthRequest="24" HeightRequest="24" Opacity="0.7"/>
                        <Label Text="Twoje Grupy" TextColor="{StaticResource TextSubtle}" VerticalOptions="Center" FontSize="16"/>
                    </HorizontalStackLayout>

                    <BoxView HeightRequest="1" Color="{StaticResource Border}" Margin="0,10" Opacity="0.5"/>
                    <HorizontalStackLayout Spacing="15" Padding="15,12">
                        <HorizontalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding LogoutCommand}" />
                        </HorizontalStackLayout.GestureRecognizers>
                        <Image Source="logout_icon.png" WidthRequest="24" HeightRequest="24" VerticalOptions="Center"/>
                        <Label Text="Wyloguj się" TextColor="{StaticResource StatusRed}" FontAttributes="Bold" VerticalOptions="Center" FontSize="16"/>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <Grid IsVisible="{Binding IsBusy}" BackgroundColor="#CC121212" ZIndex="450">
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="20">
                <ActivityIndicator IsRunning="{Binding IsBusy}" Color="#7F00FF" WidthRequest="60" HeightRequest="60" />
                <Label Text="Ładowanie powiadomień..." TextColor="White" FontAttributes="Bold" FontSize="16" HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>

        <Grid IsVisible="{Binding IsCustomAlertVisible}" Style="{StaticResource PopupOverlayStyle}" ZIndex="500">
            <Border Style="{StaticResource PopupContainerStyle}" MaximumWidthRequest="400">
                <VerticalStackLayout Spacing="15">
                    <Label Text="{Binding CustomAlertTitle}" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource TextMain}" HorizontalOptions="Center"/>
                    <Label Text="{Binding CustomAlertMessage}" FontSize="14" TextColor="{StaticResource TextSubtle}" LineBreakMode="WordWrap" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,15,0,0">
                        <Button Grid.Column="0" Text="{Binding CustomAlertCancelText}" Command="{Binding CloseAlertCommand}" CommandParameter="False" Style="{StaticResource SecondaryButtonStyle}" IsVisible="{Binding IsCustomAlertCancelVisible}"/>
                        <Button Grid.Column="{Binding AlertAcceptColumn}" Grid.ColumnSpan="{Binding AlertAcceptColumnSpan}" Text="{Binding CustomAlertAcceptText}" Command="{Binding CloseAlertCommand}" CommandParameter="True" Style="{StaticResource PrimaryButtonStyle}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>
</ContentPage>
