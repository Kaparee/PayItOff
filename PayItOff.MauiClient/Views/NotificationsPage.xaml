<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:PayItOff.MauiClient.Controls"
             x:Class="PayItOff.MauiClient.Views.NotificationsPage"
             BackgroundColor="{StaticResource MainBackground}"
             Shell.NavBarIsVisible="False">

    <Grid>

        <Grid ColumnDefinitions="{OnIdiom Phone='0, *', Default='360, *'}">


            <controls:SidebarMenu Grid.Column="0"
                                  ActiveTab="Notifications"
                                  IsVisible="{OnIdiom Phone=False, Default=True}" />


            <ScrollView Grid.Column="1" VerticalScrollBarVisibility="Always">
                <Grid Padding="{OnIdiom Phone='15', Default='40'}" RowDefinitions="Auto, Auto, *" RowSpacing="30">


                    <Grid Grid.Row="0" ColumnDefinitions="Auto, *" IsVisible="{OnIdiom Phone=True, Default=False}" Margin="{OnPlatform iOS='0,40,0,0', Android='0,25,0,0', Default='0,10,0,0'}">
                        <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                            <Image Source="payitoff_logo_img.png" WidthRequest="32" HeightRequest="32" VerticalOptions="Center" />
                            <Label Text="PayItOff" FontSize="20" FontAttributes="Bold" TextColor="White" VerticalOptions="Center"/>
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Grid.Column="1" HorizontalOptions="End" Spacing="10" VerticalOptions="Center" BackgroundColor="Transparent">
                            <HorizontalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleMenuCommand}" />
                            </HorizontalStackLayout.GestureRecognizers>
                            <Label Text="MENU" TextColor="White" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                            <Image Source="phone_menu_icon.png" WidthRequest="28" HeightRequest="28" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Grid>


                    <BoxView Grid.Row="1" HeightRequest="1" Color="{StaticResource Border}" VerticalOptions="Start" Margin="-40,10,-40,0" IsVisible="{OnIdiom Phone=False, Default=True}" Opacity="0.5"/>




                    <VerticalStackLayout Grid.Row="2" Spacing="20">
                        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Margin="0,0,0,10">
                            <HorizontalStackLayout Spacing="10">
                                <Border StrokeShape="RoundRectangle 20" BackgroundColor="{Binding FilterAllColor}" Padding="{OnIdiom Phone='12,8', Default='20,10'}" StrokeThickness="0">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ToggleFilterCommand}" CommandParameter="All" />
                                    </Border.GestureRecognizers>
                                    <Label Text="{Binding TotalCount, StringFormat='Wszystkie {0}'}" TextColor="{StaticResource TextMain}" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" FontSize="{OnIdiom Phone=12, Default=14}" />
                                </Border>
                                <Border StrokeShape="RoundRectangle 20" BackgroundColor="{Binding FilterUnreadColor}" Padding="{OnIdiom Phone='12,8', Default='20,10'}" StrokeThickness="0">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ToggleFilterCommand}" CommandParameter="Unread" />
                                    </Border.GestureRecognizers>
                                    <Label Text="{Binding UnreadCount, StringFormat='Nieprzeczytane {0}'}" TextColor="{StaticResource TextSubtle}" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" FontSize="{OnIdiom Phone=12, Default=14}" />
                                </Border>
                                <Border StrokeShape="RoundRectangle 20" BackgroundColor="{Binding FilterActionColor}" Padding="{OnIdiom Phone='12,8', Default='20,10'}" StrokeThickness="0">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ToggleFilterCommand}" CommandParameter="ActionRequired" />
                                    </Border.GestureRecognizers>
                                    <Label Text="{Binding ActionRequiredCount, StringFormat='Wymaga akcji {0}'}" TextColor="{StaticResource TextSubtle}" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" FontSize="{OnIdiom Phone=12, Default=14}" />
                                </Border>
                                <Border StrokeShape="RoundRectangle 20" StrokeThickness="1" Stroke="#303846" BackgroundColor="Transparent" Padding="{OnIdiom Phone='12,8', Default='15,8'}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding MarkAllAsReadCommand}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="Oznacz wszystkie jako przeczytane" TextColor="{StaticResource TextSubtle}" HorizontalOptions="Center" VerticalOptions="Center" FontSize="{OnIdiom Phone=12, Default=14}" />
                                </Border>
                                <Border StrokeShape="RoundRectangle 20" StrokeThickness="1" Stroke="{StaticResource StatusRed}" BackgroundColor="Transparent" Padding="{OnIdiom Phone='12,8', Default='15,8'}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding DeleteAllNotificationsCommand}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="Usuń wszystkie powiadomienia" TextColor="{StaticResource StatusRed}" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" FontSize="{OnIdiom Phone=12, Default=14}" />
                                </Border>
                            </HorizontalStackLayout>
                        </ScrollView>

                            <CollectionView ItemsSource="{Binding Notifications}">
                                <CollectionView.EmptyView>
                                    <Label Text="Brak powiadomień" TextColor="{StaticResource TextSubtle}" HorizontalOptions="Center" Padding="30"/>
                                </CollectionView.EmptyView>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <ContentView Padding="0,0,0,10">
                                            <ContentView.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.HandleNotificationTappedCommand}"
                                                    CommandParameter="{Binding .}" />
                                            </ContentView.GestureRecognizers>

                                            <Border BackgroundColor="{Binding BackgroundColor}" Padding="0" StrokeShape="RoundRectangle 12" StrokeThickness="0">
                                                <Grid ColumnDefinitions="{OnIdiom Phone='Auto, 40, *', Default='Auto, 60, *, Auto, Auto'}" RowDefinitions="{OnIdiom Phone='Auto, Auto, Auto', Default='*'}" ColumnSpacing="{OnIdiom Phone=10, Default=15}">

                                                    <BoxView Grid.RowSpan="{OnIdiom Phone=3, Default=1}" Grid.Column="0" WidthRequest="6" Color="{Binding LeftBarColor}" VerticalOptions="Fill" />

                                                    <Image Grid.Row="{OnIdiom Phone=0, Default=0}" Grid.RowSpan="{OnIdiom Phone=2, Default=1}" Grid.Column="1" Source="{Binding IconSource}" WidthRequest="{OnIdiom Phone=20, Default=26}" HeightRequest="{OnIdiom Phone=20, Default=26}" VerticalOptions="{OnIdiom Phone=Start, Default=Center}" HorizontalOptions="Center" Margin="{OnIdiom Phone='0,15,0,0', Default='0'}" />

                                                    <Label Grid.Row="0" Grid.Column="2" Text="{Binding DisplayText}" TextColor="{Binding TextColor}" FontAttributes="Bold" FontSize="{OnIdiom Phone=13, Default=14}" VerticalOptions="Center" LineBreakMode="WordWrap" Margin="{OnIdiom Phone='0,15,10,0', Default='0,15'}" />

                                                    <Label Grid.Row="{OnIdiom Phone=1, Default=0}" Grid.Column="{OnIdiom Phone=2, Default=3}" Text="{Binding TimeDisplay}" TextColor="{StaticResource TextSubtle}" FontSize="12" VerticalOptions="{OnIdiom Phone=Start, Default=Center}" Margin="{OnIdiom Phone='0,5,10,5', Default='0,0,15,0'}" />

                                                    <HorizontalStackLayout Grid.Row="{OnIdiom Phone=2, Default=0}" Grid.Column="{OnIdiom Phone=2, Default=4}" Spacing="10" VerticalOptions="{OnIdiom Phone=Start, Default=Center}" Margin="{OnIdiom Phone='0,5,10,15', Default='0,0,15,0'}">

                                                        <Border IsVisible="{Binding IsActionRequired}" StrokeShape="RoundRectangle 5" StrokeThickness="1" Stroke="{StaticResource StatusGreen}" BackgroundColor="Transparent" WidthRequest="32" HeightRequest="32" Padding="6">
                                                            <Border.GestureRecognizers>
                                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.AcceptActionCommand}" CommandParameter="{Binding .}" />
                                                            </Border.GestureRecognizers>
                                                            <Image Source="check_mark_icon.png" WidthRequest="16" HeightRequest="16" HorizontalOptions="Center" VerticalOptions="Center"/>
                                                        </Border>
                                                        <Border IsVisible="{Binding IsActionRequired}" StrokeShape="RoundRectangle 5" StrokeThickness="1" Stroke="{StaticResource StatusRed}" BackgroundColor="Transparent" WidthRequest="32" HeightRequest="32" Padding="6">
                                                            <Border.GestureRecognizers>
                                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RejectActionCommand}" CommandParameter="{Binding .}" />
                                                            </Border.GestureRecognizers>
                                                            <Image Source="x_icon.png" WidthRequest="12" HeightRequest="12" HorizontalOptions="Center" VerticalOptions="Center"/>
                                                        </Border>

                                                        <Border StrokeShape="RoundRectangle 5" StrokeThickness="1" Stroke="#404040" BackgroundColor="Transparent" WidthRequest="32" HeightRequest="32" Padding="6">
                                                            <Border.GestureRecognizers>
                                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteNotificationCommand}" CommandParameter="{Binding .}" />
                                                            </Border.GestureRecognizers>
                                                            <Image Source="delete_icon.png" Aspect="AspectFit" Opacity="0.7"/>
                                                        </Border>

                                                    </HorizontalStackLayout>
                                                </Grid>
                                            </Border>
                                        </ContentView>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                    </VerticalStackLayout>


                </Grid>
            </ScrollView>
        </Grid>


        <Grid Grid.ColumnSpan="{OnIdiom Phone=1, Default=2}" IsVisible="{Binding IsMenuVisible}" BackgroundColor="#CC121212" ZIndex="100">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding ToggleMenuCommand}" />
            </Grid.GestureRecognizers>
            <controls:SidebarMenu HorizontalOptions="Start" ActiveTab="Notifications" WidthRequest="300"/>
        </Grid>

        <Grid IsVisible="{Binding IsBusy}" BackgroundColor="#CC121212" ZIndex="450">
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="20">
                <ActivityIndicator IsRunning="{Binding IsBusy}" Color="#7F00FF" WidthRequest="60" HeightRequest="60" />
                <Label Text="Ładowanie powiadomień..." TextColor="White" FontAttributes="Bold" FontSize="16" HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>

        <Grid IsVisible="{Binding IsCustomAlertVisible}" Style="{StaticResource PopupOverlayStyle}" ZIndex="500">
            <Border StrokeShape="RoundRectangle 10" Style="{StaticResource PopupContainerStyle}" MaximumWidthRequest="400">
                <VerticalStackLayout Spacing="15">
                    <Label Text="{Binding CustomAlertTitle}" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource TextMain}" HorizontalOptions="Center"/>
                    <Label Text="{Binding CustomAlertMessage}" FontSize="14" TextColor="{StaticResource TextSubtle}" LineBreakMode="WordWrap" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,15,0,0">
                        <controls:AppButton Grid.Column="0" Text="{Binding CustomAlertCancelText}" Command="{Binding CloseAlertCommand}" CommandParameter="False" ButtonBackgroundColor="{StaticResource SurfaceDark}" ButtonTextColor="{StaticResource TextMain}" IsVisible="{Binding IsCustomAlertCancelVisible}"/>
                        <controls:AppButton Grid.Column="{Binding AlertAcceptColumn}" Grid.ColumnSpan="{Binding AlertAcceptColumnSpan}" Text="{Binding CustomAlertAcceptText}" Command="{Binding CloseAlertCommand}" CommandParameter="True" ButtonBackgroundColor="{StaticResource PrimaryViolet}" ButtonTextColor="{StaticResource TextMain}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <Grid IsVisible="{Binding IsSummaryPopupVisible}" Style="{StaticResource PopupOverlayStyle}" ZIndex="510">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseSummaryPopupCommand}" />
            </Grid.GestureRecognizers>
            <Border StrokeShape="RoundRectangle 10" Style="{StaticResource PopupContainerStyle}" MaximumWidthRequest="480" MaximumHeightRequest="600">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer />
                </Border.GestureRecognizers>
                <Grid RowDefinitions="Auto, Auto, *, Auto" RowSpacing="0">
                    <Label Grid.Row="0" Text="Podsumowanie dnia" FontSize="22" FontAttributes="Bold"
                           TextColor="White" HorizontalOptions="Center" Margin="0,0,0,20"/>

                    <Label Grid.Row="1" Text="Powiadomienia z dzisiaj:"
                           FontSize="13" TextColor="{StaticResource TextSubtle}" Margin="0,0,0,10"/>

                    <ScrollView Grid.Row="2">
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding SummaryLines}" Spacing="8">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Border StrokeShape="RoundRectangle 10" BackgroundColor="{StaticResource SurfaceDark}"
                                            StrokeThickness="1" Stroke="{StaticResource Border}" Padding="14,12">
                                        <Label Text="{Binding .}" FontSize="13" TextColor="{StaticResource TextMain}"
                                               LineBreakMode="WordWrap"/>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </ScrollView>

                    <controls:AppButton Grid.Row="3" Text="Zamknij" Command="{Binding CloseSummaryPopupCommand}"
                            ButtonBackgroundColor="{StaticResource SurfaceDark}" ButtonTextColor="{StaticResource TextMain}" HorizontalOptions="Fill" Margin="0,20,0,0"/>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</ContentPage>



