<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PayItOff.MauiClient.ViewModels"
             xmlns:controls="clr-namespace:PayItOff.MauiClient.Controls"
             xmlns:converters="clr-namespace:PayItOff.MauiClient.Converters"
             x:Class="PayItOff.MauiClient.Views.WalletPage"
             BackgroundColor="{StaticResource MainBackground}"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <converters:InverseBoolConverter x:Key="InverseBool" />
    </ContentPage.Resources>

    <Grid>
        <Grid ColumnDefinitions="{OnIdiom Phone='0, *', Default='360, *'}">
            <controls:SidebarMenu Grid.Column="0" ActiveTab="Wallet" IsVisible="{OnIdiom Phone=False, Default=True}" />
            <ScrollView Grid.Column="1" VerticalScrollBarVisibility="Always">
                <Grid Padding="{OnIdiom Phone='15', Default='30'}" RowDefinitions="Auto, Auto, Auto, Auto, Auto, *, Auto" RowSpacing="20">

                    <Grid Grid.Row="0" ColumnDefinitions="Auto, *" IsVisible="{OnIdiom Phone=True, Default=False}" Margin="{OnPlatform iOS='0,40,0,0', Android='0,25,0,0', Default='0,10,0,0'}">
                        <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                            <Image Source="payitoff_logo_img.png" WidthRequest="32" HeightRequest="32" VerticalOptions="Center" />
                            <Label Text="PayItOff" FontSize="20" FontAttributes="Bold" TextColor="White" VerticalOptions="Center"/>
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Grid.Column="1" HorizontalOptions="End" Spacing="10" VerticalOptions="Center" BackgroundColor="Transparent">
                            <HorizontalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleMenuCommand}" />
                            </HorizontalStackLayout.GestureRecognizers>
                            <Label Text="MENU" TextColor="White" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                            <Image Source="phone_menu_icon.png" WidthRequest="28" HeightRequest="28" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Grid>

                    <HorizontalStackLayout Grid.Row="1" Spacing="15" VerticalOptions="Center">
                        <HorizontalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                        </HorizontalStackLayout.GestureRecognizers>
                        <Image Source="arrow_left_icon.png" WidthRequest="24" HeightRequest="24" VerticalOptions="Center"/>
                        <Label Text="Powrót" TextColor="{StaticResource TextSubtle}" FontSize="16" VerticalOptions="Center" FontAttributes="Bold"/>
                        <BoxView WidthRequest="1" HeightRequest="20" Color="{StaticResource Border}" VerticalOptions="Center" Margin="10,0"/>
                        <Label Text="Portfel" TextColor="{StaticResource TextMain}" FontSize="{OnIdiom Phone=24, Default=32}" FontAttributes="Bold" VerticalOptions="Center"/>
                    </HorizontalStackLayout>

                    <Grid Grid.Row="2" ColumnDefinitions="*, *, *" ColumnSpacing="{OnIdiom Phone=8, Default=15}">
                        <Border StrokeShape="RoundRectangle 10" Grid.Column="0" BackgroundColor="{StaticResource SurfaceDark}" Padding="{OnIdiom Phone=5, Default=15}" StrokeThickness="2" Stroke="Transparent">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding FilterType}" Value="All">
                                    <Setter Property="Stroke" Value="#7F00FF" />
                                    <Setter Property="BackgroundColor" Value="#251E38" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ChangeFilterCommand}" CommandParameter="All" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout HorizontalOptions="Center">
                                <Label Text="{Binding TotalTransactionsCount}" FontSize="{OnIdiom Phone=20, Default=24}" FontAttributes="Bold" TextColor="{StaticResource TextMain}" HorizontalOptions="Center"/>
                                <Label Text="Wszystkie" FontSize="12" TextColor="{StaticResource TextSubtle}" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Border>

                        <Border StrokeShape="RoundRectangle 10" Grid.Column="1" BackgroundColor="{StaticResource SurfaceDark}" Padding="{OnIdiom Phone=5, Default=15}" StrokeThickness="2" Stroke="Transparent">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding FilterType}" Value="Income">
                                    <Setter Property="Stroke" Value="{StaticResource StatusGreen}" />
                                    <Setter Property="BackgroundColor" Value="#1A2A22" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ChangeFilterCommand}" CommandParameter="Income" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout HorizontalOptions="Center">
                                <Label Text="{Binding IncomesCount}" FontSize="{OnIdiom Phone=20, Default=24}" FontAttributes="Bold" TextColor="{StaticResource StatusGreen}" HorizontalOptions="Center"/>
                                <Label Text="Przychody" FontSize="12" TextColor="{StaticResource TextSubtle}" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Border>

                        <Border StrokeShape="RoundRectangle 10" Grid.Column="2" BackgroundColor="{StaticResource SurfaceDark}" Padding="{OnIdiom Phone=5, Default=15}" StrokeThickness="2" Stroke="Transparent">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding FilterType}" Value="Expense">
                                    <Setter Property="Stroke" Value="{StaticResource StatusRed}" />
                                    <Setter Property="BackgroundColor" Value="#2E1C1C" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ChangeFilterCommand}" CommandParameter="Expense" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout HorizontalOptions="Center">
                                <Label Text="{Binding ExpensesCount}" FontSize="{OnIdiom Phone=20, Default=24}" FontAttributes="Bold" TextColor="{StaticResource StatusRed}" HorizontalOptions="Center"/>
                                <Label Text="Wydatki" FontSize="12" TextColor="{StaticResource TextSubtle}" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="3" ColumnDefinitions="{OnIdiom Phone='*, *', Default='*, Auto'}" ColumnSpacing="10">
                        <controls:AppButton Grid.Column="0" Text="Opłać wydatki" ButtonBackgroundColor="#7F00FF" ButtonTextColor="White" ButtonFontAttributes="{OnIdiom Phone=None, Default=Bold}" ButtonHeight="45" Command="{Binding OpenPaymentPopupCommand}" ButtonFontSize="{OnIdiom Phone=13, Default=14}"/>
                        <Border Grid.Column="1" HeightRequest="45" StrokeShape="RoundRectangle 12" StrokeThickness="0" BackgroundColor="{StaticResource SurfaceDark}" Padding="15,0">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ClearFiltersCommand}" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                                <Image Source="x_icon.png" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                                <Label Text="Usuń filtry" TextColor="{StaticResource TextMain}" FontSize="{OnIdiom Phone=13, Default=14}" VerticalOptions="Center" FontAttributes="Bold" />
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>

                    <Border StrokeShape="RoundRectangle 10" Grid.Row="4" BackgroundColor="{StaticResource SurfaceDark}" Padding="5" StrokeThickness="0">
                        <SearchBar Placeholder="Wpisz szukaną frazę..." Text="{Binding SearchText}" TextColor="{StaticResource TextMain}" PlaceholderColor="{StaticResource TextSubtle}" BackgroundColor="Transparent" CancelButtonColor="{StaticResource TextSubtle}" />
                    </Border>

                    <CollectionView Grid.Row="5" ItemsSource="{Binding Transactions}" SelectionMode="None">
                        <CollectionView.EmptyView>
                            <Grid Padding="40">
                                <Label Text="Brak aktualnych długów" TextColor="{StaticResource TextSubtle}" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Grid>
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <ContentView Padding="0,0,0,15">
                                    <ContentView.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WalletViewModel}}, Path=ShowTransactionDetailsCommand}" CommandParameter="{Binding .}" />
                                    </ContentView.GestureRecognizers>
                                    <Border StrokeShape="RoundRectangle 10" BackgroundColor="{StaticResource SurfaceDark}" Stroke="{Binding ItemBorderBrush}" StrokeThickness="{Binding ItemBorderThickness}" Padding="0" MinimumHeightRequest="80">
                                        <Grid>
                                            <Grid ColumnDefinitions="5, 80, 2*, 2*, 1.5*, 1.5*, Auto" ColumnSpacing="15" IsVisible="{OnIdiom Phone=False, Default=True}">
                                                <BoxView Grid.Column="0" BackgroundColor="{Binding StatusColor}" IsVisible="{Binding ShowStatusBlock}"/>
                                                <Border Grid.Column="1" HeightRequest="50" WidthRequest="50" StrokeThickness="0" StrokeShape="RoundRectangle 25" BackgroundColor="#1E232D" HorizontalOptions="Center" VerticalOptions="Center">
                                                    <Grid>
                                                        <Image Source="default_user_avatar.png" Aspect="AspectFill" IsVisible="{Binding AvatarUrl, Converter={StaticResource InverseStringNullOrEmptyConverter}}" />
                                                        <Image Source="{Binding AvatarUrl}" Aspect="AspectFill"/>
                                                    </Grid>
                                                </Border>
                                                <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="0">
                                                    <Label Text="Kto" FontSize="10" TextColor="{StaticResource TextSubtle}"/>
                                                    <Label Text="{Binding FullName}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextMain}" Margin="0,2"/>
                                                    <Label Text="{Binding CategoriesDisplay}" FontSize="11" TextColor="{StaticResource TextSubtle}"/>
                                                </VerticalStackLayout>
                                                <VerticalStackLayout Grid.Column="3" VerticalOptions="Center" Spacing="0">
                                                    <Label Text="Szczegółowy opis" FontSize="12" TextColor="{StaticResource TextMain}" FontAttributes="Bold"/>
                                                    <Label Text="{Binding Description}" FontSize="13" TextColor="{StaticResource TextSubtle}" Margin="0,4,0,0" LineBreakMode="TailTruncation"/>
                                                    <Label Text="{Binding SettlementStatusHint}" FontSize="11" TextColor="{StaticResource TextSubtle}" Margin="0,4,0,0" IsVisible="{Binding ShowSettlementStatus}" LineBreakMode="WordWrap"/>
                                                </VerticalStackLayout>
                                                <VerticalStackLayout Grid.Column="4" VerticalOptions="Center" Spacing="0" HorizontalOptions="Center">
                                                    <Label Text="Data" FontSize="12" TextColor="{StaticResource TextMain}" FontAttributes="Bold" HorizontalOptions="Center"/>
                                                    <Label Text="{Binding Date, StringFormat='{0:dd.MM.yyyy}'}" FontSize="13" TextColor="{StaticResource TextSubtle}" Margin="0,4,0,0" HorizontalOptions="Center"/>
                                                </VerticalStackLayout>
                                                <VerticalStackLayout Grid.Column="5" VerticalOptions="Center" Spacing="0" HorizontalOptions="Center" IsVisible="{Binding IsSettlement, Converter={StaticResource InverseBool}}">
                                                    <Label Text="Nazwa grupy" FontSize="12" TextColor="{StaticResource TextMain}" FontAttributes="Bold" HorizontalOptions="Center"/>
                                                    <Label Text="{Binding Description}" FontSize="13" TextColor="{StaticResource TextSubtle}" Margin="0,4,0,0" HorizontalOptions="Center"/>
                                                </VerticalStackLayout>
                                                <VerticalStackLayout Grid.Column="5" VerticalOptions="Center" Spacing="0" HorizontalOptions="Center" IsVisible="{Binding IsSettlement}">
                                                    <Label Text="Tytuł" FontSize="12" TextColor="{StaticResource TextMain}" FontAttributes="Bold" HorizontalOptions="Center"/>
                                                    <Label Text="Spłata długu" FontSize="13" TextColor="{StaticResource TextSubtle}" Margin="0,4,0,0" HorizontalOptions="Center"/>
                                                </VerticalStackLayout>
                                                <Grid Grid.Column="6" VerticalOptions="Center" Padding="0,0,15,0">
                                                    <VerticalStackLayout Spacing="5" IsVisible="{Binding ShowAcceptRejectButtons}">
                                                        <Label Text="{Binding Amount, StringFormat='Kwota spłaty: {0:N2} zł'}" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource StatusGreen}" HorizontalOptions="End" LineBreakMode="NoWrap"/>
                                                        <Border StrokeShape="RoundRectangle 10" HeightRequest="28" BackgroundColor="{StaticResource StatusGreen}" StrokeThickness="0" Padding="15,0">
                                                            <Border.GestureRecognizers>
                                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WalletViewModel}}, Path=AcceptSettlementCommand}" CommandParameter="{Binding .}"/>
                                                            </Border.GestureRecognizers>
                                                            <Label Text="Zaakceptuj" FontSize="11" TextColor="White" FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="Center"/>
                                                        </Border>
                                                        <Border StrokeShape="RoundRectangle 10" HeightRequest="28" BackgroundColor="{StaticResource StatusRed}" StrokeThickness="0" Padding="15,0">
                                                            <Border.GestureRecognizers>
                                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WalletViewModel}}, Path=RejectSettlementCommand}" CommandParameter="{Binding .}"/>
                                                            </Border.GestureRecognizers>
                                                            <Label Text="Odrzuć" FontSize="11" TextColor="White" FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="Center"/>
                                                        </Border>
                                                    </VerticalStackLayout>
                                                    <VerticalStackLayout Spacing="0" IsVisible="{Binding ShowNormalAmount}">
                                                        <Label Text="Kwota" FontSize="12" TextColor="{StaticResource TextMain}" FontAttributes="Bold" HorizontalOptions="End"/>
                                                        <Label Text="{Binding Amount, StringFormat='{0:N2} zł'}" FontSize="16" FontAttributes="Bold" TextColor="{Binding StatusColor}" Margin="0,2,0,0" HorizontalOptions="End"/>
                                                        <Border StrokeShape="RoundRectangle 10" HeightRequest="20" BackgroundColor="{StaticResource StatusGreen}" StrokeThickness="0" Padding="10,0" Margin="0,5,0,0" IsVisible="{Binding ShowRemindButton}">
                                                            <Border.GestureRecognizers>
                                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WalletViewModel}}, Path=RemindDebtCommand}" CommandParameter="{Binding .}"/>
                                                            </Border.GestureRecognizers>
                                                            <Label Text="Przypomnij" FontSize="9" TextColor="White" FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="Center"/>
                                                        </Border>
                                                    </VerticalStackLayout>
                                                </Grid>
                                            </Grid>

                                            <!-- Phone Layout -->
                                            <Grid ColumnDefinitions="5, 50, *, Auto" RowDefinitions="Auto, Auto" ColumnSpacing="10" RowSpacing="10" IsVisible="{OnIdiom Phone=True, Default=False}" Padding="0,15,10,15">
                                                <BoxView Grid.RowSpan="2" Grid.Column="0" BackgroundColor="{Binding StatusColor}" IsVisible="{Binding ShowStatusBlock}"/>

                                                <Border Grid.Row="0" Grid.Column="1" HeightRequest="40" WidthRequest="40" StrokeThickness="0" StrokeShape="RoundRectangle 20" BackgroundColor="#1E232D" HorizontalOptions="Center" VerticalOptions="Start">
                                                    <Grid>
                                                        <Image Source="default_user_avatar.png" Aspect="AspectFill" IsVisible="{Binding AvatarUrl, Converter={StaticResource InverseStringNullOrEmptyConverter}}" />
                                                        <Image Source="{Binding AvatarUrl}" Aspect="AspectFill"/>
                                                    </Grid>
                                                </Border>

                                                <VerticalStackLayout Grid.Row="0" Grid.Column="2" VerticalOptions="Center" Spacing="2">
                                                    <Label Text="{Binding FullName}" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource TextMain}" LineBreakMode="TailTruncation"/>
                                                    <Label Text="{Binding CategoriesDisplay}" FontSize="11" TextColor="{StaticResource TextSubtle}" LineBreakMode="TailTruncation"/>
                                                </VerticalStackLayout>

                                                <VerticalStackLayout Grid.Row="0" Grid.Column="3" VerticalOptions="Center" Spacing="2" HorizontalOptions="End">
                                                    <Label Text="{Binding Amount, StringFormat='{0:N2} zł'}" FontSize="16" FontAttributes="Bold" TextColor="{Binding StatusColor}" HorizontalOptions="End"/>
                                                    <Label Text="{Binding Date, StringFormat='{0:dd.MM.yyyy}'}" FontSize="11" TextColor="{StaticResource TextSubtle}" HorizontalOptions="End"/>
                                                </VerticalStackLayout>

                                                <VerticalStackLayout Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" VerticalOptions="Center" Spacing="2">
                                                    <Label Text="{Binding Description}" FontSize="13" TextColor="{StaticResource TextSubtle}" LineBreakMode="TailTruncation" MaxLines="2"/>
                                                    <Label Text="{Binding SettlementStatusHint}" FontSize="11" TextColor="{StaticResource TextSubtle}" IsVisible="{Binding ShowSettlementStatus}" LineBreakMode="WordWrap"/>
                                                </VerticalStackLayout>

                                                <VerticalStackLayout Grid.Row="1" Grid.Column="3" VerticalOptions="Center" Spacing="5" HorizontalOptions="End">
                                                    <HorizontalStackLayout Spacing="5" IsVisible="{Binding ShowAcceptRejectButtons}" HorizontalOptions="End">
                                                        <Border HeightRequest="25" BackgroundColor="{StaticResource StatusGreen}" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="10,0">
                                                            <Border.GestureRecognizers>
                                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WalletViewModel}}, Path=AcceptSettlementCommand}" CommandParameter="{Binding .}"/>
                                                            </Border.GestureRecognizers>
                                                            <Label Text="Tak" FontSize="11" TextColor="White" FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="Center"/>
                                                        </Border>
                                                        <Border HeightRequest="25" BackgroundColor="{StaticResource StatusRed}" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="10,0">
                                                            <Border.GestureRecognizers>
                                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WalletViewModel}}, Path=RejectSettlementCommand}" CommandParameter="{Binding .}"/>
                                                            </Border.GestureRecognizers>
                                                            <Label Text="Nie" FontSize="11" TextColor="White" FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="Center"/>
                                                        </Border>
                                                    </HorizontalStackLayout>
                                                    <Border HeightRequest="25" BackgroundColor="{StaticResource StatusGreen}" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="10,0" IsVisible="{Binding ShowRemindButton}" HorizontalOptions="End">
                                                        <Border.GestureRecognizers>
                                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WalletViewModel}}, Path=RemindDebtCommand}" CommandParameter="{Binding .}"/>
                                                        </Border.GestureRecognizers>
                                                        <Label Text="Przypomnij" FontSize="10" TextColor="White" FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="Center"/>
                                                    </Border>
                                                </VerticalStackLayout>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </ContentView>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Border StrokeShape="RoundRectangle 10" Grid.Row="6" BackgroundColor="{StaticResource SurfaceDark}" Padding="10" Margin="0,10,0,0" VerticalOptions="End">
                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <Border Grid.Column="0" HeightRequest="40" StrokeShape="RoundRectangle 12" StrokeThickness="0" BackgroundColor="#1E232D" Padding="12,0">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding PreviousPageCommand}" />
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                                    <Image Source="arrow_left_icon.png" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                                    <Label Text="Poprzednia" TextColor="White" FontSize="12" VerticalOptions="Center" FontAttributes="Bold" />
                                </HorizontalStackLayout>
                            </Border>
                            <HorizontalStackLayout Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
                                <Label Text="Strona" TextColor="{StaticResource TextSubtle}" VerticalOptions="Center"/>
                                <Label Text="{Binding CurrentPage}" FontAttributes="Bold" TextColor="White" VerticalOptions="Center"/>
                                <Label Text="z" TextColor="{StaticResource TextSubtle}" VerticalOptions="Center"/>
                                <Label Text="{Binding TotalPages}" FontAttributes="Bold" TextColor="White" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                            <Border Grid.Column="2" HeightRequest="40" StrokeShape="RoundRectangle 12" StrokeThickness="0" BackgroundColor="#1E232D" Padding="12,0">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding NextPageCommand}" />
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                                    <Label Text="Następna" TextColor="White" FontSize="12" VerticalOptions="Center" FontAttributes="Bold" />
                                    <Image Source="arrow_right_icon.png" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </ScrollView>
        </Grid>

        <Grid IsVisible="{Binding IsPaymentOverlayVisible}" Style="{StaticResource PopupOverlayStyle}">
            <Border StrokeShape="RoundRectangle 10" Style="{StaticResource PopupContainerStyle}" MaximumWidthRequest="480" HorizontalOptions="Center">
                <VerticalStackLayout Spacing="14">
                    <Label Text="Opłać dług" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource TextMain}"/>
                    <Label Text="Domyślnie: saldo netto (jak na Menu Głównym) — serwer rozłoży kwotę na grupy i rozliczy wszystko. Najpierw wybierz tryb spłaty, potem osobę lub grupę." FontSize="12" TextColor="{StaticResource TextSubtle}" LineBreakMode="WordWrap"/>

                    <HorizontalStackLayout Spacing="12" VerticalOptions="Center" IsVisible="{Binding CanSwitchToGrossPay}">
                        <Label Text="Spłata wg konkretnej grupy (brutto)" FontSize="14" TextColor="{StaticResource TextMain}" VerticalOptions="Center"/>
                        <Switch IsToggled="{Binding IsNetPayMode, Converter={StaticResource InverseBool}, Mode=TwoWay}" OnColor="#7F00FF" ThumbColor="White" VerticalOptions="Center"/>
                    </HorizontalStackLayout>

                    <VerticalStackLayout Spacing="10" IsVisible="{Binding IsNetPayMode}">
                        <Label Text="Wybierz wierzyciela (saldo netto)" FontSize="12" TextColor="{StaticResource TextSubtle}"/>
                        <Border StrokeShape="RoundRectangle 8" BackgroundColor="#1E232D" StrokeThickness="0" Padding="0">
                            <SearchBar Placeholder="Szukaj po imieniu i nazwisku..." Text="{Binding SearchDebtText}" TextColor="{StaticResource TextMain}" PlaceholderColor="{StaticResource TextSubtle}" BackgroundColor="Transparent" CancelButtonColor="{StaticResource TextSubtle}"/>
                        </Border>
                        <Border StrokeShape="RoundRectangle 8" BackgroundColor="Transparent" StrokeThickness="0" HeightRequest="220" Margin="0,5,0,5">
                            <CollectionView ItemsSource="{Binding FilteredNetPayCreditors}" SelectionMode="Single" SelectedItem="{Binding SelectedNetPayCreditor}">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DebtDisplayItem">
                                        <ContentView Padding="0,0,0,10">
                                            <VisualStateManager.VisualStateGroups>
                                                <VisualStateGroup Name="CommonStates">
                                                    <VisualState Name="Normal" />
                                                    <VisualState Name="Selected">
                                                        <VisualState.Setters>
                                                            <Setter Property="BackgroundColor" Value="Transparent" />
                                                        </VisualState.Setters>
                                                    </VisualState>
                                                    <VisualState Name="PointerOver">
                                                        <VisualState.Setters>
                                                            <Setter Property="BackgroundColor" Value="Transparent" />
                                                        </VisualState.Setters>
                                                    </VisualState>
                                                </VisualStateGroup>
                                            </VisualStateManager.VisualStateGroups>

                                            <Border StrokeShape="RoundRectangle 12" StrokeThickness="2" Padding="15" BackgroundColor="{StaticResource SurfaceDark}">
                                                <VisualStateManager.VisualStateGroups>
                                                    <VisualStateGroup Name="CommonStates">
                                                        <VisualState Name="Normal">
                                                            <VisualState.Setters>
                                                                <Setter Property="BackgroundColor" Value="{StaticResource SurfaceDark}" />
                                                                <Setter Property="Stroke" Value="Transparent" />
                                                            </VisualState.Setters>
                                                        </VisualState>
                                                        <VisualState Name="PointerOver">
                                                            <VisualState.Setters>
                                                                <Setter Property="BackgroundColor" Value="{StaticResource SurfaceLight}" />
                                                                <Setter Property="Stroke" Value="Transparent" />
                                                            </VisualState.Setters>
                                                        </VisualState>
                                                        <VisualState Name="Selected">
                                                            <VisualState.Setters>
                                                                <Setter Property="BackgroundColor" Value="{StaticResource SurfaceLight}" />
                                                                <Setter Property="Stroke" Value="Transparent" />
                                                            </VisualState.Setters>
                                                        </VisualState>
                                                    </VisualStateGroup>
                                                </VisualStateManager.VisualStateGroups>
                                                <Grid ColumnDefinitions="Auto, *, Auto">
                                                    <Border Grid.Column="0" WidthRequest="40" HeightRequest="40" StrokeShape="RoundRectangle 20" BackgroundColor="#1E232D" StrokeThickness="0" Margin="0,0,15,0" VerticalOptions="Center">
                                                        <Grid>
                                                            <Image Source="default_user_avatar.png" Aspect="AspectFill" IsVisible="{Binding AvatarUrl, Converter={StaticResource InverseStringNullOrEmptyConverter}}" />
                                                            <Image Source="{Binding AvatarUrl}" Aspect="AspectFill" />
                                                        </Grid>
                                                    </Border>
                                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                                        <Label Text="{Binding FullName}" TextColor="{StaticResource TextMain}" FontAttributes="Bold" FontSize="14"/>
                                                        <Label Text="Saldo netto (wszystkie grupy)" TextColor="{StaticResource TextSubtle}" FontSize="12" />
                                                    </VerticalStackLayout>
                                                    <Label Grid.Column="2" Text="{Binding Amount, StringFormat='{0:N2} zł'}" TextColor="{StaticResource StatusRed}" FontSize="14" FontAttributes="Bold" VerticalOptions="Center"/>
                                                </Grid>
                                            </Border>
                                        </ContentView>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="10" IsVisible="{Binding IsNetPayMode, Converter={StaticResource InverseBool}}">
                        <Label Text="Wybierz dług (grupa)" FontSize="12" TextColor="{StaticResource TextSubtle}"/>
                        <Border StrokeShape="RoundRectangle 8" BackgroundColor="#1E232D" StrokeThickness="0" Padding="0">
                            <SearchBar Placeholder="Szukaj osoby lub grupy..." Text="{Binding SearchDebtText}" TextColor="{StaticResource TextMain}" PlaceholderColor="{StaticResource TextSubtle}" BackgroundColor="Transparent" CancelButtonColor="{StaticResource TextSubtle}"/>
                        </Border>
                        <Border StrokeShape="RoundRectangle 8" BackgroundColor="Transparent" StrokeThickness="0" HeightRequest="220" Margin="0,5,0,5">
                            <CollectionView ItemsSource="{Binding FilteredPayableDebtOptions}" SelectionMode="Single" SelectedItem="{Binding SelectedPayableDebtOption}">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <ContentView Padding="0,0,0,10">
                                            <VisualStateManager.VisualStateGroups>
                                                <VisualStateGroup Name="CommonStates">
                                                    <VisualState Name="Normal" />
                                                    <VisualState Name="Selected">
                                                        <VisualState.Setters>
                                                            <Setter Property="BackgroundColor" Value="Transparent" />
                                                        </VisualState.Setters>
                                                    </VisualState>
                                                    <VisualState Name="PointerOver">
                                                        <VisualState.Setters>
                                                            <Setter Property="BackgroundColor" Value="Transparent" />
                                                        </VisualState.Setters>
                                                    </VisualState>
                                                </VisualStateGroup>
                                            </VisualStateManager.VisualStateGroups>

                                            <Border StrokeShape="RoundRectangle 12" StrokeThickness="2" Padding="15" BackgroundColor="{StaticResource SurfaceDark}">
                                                <VisualStateManager.VisualStateGroups>
                                                    <VisualStateGroup Name="CommonStates">
                                                        <VisualState Name="Normal">
                                                            <VisualState.Setters>
                                                                <Setter Property="BackgroundColor" Value="{StaticResource SurfaceDark}" />
                                                                <Setter Property="Stroke" Value="Transparent" />
                                                            </VisualState.Setters>
                                                        </VisualState>
                                                        <VisualState Name="PointerOver">
                                                            <VisualState.Setters>
                                                                <Setter Property="BackgroundColor" Value="{StaticResource SurfaceLight}" />
                                                                <Setter Property="Stroke" Value="Transparent" />
                                                            </VisualState.Setters>
                                                        </VisualState>
                                                        <VisualState Name="Selected">
                                                            <VisualState.Setters>
                                                                <Setter Property="BackgroundColor" Value="{StaticResource SurfaceLight}" />
                                                                <Setter Property="Stroke" Value="Transparent" />
                                                            </VisualState.Setters>
                                                        </VisualState>
                                                    </VisualStateGroup>
                                                </VisualStateManager.VisualStateGroups>
                                                <Grid ColumnDefinitions="Auto, *, Auto">
                                                    <Border Grid.Column="0" WidthRequest="40" HeightRequest="40" StrokeShape="RoundRectangle 20" BackgroundColor="#1E232D" StrokeThickness="0" Margin="0,0,15,0" VerticalOptions="Center">
                                                        <Grid>
                                                            <Image Source="default_user_avatar.png" Aspect="AspectFill" IsVisible="{Binding AvatarUrl, Converter={StaticResource InverseStringNullOrEmptyConverter}}" />
                                                            <Image Source="{Binding AvatarUrl}" Aspect="AspectFill" />
                                                        </Grid>
                                                    </Border>
                                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                                        <Label Text="{Binding CreditorName, StringFormat='{0}'}" TextColor="{StaticResource TextMain}" FontAttributes="Bold" FontSize="14"/>
                                                        <Label Text="{Binding GroupName, StringFormat='Grupa: {0}'}" TextColor="{StaticResource TextSubtle}" FontSize="12" />
                                                    </VerticalStackLayout>
                                                    <Label Grid.Column="2" Text="{Binding Amount, StringFormat='{0:N2} zł'}" TextColor="{StaticResource StatusRed}" FontSize="14" FontAttributes="Bold" VerticalOptions="Center"/>
                                                </Grid>
                                            </Border>
                                        </ContentView>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </Border>
                    </VerticalStackLayout>

                    <Label Text="Kwota do zapłaty (PLN)" FontSize="12" TextColor="{StaticResource TextSubtle}"/>
                    <Entry Text="{Binding PaymentAmountText}" Keyboard="Numeric" Placeholder="np. 50,00" TextColor="{StaticResource TextMain}" PlaceholderColor="{StaticResource TextSubtle}" BackgroundColor="#1E232D"/>

                    <Label Text="{Binding PaymentFormHint}" FontSize="12" TextColor="{StaticResource StatusRed}" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,8,0,0">
                        <controls:AppButton Grid.Column="0" Text="Anuluj" Command="{Binding ClosePaymentPopupCommand}" ButtonBackgroundColor="{StaticResource SurfaceDark}" ButtonTextColor="{StaticResource TextMain}" />
                        <controls:AppButton Grid.Column="1" Text="Wyślij spłatę" Command="{Binding SubmitSettlementCommand}" ButtonBackgroundColor="{StaticResource PrimaryViolet}" ButtonTextColor="{StaticResource TextMain}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <Grid IsVisible="{Binding IsTransactionDetailsPopupVisible}" Style="{StaticResource PopupOverlayStyle}" ZIndex="200">
            <Border StrokeShape="RoundRectangle 10" Style="{StaticResource PopupContainerStyle}" MaximumWidthRequest="400" MaximumHeightRequest="650" HorizontalOptions="Center" VerticalOptions="Center">
                <ScrollView>
                <VerticalStackLayout Spacing="15">
                    <Label Text="Szczegóły transakcji" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource TextMain}" HorizontalOptions="Center"/>

                    <!-- Settlement Details -->
                    <VerticalStackLayout Spacing="10" IsVisible="{Binding SelectedTransactionDetails.IsSettlement}">
                        <Label Text="Spłata długu" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextMain}" HorizontalOptions="Center"/>
                        <Label Text="{Binding SelectedTransactionDetails.FullName}" FontSize="14" TextColor="{StaticResource TextSubtle}" HorizontalOptions="Center"/>
                        <Label Text="{Binding SelectedTransactionDetails.Amount, StringFormat='{0:N2} zł'}" FontSize="24" FontAttributes="Bold" TextColor="{Binding SelectedTransactionDetails.StatusColor}" HorizontalOptions="Center"/>

                        <Border BackgroundColor="#1E232D" Stroke="Transparent" StrokeShape="RoundRectangle 8" Padding="15" Margin="0,10,0,0">
                            <VerticalStackLayout Spacing="5">
                                <Label Text="Tytuł przelewu" FontSize="12" TextColor="{StaticResource TextSubtle}" HorizontalOptions="Center"/>
                                <Label Text="{Binding SelectedTransactionDetails.TransferReference}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextMain}" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Expense Details -->
                    <VerticalStackLayout Spacing="10" IsVisible="{Binding SelectedTransactionDetails.IsSettlement, Converter={StaticResource InverseBool}}">
                        <Label Text="{Binding SelectedTransactionDetails.Description}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource TextMain}" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                        <Label Text="{Binding SelectedTransactionDetails.CategoriesDisplay}" FontSize="14" TextColor="{StaticResource TextSubtle}" HorizontalOptions="Center"/>
                        <Label Text="{Binding SelectedTransactionDetails.Date, StringFormat='{0:dd.MM.yyyy}'}" FontSize="14" TextColor="{StaticResource TextSubtle}" HorizontalOptions="Center"/>

                        <Label Text="{Binding SelectedTransactionDetails.Amount, StringFormat='Twoja część: {0:N2} zł'}" FontSize="24" FontAttributes="Bold" TextColor="{Binding SelectedTransactionDetails.StatusColor}" HorizontalOptions="Center" Margin="0,10,0,0"/>
                        <Label Text="{Binding SelectedTransactionDetails.Status}" FontSize="12" FontAttributes="Bold" TextColor="{Binding SelectedTransactionDetails.StatusColor}" HorizontalOptions="Center" Margin="0,-5,0,10">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding SelectedTransactionDetails.IsIncome}" Value="True">
                                    <Setter Property="Text" Value="Przychód"/>
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding SelectedTransactionDetails.IsIncome}" Value="False">
                                    <Setter Property="Text" Value="Wydatek"/>
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>

                        <!-- Context info about the original expense -->
                        <BoxView HeightRequest="1" Color="#11FFFFFF" Margin="0,15" />
                        <Label Text="{Binding SelectedExpenseDetails.TotalAmount, StringFormat='Całkowity koszt wydatku: {0:N2} zł'}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextMain}" HorizontalOptions="Center"/>

                        <Label Text="Kto zapłacił za całość:" FontSize="14" TextColor="{StaticResource TextSubtle}" Margin="0,10,0,0"/>
                        <Grid ColumnDefinitions="Auto, *">
                            <Border Grid.Column="0" WidthRequest="30" HeightRequest="30" StrokeShape="RoundRectangle 15" BackgroundColor="#1E232D" StrokeThickness="0" Margin="0,0,10,0" VerticalOptions="Center">
                                <Grid>
                                    <Image Source="default_user_avatar.png" Aspect="AspectFill" IsVisible="{Binding SelectedExpenseDetails.PayerAvatarUrl, Converter={StaticResource InverseStringNullOrEmptyConverter}}" />
                                    <Image Source="{Binding SelectedExpenseDetails.PayerAvatarUrl}" Aspect="AspectFill" />
                                </Grid>
                            </Border>
                            <Label Grid.Column="1" Text="{Binding SelectedExpenseDetails.PayerName}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextMain}" VerticalOptions="Center"/>
                        </Grid>

                        <Label Text="Kto brał udział:" FontSize="14" TextColor="{StaticResource TextSubtle}" Margin="0,15,0,0"/>
                        <ScrollView MaximumHeightRequest="200" Margin="0,0,0,10">
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding SelectedExpenseDetails.Participants}" Spacing="10" Padding="0,0,15,0">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10" Padding="0,0,10,0">
                                            <Border Grid.Column="0" WidthRequest="30" HeightRequest="30" StrokeShape="RoundRectangle 15" BackgroundColor="#1E232D" StrokeThickness="0" VerticalOptions="Center">
                                                <Grid>
                                                    <Image Source="default_user_avatar.png" Aspect="AspectFill" IsVisible="{Binding AvatarUrl, Converter={StaticResource InverseStringNullOrEmptyConverter}}" />
                                                    <Image Source="{Binding AvatarUrl}" Aspect="AspectFill" />
                                                </Grid>
                                            </Border>
                                            <Label Grid.Column="1" Text="{Binding FullName}" FontSize="14" TextColor="{StaticResource TextMain}" VerticalOptions="Center" LineBreakMode="TailTruncation"/>
                                            <Label Grid.Column="2" Text="{Binding OwedAmount, StringFormat='{0:N2} zł'}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextMain}" VerticalOptions="Center" HorizontalOptions="End"/>
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </ScrollView>
                    </VerticalStackLayout>

                    <controls:AppButton Text="Wyświetl zdjęcia" Command="{Binding ShowExpensePhotosCommand}" ButtonBackgroundColor="{StaticResource SurfaceDark}" ButtonTextColor="{StaticResource TextMain}" Margin="0,10,0,0" IsVisible="{Binding HasExpensePhotos}"/>

                    <Border HeightRequest="48" StrokeShape="RoundRectangle 12" BackgroundColor="{StaticResource SurfaceDark}" StrokeThickness="0" Margin="0,15,0,0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CloseTransactionDetailsPopupCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="Zamknij" TextColor="{StaticResource TextMain}" HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold" />
                    </Border>
                </VerticalStackLayout>
                </ScrollView>
            </Border>
        </Grid>

        <!-- PHOTO VIEWER POPUP -->
        <Grid IsVisible="{Binding IsPhotoViewerVisible}" Style="{StaticResource PopupOverlayStyle}" ZIndex="500">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding ClosePhotoViewerCommand}" />
            </Grid.GestureRecognizers>
            <Border StrokeShape="RoundRectangle 10" Style="{StaticResource PopupContainerStyle}" MaximumWidthRequest="1200" MaximumHeightRequest="900" HorizontalOptions="Center" VerticalOptions="Center">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer />
                </Border.GestureRecognizers>
                <Grid RowDefinitions="Auto, *, Auto, Auto" RowSpacing="10" Padding="15">
                    <!-- Title -->
                    <Label Grid.Row="0" Text="{Binding PhotoViewerTitle}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource TextMain}" HorizontalOptions="Center"/>

                    <!-- Main Image -->
                    <Grid Grid.Row="1" MinimumHeightRequest="500">
                        <Image Source="{Binding SelectedExpensePhotoUrl}" Aspect="AspectFit">
                            <Image.GestureRecognizers>
                                <SwipeGestureRecognizer Direction="Left" Command="{Binding PhotoSwipeLeftCommand}" />
                                <SwipeGestureRecognizer Direction="Right" Command="{Binding PhotoSwipeRightCommand}" />
                            </Image.GestureRecognizers>
                        </Image>
                    </Grid>

                    <!-- Thumbnails -->
                    <CollectionView Grid.Row="2" ItemsSource="{Binding ExpensePhotosToView}"
                                    HeightRequest="60" HorizontalOptions="Center" Margin="0,5">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border WidthRequest="50" HeightRequest="50" StrokeShape="RoundRectangle 8" StrokeThickness="2" Stroke="Transparent" BackgroundColor="#1E232D" Opacity="0.5">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding BindingContext.SelectPhotoThumbnailCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}" CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Image Source="{Binding .}" Aspect="AspectFill" />
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- Close Button -->
                    <Border Grid.Row="3" HeightRequest="48" StrokeShape="RoundRectangle 12" BackgroundColor="{StaticResource SurfaceDark}" StrokeThickness="0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ClosePhotoViewerCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="Zamknij" TextColor="{StaticResource TextMain}" HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold" />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Grid IsVisible="{Binding IsCustomAlertVisible}" Style="{StaticResource PopupOverlayStyle}">
            <Border StrokeShape="RoundRectangle 10" Style="{StaticResource PopupContainerStyle}" MaximumWidthRequest="400">
                <VerticalStackLayout Spacing="15">
                    <Label Text="{Binding CustomAlertTitle}" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource TextMain}" HorizontalOptions="Center"/>
                    <Label Text="{Binding CustomAlertMessage}" FontSize="14" TextColor="{StaticResource TextSubtle}" LineBreakMode="WordWrap" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,15,0,0">
                        <controls:AppButton Grid.Column="0" Text="{Binding CustomAlertCancelText}" Command="{Binding CloseAlertCommand}" CommandParameter="False" ButtonBackgroundColor="{StaticResource SurfaceDark}" ButtonTextColor="{StaticResource TextMain}" IsVisible="{Binding IsCustomAlertCancelVisible}"/>
                        <controls:AppButton Grid.Column="{Binding AlertAcceptColumn}" Grid.ColumnSpan="{Binding AlertAcceptColumnSpan}" Text="{Binding CustomAlertAcceptText}" Command="{Binding CloseAlertCommand}" CommandParameter="True" ButtonBackgroundColor="{StaticResource PrimaryViolet}" ButtonTextColor="{StaticResource TextMain}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <Grid IsVisible="{Binding IsActionSheetVisible}" Style="{StaticResource PopupOverlayStyle}">
            <Border StrokeShape="RoundRectangle 10" Style="{StaticResource PopupContainerStyle}" MaximumWidthRequest="400">
                <VerticalStackLayout Spacing="15">
                    <Label Text="{Binding ActionSheetTitle}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource TextMain}" HorizontalOptions="Center"/>

                    <CollectionView ItemsSource="{Binding ActionSheetOptions}" MaximumHeightRequest="250">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <ContentView Padding="0,0,0,10">
                                    <Border StrokeShape="RoundRectangle 10" BackgroundColor="#251E38" Stroke="Transparent" Padding="15">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WalletViewModel}}, Path=SelectActionSheetOptionCommand}" CommandParameter="{Binding .}"/>
                                        </Border.GestureRecognizers>
                                        <Label Text="{Binding .}" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center"/>
                                    </Border>
                                </ContentView>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <controls:AppButton Text="Anuluj" Command="{Binding CancelActionSheetCommand}" ButtonBackgroundColor="{StaticResource SurfaceDark}" ButtonTextColor="{StaticResource TextMain}" Margin="0,10,0,0"/>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <Grid IsVisible="{Binding IsMenuVisible}" BackgroundColor="#CC121212" ZIndex="100">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding ToggleMenuCommand}" />
            </Grid.GestureRecognizers>
            <controls:SidebarMenu HorizontalOptions="Start" ActiveTab="Wallet" WidthRequest="300"/>
        </Grid>

        <Grid IsVisible="{Binding IsBusy}" BackgroundColor="#CC121212" ZIndex="450">
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="20">
                <ActivityIndicator IsRunning="{Binding IsBusy}" Color="#7F00FF" WidthRequest="60" HeightRequest="60" />
                <Label Text="Pobieranie transakcji..." TextColor="White" FontAttributes="Bold" FontSize="16" HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>



