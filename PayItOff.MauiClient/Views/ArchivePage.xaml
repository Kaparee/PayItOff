<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:PayItOff.MauiClient.Controls"
             xmlns:models="clr-namespace:PayItOff.Shared.Responses;assembly=PayItOff.Shared"
             xmlns:vm="clr-namespace:PayItOff.MauiClient.ViewModels"
             x:Class="PayItOff.MauiClient.Views.ArchivePage"
             BackgroundColor="{StaticResource MainBackground}"
             Shell.NavBarIsVisible="False">

    <Grid>
        
        <Grid ColumnDefinitions="{OnIdiom Phone='0, *', Default='360, *'}">

            
            <controls:SidebarMenu Grid.Column="0"
                                  ActiveTab="Archive"
                                  IsVisible="{OnIdiom Phone=False, Default=True}" />

            
            <ScrollView Grid.Column="1" VerticalScrollBarVisibility="Always">
                <Grid Padding="{OnIdiom Phone='15', Default='40'}" RowDefinitions="Auto, Auto, *" RowSpacing="30">

                    
                    <HorizontalStackLayout Grid.Row="0" HorizontalOptions="End" IsVisible="{OnIdiom Phone=True, Default=False}" Margin="0,10,0,0">
                        <HorizontalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleMenuCommand}" />
                        </HorizontalStackLayout.GestureRecognizers>
                        <Image Source="phone_menu_icon.png" WidthRequest="28" HeightRequest="28" VerticalOptions="Center"/>
                        <Label Text="Menu" TextColor="{StaticResource TextMain}" FontAttributes="Bold" VerticalOptions="Center" Margin="5,0,0,0" FontSize="18"/>
                    </HorizontalStackLayout>

                    
                    <BoxView Grid.Row="1" HeightRequest="1" Color="{StaticResource Border}" VerticalOptions="Start" Margin="-40,10,-40,0" IsVisible="{OnIdiom Phone=False, Default=True}" Opacity="0.5"/>

                    
                    
                    
                    <VerticalStackLayout Grid.Row="2" Spacing="20">
                        <Label Text="Zarchiwizowane Grupy" TextColor="{StaticResource TextMain}" FontSize="32" FontAttributes="Bold" HorizontalOptions="Start"/>

                        <CollectionView ItemsSource="{Binding ArchivedGroups}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:GroupInfoResponse">
                                    <Grid Padding="0,0,0,20">
                                        <Border StrokeShape="RoundRectangle 15"
                                                BackgroundColor="{StaticResource SurfaceDark}"
                                                Padding="20" StrokeThickness="0">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ArchiveViewModel}}, Path=GroupTappedCommand}"
                                                    CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>

                                            <Grid ColumnDefinitions="60, *, Auto" ColumnSpacing="20">
                                                <Border Grid.Column="0" HeightRequest="60" WidthRequest="60"
                                                        StrokeShape="RoundRectangle 30" StrokeThickness="0" BackgroundColor="#1E232D">
                                                    <Grid>
                                                        <Image Source="{Binding AvatarUrl}" Aspect="AspectFill" />
                                                    </Grid>
                                                </Border>

                                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                                    <Label Text="{Binding Name}" TextColor="White"
                                                           FontAttributes="Bold" FontSize="20"/>
                                                    <Label Text="{Binding UpdatedAt, StringFormat='Usunięto: {0:dd.MM.yyyy}'}" TextColor="{StaticResource TextSubtle}" FontSize="14"/>
                                                </VerticalStackLayout>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                            <CollectionView.EmptyView>
                                <Label Text="Brak usuniętych grup." TextColor="{StaticResource TextSubtle}" HorizontalOptions="Center" Margin="0,30,0,0"/>
                            </CollectionView.EmptyView>
                        </CollectionView>
                    </VerticalStackLayout>
                    
                </Grid>
            </ScrollView>
        </Grid>

        
        <Grid IsVisible="{Binding IsMenuVisible}" BackgroundColor="#CC121212" ZIndex="100">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding ToggleMenuCommand}" />
            </Grid.GestureRecognizers>
            <Border HorizontalOptions="End" VerticalOptions="Start" Margin="0,60,20,0" WidthRequest="220" BackgroundColor="{StaticResource SurfaceDark}" StrokeShape="RoundRectangle 15" StrokeThickness="0" Padding="15">
                <VerticalStackLayout Spacing="15">
                    <Label Text="PayItOff!" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource TextMain}" Margin="0,0,0,10"/>

                    <HorizontalStackLayout Spacing="15" Padding="15,12">
                        <HorizontalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="//MainPage" />
                        </HorizontalStackLayout.GestureRecognizers>
                        <Image Source="home_icon.png" WidthRequest="24" HeightRequest="24" Opacity="0.7"/>
                        <Label Text="Menu Główne" TextColor="{StaticResource TextSubtle}" VerticalOptions="Center" FontSize="16"/>
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Spacing="15" Padding="15,12">
                        <HorizontalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="//GroupsPage" />
                        </HorizontalStackLayout.GestureRecognizers>
                        <Image Source="groups_icon.png" WidthRequest="24" HeightRequest="24" Opacity="0.7"/>
                        <Label Text="Twoje Grupy" TextColor="{StaticResource TextSubtle}" VerticalOptions="Center" FontSize="16"/>
                    </HorizontalStackLayout>

                    <BoxView HeightRequest="1" Color="{StaticResource Border}" Margin="0,10" Opacity="0.5"/>
                    <HorizontalStackLayout Spacing="15" Padding="15,12">
                        <HorizontalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding LogoutCommand}" />
                        </HorizontalStackLayout.GestureRecognizers>
                        <Image Source="logout_icon.png" WidthRequest="24" HeightRequest="24" VerticalOptions="Center"/>
                        <Label Text="Wyloguj się" TextColor="{StaticResource StatusRed}" FontAttributes="Bold" VerticalOptions="Center" FontSize="16"/>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- Custom Alert Popup -->
        <Grid IsVisible="{Binding IsCustomAlertVisible}" Style="{StaticResource PopupOverlayStyle}" ZIndex="500">
            <Border Style="{StaticResource PopupContainerStyle}" MaximumWidthRequest="400">
                <VerticalStackLayout Spacing="15">
                    <Label Text="{Binding CustomAlertTitle}" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource TextMain}" HorizontalOptions="Center"/>
                    <Label Text="{Binding CustomAlertMessage}" FontSize="14" TextColor="{StaticResource TextSubtle}" LineBreakMode="WordWrap" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,15,0,0">
                        <Button Grid.Column="0" Text="{Binding CustomAlertCancelText}" Command="{Binding CloseAlertCommand}" CommandParameter="False" Style="{StaticResource SecondaryButtonStyle}" IsVisible="{Binding IsCustomAlertCancelVisible}"/>
                        <Button Grid.Column="{Binding AlertAcceptColumn}" Grid.ColumnSpan="{Binding AlertAcceptColumnSpan}" Text="{Binding CustomAlertAcceptText}" Command="{Binding CloseAlertCommand}" CommandParameter="True" Style="{StaticResource PrimaryButtonStyle}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>
</ContentPage>
