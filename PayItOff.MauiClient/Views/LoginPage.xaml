<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:PayItOff.MauiClient.Controls"
             xmlns:viewmodels="clr-namespace:PayItOff.MauiClient.ViewModels"
             x:Class="PayItOff.MauiClient.Views.LoginPage"
             x:DataType="viewmodels:LoginViewModel"
             BackgroundColor="{StaticResource MainBackground}">

    <ContentPage.Resources>
        <Style x:Key="PasswordEntryBorderStyle" TargetType="Border" BasedOn="{StaticResource BaseEntryBorderStyle}">
            <Style.Triggers>
                <DataTrigger TargetType="Border" Binding="{Binding HasError}" Value="True">

                    <Setter Property="Stroke" Value="{StaticResource StatusRed}" />
                    <Setter Property="StrokeThickness" Value="2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </ContentPage.Resources>

    <Grid>
        <ScrollView>

        <VerticalStackLayout Spacing="25" Padding="{OnIdiom Phone='20', Default='30'}" VerticalOptions="Center" MaximumWidthRequest="450">

            <Image Source="payitoff_logo_img.png" HeightRequest="150" WidthRequest="150" HorizontalOptions="Center" Margin="0,0,0,0" />
            <Label Text="PayItOff!" Style="{StaticResource Headline}" Margin="0,0,0,20" HorizontalOptions="Center" />

            <VerticalStackLayout Spacing="8">

                <Label Text="Adres E-Mail lub Nazwa Użytkownika"
                       TextColor="{StaticResource TextSubtle}"
                       Margin="15, 0, 0, 0" />
                <Border StrokeShape="RoundRectangle 10" Style="{StaticResource BaseEntryBorderStyle}">

                    <Entry Text="{Binding EmailOrNickname}"
                           Placeholder="Wpisz email lub nickname..."
                           Keyboard="Email"
                           ReturnType="Next"
                           Margin="0" />
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8">

                <Label Text="Hasło" TextColor="{StaticResource TextSubtle}" Margin="15, 0, 0, 0" />
                <Border StrokeShape="RoundRectangle 10" Style="{StaticResource PasswordEntryBorderStyle}">
                    <Grid ColumnDefinitions="*, Auto">

                        <Entry Grid.Column="0"
                               Text="{Binding Password}"
                               IsPassword="{Binding IsPasswordHidden}"
                               Placeholder="••••••••"
                               ReturnCommand="{Binding LoginCommand}"
                               ReturnType="Done"
                               Margin="0" />

                        <ImageButton Grid.Column="1"
                                     Source="{Binding PasswordIcon}"
                                     Command="{Binding TogglePasswordVisibilityCommand}"
                                     BackgroundColor="Transparent"
                                     Padding="12"
                                     HeightRequest="45"
                                     WidthRequest="45"
                                     VerticalOptions="Center" />
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <Grid ColumnDefinitions="36, Auto" ColumnSpacing="4" HorizontalOptions="Start" Margin="0,5,0,0">
                <CheckBox Grid.Column="0" IsChecked="{Binding RememberMe}" VerticalOptions="Center" HorizontalOptions="Center" />
                <Label Grid.Column="1" Text="Zapamiętaj mnie" VerticalOptions="Center" HorizontalOptions="Start" />
            </Grid>


            <controls:AppButton Text="Zaloguj się"
                    Command="{Binding LoginCommand}"
                    Margin="0,10,0,0" />

            <controls:AppButton Text="Nie masz konta? Zarejestruj się"
                    ButtonBackgroundColor="Transparent" ButtonTextColor="{StaticResource BrandViolet}"
                    Command="{Binding GoToRegisterCommand}" />



        </VerticalStackLayout>
        </ScrollView>

        <Grid IsVisible="{Binding IsBusy}" BackgroundColor="#B3000000" ZIndex="999">
            <Border HorizontalOptions="Center" VerticalOptions="Center">
                <VerticalStackLayout Spacing="15" HorizontalOptions="Center" VerticalOptions="Center">
                    <ActivityIndicator IsRunning="{Binding IsBusy}" Color="{StaticResource BrandViolet}" HorizontalOptions="Center" />
                    <Label Text="Logowanie..." TextColor="{StaticResource TextSubtle}" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- Custom Alert Popup -->
        <Grid IsVisible="{Binding IsCustomAlertVisible}" Style="{StaticResource PopupOverlayStyle}" ZIndex="500">
            <Border StrokeShape="RoundRectangle 10" Style="{StaticResource PopupContainerStyle}" MaximumWidthRequest="400">
                <VerticalStackLayout Spacing="15">
                    <Label Text="{Binding CustomAlertTitle}" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource TextMain}" HorizontalOptions="Center"/>

                    <ScrollView MaximumHeightRequest="250">
                        <Label Text="{Binding CustomAlertMessage}" TextType="Html" FontSize="14" TextColor="{StaticResource TextSubtle}" LineBreakMode="WordWrap" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                    </ScrollView>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,15,0,0">
                        <controls:AppButton Grid.Column="0" Text="{Binding CustomAlertCancelText}" Command="{Binding CloseAlertCommand}" CommandParameter="False" ButtonBackgroundColor="{StaticResource SurfaceDark}" ButtonTextColor="{StaticResource TextMain}" IsVisible="{Binding IsCustomAlertCancelVisible}"/>
                        <controls:AppButton Grid.Column="{Binding AlertAcceptColumn}" Grid.ColumnSpan="{Binding AlertAcceptColumnSpan}" Text="{Binding CustomAlertAcceptText}" Command="{Binding CloseAlertCommand}" CommandParameter="True" ButtonBackgroundColor="{StaticResource PrimaryViolet}" ButtonTextColor="{StaticResource TextMain}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>
</ContentPage>


