<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:PayItOff.MauiClient.ViewModels"
             x:Class="PayItOff.MauiClient.Views.LoginPage"
             x:DataType="viewmodels:LoginViewModel"
             BackgroundColor="{StaticResource MainBackground}">

    <ContentPage.Resources>
        <Style x:Key="PasswordEntryBorderStyle" TargetType="Border" BasedOn="{StaticResource BaseEntryBorderStyle}">
            <Style.Triggers>
                <DataTrigger TargetType="Border" Binding="{Binding HasError}" Value="True">
                    
                    <Setter Property="Stroke" Value="{StaticResource StatusRed}" />
                    <Setter Property="StrokeThickness" Value="2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        
        <VerticalStackLayout Spacing="25" Padding="{OnIdiom Phone='20', Default='30'}" VerticalOptions="Center" MaximumWidthRequest="450">

            <Label Text="PayItOff!" Style="{StaticResource Headline}" Margin="0,0,0,20" HorizontalOptions="Center" />

            <VerticalStackLayout Spacing="8">
                
                <Label Text="Adres E-Mail lub Nazwa Użytkownika"
                       TextColor="{StaticResource TextSubtle}"
                       Margin="15, 0, 0, 0" />
                <Border Style="{StaticResource BaseEntryBorderStyle}">
                    
                    <Entry Text="{Binding EmailOrNickname}"
                           Placeholder="Wpisz email lub nickname..."
                           Keyboard="Email"
                           ReturnType="Next"
                           Margin="0" />
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8">
                
                <Label Text="Hasło" TextColor="{StaticResource TextSubtle}" Margin="15, 0, 0, 0" />
                <Border Style="{StaticResource PasswordEntryBorderStyle}">
                    <Grid ColumnDefinitions="*, Auto">

                        <Entry Grid.Column="0"
                               Text="{Binding Password}"
                               IsPassword="{Binding IsPasswordHidden}"
                               Placeholder="••••••••"
                               ReturnCommand="{Binding LoginCommand}"
                               ReturnType="Done"
                               Margin="0" />

                        <ImageButton Grid.Column="1"
                                     Source="{Binding PasswordIcon}"
                                     Command="{Binding TogglePasswordVisibilityCommand}"
                                     BackgroundColor="Transparent"
                                     Padding="12"
                                     HeightRequest="45"
                                     WidthRequest="45"
                                     VerticalOptions="Center" />
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="{StaticResource PrimaryViolet}" />

            
            <Button Text="Zaloguj się"
                    Command="{Binding LoginCommand}"
                    Margin="0,10,0,0" />

            <Button Text="Nie masz konta? Zarejestruj się"
                    Style="{StaticResource GhostButtonStyle}"
                    Command="{Binding GoToRegisterCommand}"
                    TextColor="{StaticResource BrandViolet}" />

            <Button Text="Zaloguj się jako Jakub Płocica"
                    Command="{Binding LoginAsJakubCommand}"
                    Margin="0,10,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>