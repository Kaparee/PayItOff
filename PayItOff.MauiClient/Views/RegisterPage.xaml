<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:PayItOff.MauiClient.Controls"
             xmlns:viewmodels="clr-namespace:PayItOff.MauiClient.ViewModels"
             x:Class="PayItOff.MauiClient.Views.RegisterPage"
             x:DataType="viewmodels:RegisterViewModel"
             Title="Rejestracja"
             BackgroundColor="{StaticResource MainBackground}">

    <ContentPage.Resources>
        <Style x:Key="PasswordEntryBorderStyle" TargetType="Border" BasedOn="{StaticResource BaseEntryBorderStyle}">
            <Style.Triggers>
                <DataTrigger TargetType="Border" Binding="{Binding HasError}" Value="True">
                    <Setter Property="Stroke" Value="{StaticResource StatusRed}" />
                    <Setter Property="StrokeThickness" Value="2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </ContentPage.Resources>

    <Grid>
        <ScrollView>
        <VerticalStackLayout Spacing="15" Padding="{OnPlatform iOS='20,40,20,40', Android='20,30,20,40', Default='30'}" VerticalOptions="Start" MaximumWidthRequest="450">

            <Label Text="Stwórz konto" Style="{StaticResource Headline}" HorizontalOptions="Center" Margin="0,0,0,10" />

            <VerticalStackLayout Spacing="5">
                <Label Margin="15,0,0,0">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Email " TextColor="{StaticResource TextSubtle}" />
                            <Span Text="*" TextColor="Red" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
                <Label Text="Służy tylko do logowania. Nie wysyłamy żadnych wiadomości." FontSize="10" TextColor="{StaticResource TextSubtle}" Margin="15,0,0,5" />
                <Border StrokeShape="RoundRectangle 10" Style="{StaticResource BaseEntryBorderStyle}">
                    <Entry Text="{Binding Email}" Placeholder="email@przyklad.pl" Keyboard="Email" ReturnType="Next" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" />
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="5">
                <Label Margin="15,0,0,0">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Nazwa użytkownika (Nick) " TextColor="{StaticResource TextSubtle}" />
                            <Span Text="*" TextColor="Red" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
                <Border StrokeShape="RoundRectangle 10" Style="{StaticResource BaseEntryBorderStyle}">
                    <Entry Text="{Binding Nickname}" Placeholder="TwojNick" ReturnType="Next" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" />
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="5">
                <Label Margin="15,0,0,0">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Imię " TextColor="{StaticResource TextSubtle}" />
                            <Span Text="*" TextColor="Red" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
                <Border StrokeShape="RoundRectangle 10" Style="{StaticResource BaseEntryBorderStyle}">
                    <Entry Text="{Binding Name}" Placeholder="Jan" ReturnType="Next" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" />
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="5">
                <Label Margin="15,0,0,0">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Nazwisko " TextColor="{StaticResource TextSubtle}" />
                            <Span Text="*" TextColor="Red" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
                <Border StrokeShape="RoundRectangle 10" Style="{StaticResource BaseEntryBorderStyle}">
                    <Entry Text="{Binding Surname}" Placeholder="Kowalski" ReturnType="Next" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" />
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="5">
                <Label Margin="15,10,0,0">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Hasło " TextColor="{StaticResource TextSubtle}" />
                            <Span Text="*" TextColor="Red" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
                <Label Text="Min. 8 znaków, wielka litera, cyfra i znak specjalny" FontSize="10" TextColor="{StaticResource TextSubtle}" Margin="15,0,0,5" />

                <Border StrokeShape="RoundRectangle 10" Style="{StaticResource PasswordEntryBorderStyle}">
                    <Grid ColumnDefinitions="*, Auto">
                        <Entry Grid.Column="0"
                               Text="{Binding Password}"
                               IsPassword="{Binding IsPasswordHidden}"
                               Placeholder="••••••••"
                               ReturnType="Next"
                               Margin="0" />

                        <ImageButton Grid.Column="1"
                                     Source="{Binding PasswordIcon}"
                                     Command="{Binding TogglePasswordVisibilityCommand}"
                                     BackgroundColor="Transparent"
                                     Padding="12"
                                     HeightRequest="45"
                                     WidthRequest="45"
                                     VerticalOptions="Center" />
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="5">
                <Label Text="Numer telefonu (Opcjonalne)" TextColor="{StaticResource TextSubtle}" Margin="15,0,0,0" />
                <Border StrokeShape="RoundRectangle 10" Style="{StaticResource BaseEntryBorderStyle}">
                    <Entry Text="{Binding PhoneNumber}"
                           Placeholder="+48 123 456 789"
                           Keyboard="Telephone"
                           ReturnType="Next"
                           IsSpellCheckEnabled="False"
                           IsTextPredictionEnabled="False" />
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="5">
                <Label Text="Numer konta (IBAN) (Opcjonalne)" TextColor="{StaticResource TextSubtle}" Margin="15,0,0,0" />
                <Border StrokeShape="RoundRectangle 10" Style="{StaticResource BaseEntryBorderStyle}">
                    <Entry Text="{Binding IBAN}"
                           Placeholder="PL 00 0000 0000..."
                           Keyboard="Text"
                           ReturnType="Done"
                           IsSpellCheckEnabled="False"
                           IsTextPredictionEnabled="False" />
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="10" Margin="0,10,0,20" HorizontalOptions="Center">
                <Border StrokeShape="RoundRectangle 10" Stroke="#7F00FF"
                        StrokeThickness="2"
                        HeightRequest="80"
                        WidthRequest="80"
                        HorizontalOptions="Center">

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding PickAvatarCommand}" />
                    </Border.GestureRecognizers>

                    <Border.StrokeShape>
                        <RoundRectangle />
                    </Border.StrokeShape>

                    <Grid>
                        <BoxView Color="#2B2B3D" />

                        <Image Source="camera_icon.png"
                               WidthRequest="32"
                               HeightRequest="32"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               IsVisible="{Binding IsAvatarPlaceholderVisible}" />

                        <Image Source="{Binding AvatarPreviewSource}"
                               Aspect="AspectFill"
                               IsVisible="{Binding IsAvatarImageVisible}" />
                    </Grid>
                </Border>

                <Label Text="Kliknij, aby wybrać zdjęcie"
                       TextColor="#7F00FF"
                       FontSize="12"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <controls:AppButton Text="Zarejestruj się"
                    Command="{Binding RegisterCommand}"
                    Margin="0,10,0,0" />

            <controls:AppButton Text="Masz już konto? Zaloguj się"
                    ButtonBackgroundColor="Transparent" ButtonTextColor="{StaticResource BrandViolet}"
                    Command="{Binding GoToLoginCommand}" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HorizontalOptions="Center" Color="{StaticResource BrandViolet}" />

        </VerticalStackLayout>
    </ScrollView>

        <!-- Custom Alert Popup -->
        <Grid IsVisible="{Binding IsCustomAlertVisible}" Style="{StaticResource PopupOverlayStyle}" ZIndex="500">
            <Border StrokeShape="RoundRectangle 10" Style="{StaticResource PopupContainerStyle}" MaximumWidthRequest="400">
                <VerticalStackLayout Spacing="15">
                    <Label Text="{Binding CustomAlertTitle}" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource TextMain}" HorizontalOptions="Center"/>
                    <Label Text="{Binding CustomAlertMessage}" FontSize="14" TextColor="{StaticResource TextSubtle}" LineBreakMode="WordWrap" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,15,0,0">
                        <controls:AppButton Grid.Column="0" Text="{Binding CustomAlertCancelText}" Command="{Binding CloseAlertCommand}" CommandParameter="False" ButtonBackgroundColor="{StaticResource SurfaceDark}" ButtonTextColor="{StaticResource TextMain}" IsVisible="{Binding IsCustomAlertCancelVisible}"/>
                        <controls:AppButton Grid.Column="{Binding AlertAcceptColumn}" Grid.ColumnSpan="{Binding AlertAcceptColumnSpan}" Text="{Binding CustomAlertAcceptText}" Command="{Binding CloseAlertCommand}" CommandParameter="True" ButtonBackgroundColor="{StaticResource PrimaryViolet}" ButtonTextColor="{StaticResource TextMain}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>
</ContentPage>


