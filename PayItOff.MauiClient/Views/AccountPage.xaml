<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:PayItOff.MauiClient.Controls"
             x:Class="PayItOff.MauiClient.Views.AccountPage"
             BackgroundColor="{StaticResource MainBackground}"
             Shell.NavBarIsVisible="False">

    <Grid>

        <Grid ColumnDefinitions="{OnIdiom Phone='0, *', Default='360, *'}">

            <controls:SidebarMenu Grid.Column="0"
                                  ActiveTab="Account"
                                  IsVisible="{OnIdiom Phone=False, Default=True}" />

            <ScrollView Grid.Column="1" VerticalScrollBarVisibility="Always">
                <Grid Padding="40" RowDefinitions="Auto, *">
                    <!-- Menu mobilne -->
                    <Grid Grid.Row="0" ColumnDefinitions="Auto, *" IsVisible="{OnIdiom Phone=True, Default=False}" Margin="{OnPlatform iOS='0,40,0,0', Android='0,25,0,0', Default='0,10,0,0'}">
                        <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                            <Image Source="payitoff_logo_img.png" WidthRequest="32" HeightRequest="32" VerticalOptions="Center" />
                            <Label Text="PayItOff" FontSize="20" FontAttributes="Bold" TextColor="White" VerticalOptions="Center"/>
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Grid.Column="1" HorizontalOptions="End" Spacing="10" VerticalOptions="Center" BackgroundColor="Transparent">
                            <HorizontalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleMenuCommand}" />
                            </HorizontalStackLayout.GestureRecognizers>
                            <Label Text="MENU" TextColor="White" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                            <Image Source="phone_menu_icon.png" WidthRequest="28" HeightRequest="28" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Grid>

                    <!-- Siatka główna (dwie kolumny na desktopie, jedna pod drugą na mobilce) -->
                    <Grid Grid.Row="1" ColumnDefinitions="{OnIdiom Phone='*', Default='*, 1, *'}" RowDefinitions="{OnIdiom Phone='Auto, Auto', Default='Auto'}" ColumnSpacing="30" RowSpacing="{OnIdiom Phone='40', Default='0'}" Margin="0,20,0,0">

                        <!-- LEWA KOLUMNA: profil -->
                        <VerticalStackLayout Grid.Column="0" Grid.Row="0" Spacing="20" HorizontalOptions="Center" MaximumWidthRequest="450">

                            <!-- Awatar -->
                            <Border StrokeShape="RoundRectangle 60" WidthRequest="120" HeightRequest="120" BackgroundColor="White" StrokeThickness="0" HorizontalOptions="Center">
                                <Grid>
                                    <!-- Ikona zastępcza -->
                                    <Image Source="default_user_avatar.png" Aspect="AspectFill" IsVisible="{Binding AvatarUrl, Converter={StaticResource InverseStringNullOrEmptyConverter}}" />
                                    <!-- Awatar -->
                                    <Image Source="{Binding AvatarUrl}" Aspect="AspectFill" />
                                </Grid>
                            </Border>

                            <Label Text="{Binding FullName}" FontSize="24" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center"/>
                            <Label Text="{Binding Email}" FontSize="14" TextColor="{StaticResource TextSubtle}" HorizontalOptions="Center" Margin="0,-10,0,10"/>

                            <!-- Pola tylko do odczytu -->
                            <VerticalStackLayout Spacing="5">
                                <Label Text="Nazwa użytkownika" TextColor="White" FontSize="12" />
                                <Border StrokeShape="RoundRectangle 10" BackgroundColor="{StaticResource SurfaceDark}" StrokeThickness="0" Padding="15,10">
                                    <Label Text="{Binding Username}" TextColor="White" FontSize="14" />
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="5">
                                <Label Text="Imię" TextColor="White" FontSize="12" />
                                <Border StrokeShape="RoundRectangle 10" BackgroundColor="{StaticResource SurfaceDark}" StrokeThickness="0" Padding="15,10">
                                    <Label Text="{Binding FirstName}" TextColor="White" FontSize="14" />
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="5">
                                <Label Text="Nazwisko" TextColor="White" FontSize="12" />
                                <Border StrokeShape="RoundRectangle 10" BackgroundColor="{StaticResource SurfaceDark}" StrokeThickness="0" Padding="15,10">
                                    <Label Text="{Binding LastName}" TextColor="White" FontSize="14" />
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="5">
                                <Label Text="Numer Telefonu" TextColor="White" FontSize="12" />
                                <Border StrokeShape="RoundRectangle 10" BackgroundColor="{StaticResource SurfaceDark}" StrokeThickness="0" Padding="15,10">
                                    <Label Text="{Binding PhoneNumber}" TextColor="White" FontSize="14" />
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="5">
                                <Label Text="Numer Konta" TextColor="White" FontSize="12" />
                                <Border StrokeShape="RoundRectangle 10" BackgroundColor="{StaticResource SurfaceDark}" StrokeThickness="0" Padding="15,10">
                                    <Label Text="{Binding Iban}" TextColor="White" FontSize="14" />
                                </Border>
                            </VerticalStackLayout>

                            <!-- Akcje -->
                            <Grid ColumnDefinitions="*, *" ColumnSpacing="10" Margin="0,10,0,0">
                                <controls:AppButton Grid.Column="0" Text="Edytuj dane użytkownika" Command="{Binding ShowEditDataPopupCommand}" ButtonBackgroundColor="{StaticResource SurfaceDark}" ButtonTextColor="{StaticResource TextMain}" />
                                <controls:AppButton Grid.Column="1" Text="Edytuj zdjęcie profilowe" Command="{Binding ChangeAvatarCommand}" ButtonBackgroundColor="{StaticResource SurfaceDark}" ButtonTextColor="{StaticResource TextMain}" />
                            </Grid>
                            <controls:AppButton Text="Edytuj adres E-Mail" Command="{Binding ShowEditEmailPopupCommand}" ButtonBackgroundColor="{StaticResource SurfaceDark}" ButtonTextColor="{StaticResource TextMain}" />
                            <controls:AppButton Text="Edytuj Hasło" Command="{Binding ShowEditPasswordPopupCommand}" ButtonBackgroundColor="{StaticResource SurfaceDark}" ButtonTextColor="{StaticResource TextMain}" />
                            <controls:AppButton Text="Usuń trwale konto" Command="{Binding ShowDeleteAccountPopupCommand}" ButtonBackgroundColor="Transparent" ButtonTextColor="{StaticResource StatusRed}" ButtonBorderColor="{StaticResource StatusRed}" ButtonBorderWidth="1" Margin="0,10,0,0"/>

                        </VerticalStackLayout>

                        <!-- Separator pionowy (Desktop) -->
                        <BoxView Grid.Column="1" Grid.Row="0" Color="{StaticResource Border}" WidthRequest="1" VerticalOptions="Fill" Opacity="0.5" IsVisible="{OnIdiom Phone=False, Default=True}" />

                        <!-- Separator poziomy (Mobile) -->
                        <BoxView Grid.Column="0" Grid.Row="0" Color="{StaticResource Border}" HeightRequest="1" HorizontalOptions="Fill" VerticalOptions="End" Opacity="0.5" IsVisible="{OnIdiom Phone=True, Default=False}" Margin="0,30,-30,-20" />

                        <!-- PRAWA KOLUMNA: powiadomienia -->
                        <VerticalStackLayout Grid.Column="{OnIdiom Phone=0, Default=2}" Grid.Row="{OnIdiom Phone=1, Default=0}" Spacing="25" Margin="{OnIdiom Phone='0', Default='20,0,0,0'}">
                            <Label Text="Powiadomienia" FontSize="26" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" Margin="0,0,0,20"/>

                            <Grid ColumnDefinitions="*, Auto">
                                <Label Grid.Column="0" Text="Chcę otrzymywać zbiorcze informacje podsumowujące cały dzień (zamiast pojedynczych informacji)" TextColor="White" FontSize="12" VerticalOptions="Center" MaxLines="2" LineBreakMode="WordWrap"/>
                                <Switch Grid.Column="1" IsToggled="{Binding DailySummary}" OnColor="#10B981" ThumbColor="White" />
                            </Grid>

                            <Grid ColumnDefinitions="*, Auto">
                                <Label Grid.Column="0" Text="Powiadomienie o dołączeniu do Grupy" TextColor="White" FontSize="12" VerticalOptions="Center" />
                                <Switch Grid.Column="1" IsToggled="{Binding NotifyOnGroupJoined}" OnColor="#10B981" ThumbColor="White" />
                            </Grid>

                            <Grid ColumnDefinitions="*, Auto">
                                <Label Grid.Column="0" Text="Powiadomienie o dodaniu wydatku" TextColor="White" FontSize="12" VerticalOptions="Center" />
                                <Switch Grid.Column="1" IsToggled="{Binding NotifyOnExpenseAdded}" OnColor="#10B981" ThumbColor="White" />
                            </Grid>

                            <Grid ColumnDefinitions="*, Auto">
                                <Label Grid.Column="0" Text="Powiadomienie o usunięciu z Grupy" TextColor="White" FontSize="12" VerticalOptions="Center" />
                                <Switch Grid.Column="1" IsToggled="{Binding NotifyOnGroupRemoved}" OnColor="#10B981" ThumbColor="White" />
                            </Grid>

                            <Grid ColumnDefinitions="*, Auto">
                                <Label Grid.Column="0" Text="Powiadomienie o usunięciu ze Znajomych" TextColor="White" FontSize="12" VerticalOptions="Center" />
                                <Switch Grid.Column="1" IsToggled="{Binding NotifyOnFriendRemoved}" OnColor="#10B981" ThumbColor="White" />
                            </Grid>

                            <Grid ColumnDefinitions="*, Auto">
                                <Label Grid.Column="0" Text="Powiadomienie o edycji/usunięciu wydatku" TextColor="White" FontSize="12" VerticalOptions="Center" />
                                <Switch Grid.Column="1" IsToggled="{Binding NotifyOnExpenseChanged}" OnColor="#10B981" ThumbColor="White" />
                            </Grid>

                            <Grid ColumnDefinitions="*, Auto">
                                <Label Grid.Column="0" Text="Powiadomienie o potwierdzeniu wysłania przelewu" TextColor="White" FontSize="12" VerticalOptions="Center" />
                                <Switch Grid.Column="1" IsToggled="{Binding NotifyOnTransferConfirmed}" OnColor="#10B981" ThumbColor="White" />
                            </Grid>
                        </VerticalStackLayout>

                    </Grid>

                </Grid>
            </ScrollView>
        </Grid>

        <!-- Popup: menu mobilne -->
        <Grid Grid.ColumnSpan="{OnIdiom Phone=1, Default=2}" IsVisible="{Binding IsMenuVisible}" BackgroundColor="#CC121212" ZIndex="100">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding ToggleMenuCommand}" />
            </Grid.GestureRecognizers>
            <controls:SidebarMenu HorizontalOptions="Start" ActiveTab="Account" WidthRequest="300"/>
        </Grid>

        <!-- Popup: edytuj dane -->
        <Grid IsVisible="{Binding IsEditDataPopupVisible}" Style="{StaticResource PopupOverlayStyle}">
            <Border StrokeShape="RoundRectangle 10" Style="{StaticResource PopupContainerStyle}" WidthRequest="400">
                <VerticalStackLayout Spacing="20">
                    <Grid>
                        <Label Text="Edytuj dane" FontSize="20" FontAttributes="Bold" TextColor="White" HorizontalOptions="Start" VerticalOptions="Center" />
                        <Image Source="x_icon.png" WidthRequest="24" HeightRequest="24" HorizontalOptions="End" VerticalOptions="Center">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding CloseEditDataPopupCommand}" />
                            </Image.GestureRecognizers>
                        </Image>
                    </Grid>

                    <Entry Placeholder="Imię" Text="{Binding EditFirstName}" TextColor="White" BackgroundColor="#242F41" />
                    <Entry Placeholder="Nazwisko" Text="{Binding EditLastName}" TextColor="White" BackgroundColor="#242F41" />
                    <Entry Placeholder="Numer Telefonu" Text="{Binding EditPhoneNumber}" TextColor="White" BackgroundColor="#242F41" />
                    <Entry Placeholder="Numer Konta (IBAN)" Text="{Binding EditIban}" TextColor="White" BackgroundColor="#242F41" />

                    <controls:AppButton Text="Zapisz" Command="{Binding SubmitEditDataCommand}" ButtonBackgroundColor="{StaticResource StatusGreen}" ButtonTextColor="{StaticResource TextMain}" Margin="0,10,0,0"/>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- Popup: edytuj e-mail -->
        <Grid IsVisible="{Binding IsEditEmailPopupVisible}" Style="{StaticResource PopupOverlayStyle}">
            <Border StrokeShape="RoundRectangle 10" Style="{StaticResource PopupContainerStyle}" WidthRequest="400">
                <VerticalStackLayout Spacing="20">
                    <Grid>
                        <Label Text="Zmień E-Mail" FontSize="20" FontAttributes="Bold" TextColor="White" HorizontalOptions="Start" VerticalOptions="Center" />
                        <Image Source="x_icon.png" WidthRequest="24" HeightRequest="24" HorizontalOptions="End" VerticalOptions="Center">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding CloseEditEmailPopupCommand}" />
                            </Image.GestureRecognizers>
                        </Image>
                    </Grid>
                    <Label Text="Wpisz nowy adres e-mail. Na podany adres zostanie wysłany link weryfikacyjny." TextColor="{StaticResource TextSubtle}" FontSize="13" />
                    <Entry Placeholder="Nowy E-Mail" Text="{Binding NewEmail}" Keyboard="Email" TextColor="White" BackgroundColor="#242F41" />
                    <controls:AppButton Text="Wyślij link" Command="{Binding SubmitEditEmailCommand}" ButtonBackgroundColor="{StaticResource StatusGreen}" ButtonTextColor="{StaticResource TextMain}" Margin="0,10,0,0"/>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- Popup: edytuj hasło -->
        <Grid IsVisible="{Binding IsEditPasswordPopupVisible}" Style="{StaticResource PopupOverlayStyle}">
            <Border StrokeShape="RoundRectangle 10" Style="{StaticResource PopupContainerStyle}" WidthRequest="400">
                <VerticalStackLayout Spacing="20">
                    <Grid>
                        <Label Text="Zmień Hasło" FontSize="20" FontAttributes="Bold" TextColor="White" HorizontalOptions="Start" VerticalOptions="Center" />
                        <Image Source="x_icon.png" WidthRequest="24" HeightRequest="24" HorizontalOptions="End" VerticalOptions="Center">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding CloseEditPasswordPopupCommand}" />
                            </Image.GestureRecognizers>
                        </Image>
                    </Grid>
                    <Entry Placeholder="Stare Hasło" IsPassword="True" Text="{Binding OldPassword}" TextColor="White" BackgroundColor="#242F41" />
                    <Entry Placeholder="Nowe Hasło" IsPassword="True" Text="{Binding NewPassword}" TextColor="White" BackgroundColor="#242F41" />
                    <controls:AppButton Text="Zapisz" Command="{Binding SubmitEditPasswordCommand}" ButtonBackgroundColor="{StaticResource StatusGreen}" ButtonTextColor="{StaticResource TextMain}" Margin="0,10,0,0"/>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- Popup: usuń konto -->
        <Grid IsVisible="{Binding IsDeleteAccountPopupVisible}" Style="{StaticResource PopupOverlayStyle}">
            <Border StrokeShape="RoundRectangle 10" Style="{StaticResource PopupContainerStyle}" WidthRequest="400" Stroke="{StaticResource StatusRed}">
                <VerticalStackLayout Spacing="20">
                    <Grid>
                        <Label Text="Usuń Konto" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource StatusRed}" HorizontalOptions="Start" VerticalOptions="Center" />
                        <Image Source="x_icon.png" WidthRequest="24" HeightRequest="24" HorizontalOptions="End" VerticalOptions="Center">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding CloseDeleteAccountPopupCommand}" />
                            </Image.GestureRecognizers>
                        </Image>
                    </Grid>
                    <Label Text="Czy na pewno chcesz usunąć to konto? Tej operacji nie można cofnąć, stracisz wszystkie dane!" TextColor="White" FontSize="14" />
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="10" Margin="0,10,0,0">
                        <controls:AppButton Grid.Column="0" Text="Anuluj" Command="{Binding CloseDeleteAccountPopupCommand}" ButtonBackgroundColor="{StaticResource SurfaceDark}" ButtonTextColor="{StaticResource TextMain}" />
                        <controls:AppButton Grid.Column="1" Text="Usuń Trwale" Command="{Binding SubmitDeleteAccountCommand}" ButtonBackgroundColor="{StaticResource StatusRed}" ButtonTextColor="{StaticResource TextMain}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- Custom Alert Popup -->
        <Grid IsVisible="{Binding IsCustomAlertVisible}" Style="{StaticResource PopupOverlayStyle}" ZIndex="500">
            <Border StrokeShape="RoundRectangle 10" Style="{StaticResource PopupContainerStyle}" MaximumWidthRequest="400">
                <VerticalStackLayout Spacing="15">
                    <Label Text="{Binding CustomAlertTitle}" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource TextMain}" HorizontalOptions="Center"/>
                    <Label Text="{Binding CustomAlertMessage}" FontSize="14" TextColor="{StaticResource TextSubtle}" LineBreakMode="WordWrap" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,15,0,0">
                        <controls:AppButton Grid.Column="0" Text="{Binding CustomAlertCancelText}" Command="{Binding CloseAlertCommand}" CommandParameter="False" ButtonBackgroundColor="{StaticResource SurfaceDark}" ButtonTextColor="{StaticResource TextMain}" IsVisible="{Binding IsCustomAlertCancelVisible}"/>
                        <controls:AppButton Grid.Column="{Binding AlertAcceptColumn}" Grid.ColumnSpan="{Binding AlertAcceptColumnSpan}" Text="{Binding CustomAlertAcceptText}" Command="{Binding CloseAlertCommand}" CommandParameter="True" ButtonBackgroundColor="{StaticResource PrimaryViolet}" ButtonTextColor="{StaticResource TextMain}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>
</ContentPage>


