<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PayItOff.MauiClient.ViewModels"
             xmlns:controls="clr-namespace:PayItOff.MauiClient.Controls"
             xmlns:dto="clr-namespace:PayItOff.Shared.Responses;assembly=PayItOff.Shared"
             x:Class="PayItOff.MauiClient.Views.GroupDetailsPage"
             x:DataType="vm:GroupDetailsViewModel"
             BackgroundColor="{StaticResource MainBackground}"
             Shell.NavBarIsVisible="False">

    <Grid>
        <Grid ColumnDefinitions="{OnIdiom Phone='0, *', Default='360, *'}">
            <controls:SidebarMenu Grid.Column="0" ActiveTab="Groups" IsVisible="{OnIdiom Phone=False, Default=True}" />

            <ScrollView Grid.Column="1" VerticalScrollBarVisibility="Always">
                <VerticalStackLayout Padding="{OnIdiom Phone='15', Default='30'}" Spacing="18">


                    <Grid Grid.Row="0" ColumnDefinitions="Auto, *" IsVisible="{OnIdiom Phone=True, Default=False}" Margin="{OnPlatform iOS='0,40,0,0', Android='0,25,0,0', Default='0,10,0,0'}">
                        <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                            <Image Source="payitoff_logo_img.png" WidthRequest="32" HeightRequest="32" VerticalOptions="Center" />
                            <Label Text="PayItOff" FontSize="20" FontAttributes="Bold" TextColor="White" VerticalOptions="Center"/>
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Grid.Column="1" HorizontalOptions="End" Spacing="10" VerticalOptions="Center" BackgroundColor="Transparent">
                            <HorizontalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleMenuCommand}" />
                            </HorizontalStackLayout.GestureRecognizers>
                            <Label Text="MENU" TextColor="White" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                            <Image Source="phone_menu_icon.png" WidthRequest="28" HeightRequest="28" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Grid>


                    <Grid ColumnDefinitions="Auto, *, Auto" VerticalOptions="Center">


                        <HorizontalStackLayout Grid.Column="0" Grid.ColumnSpan="2" Spacing="15" VerticalOptions="Center">
                            <HorizontalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                            </HorizontalStackLayout.GestureRecognizers>
                            <Image Source="arrow_left_icon.png" WidthRequest="20" HeightRequest="20" VerticalOptions="Center"/>
                            <Label Text="Powrót" TextColor="{StaticResource TextSubtle}" FontSize="16" VerticalOptions="Center" FontAttributes="Bold" IsVisible="{OnIdiom Phone=False, Default=True}"/>
                            <BoxView WidthRequest="1" HeightRequest="20" Color="{StaticResource Border}" VerticalOptions="Center" Margin="10,0"/>
                            <Label Text="{Binding RoleSubtitle}" TextColor="{StaticResource TextMain}" FontSize="{OnIdiom Phone=16, Default=24}" FontAttributes="Bold" VerticalOptions="Center" MaxLines="1" LineBreakMode="TailTruncation"/>
                        </HorizontalStackLayout>


                        <HorizontalStackLayout Grid.Column="2" Spacing="{OnIdiom Phone=10, Default=20}" VerticalOptions="Center" IsVisible="{Binding IsNotArchived}">
                            <HorizontalStackLayout Spacing="6" IsVisible="{Binding IsAdminOrFounder}">
                                <HorizontalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ShowEditGroupPopupCommand}" />
                                </HorizontalStackLayout.GestureRecognizers>
                                <Image Source="edit_icon.png" WidthRequest="24" HeightRequest="24" VerticalOptions="Center"/>
                                <VerticalStackLayout VerticalOptions="Center" IsVisible="{OnIdiom Phone=False, Default=True}">
                                    <Label Text="Edytuj" TextColor="{StaticResource TextMain}" FontSize="10" FontAttributes="Bold"/>
                                    <Label Text="grupę" TextColor="{StaticResource TextMain}" FontSize="10" FontAttributes="Bold"/>
                                </VerticalStackLayout>
                            </HorizontalStackLayout>

                            <HorizontalStackLayout Spacing="6" IsVisible="{Binding IsAdminOrFounder}">
                                <HorizontalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ShowManageMembersPopupCommand}" />
                                </HorizontalStackLayout.GestureRecognizers>
                                <Image Source="add_friend_to_group_icon.png" WidthRequest="24" HeightRequest="24" VerticalOptions="Center"/>
                                <VerticalStackLayout VerticalOptions="Center" IsVisible="{OnIdiom Phone=False, Default=True}">
                                    <Label Text="Zarządzaj" TextColor="{StaticResource TextMain}" FontSize="10" FontAttributes="Bold"/>
                                    <Label Text="członkami" TextColor="{StaticResource TextMain}" FontSize="10" FontAttributes="Bold"/>
                                </VerticalStackLayout>
                            </HorizontalStackLayout>

                            <HorizontalStackLayout Spacing="6">
                                <HorizontalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding LeaveGroupCommand}" />
                                </HorizontalStackLayout.GestureRecognizers>
                                <Image Source="leave_icon.png" WidthRequest="24" HeightRequest="24" VerticalOptions="Center"/>
                                <VerticalStackLayout VerticalOptions="Center" IsVisible="{OnIdiom Phone=False, Default=True}">
                                    <Label Text="Opuść" TextColor="{StaticResource StatusRed}" FontSize="10" FontAttributes="Bold"/>
                                    <Label Text="grupę" TextColor="{StaticResource StatusRed}" FontSize="10" FontAttributes="Bold"/>
                                </VerticalStackLayout>
                            </HorizontalStackLayout>

                            <HorizontalStackLayout Spacing="6" IsVisible="{Binding IsAdminOrFounder}">
                                <HorizontalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding DeleteGroupCommand}" />
                                </HorizontalStackLayout.GestureRecognizers>
                                <Image Source="delete_icon.png" WidthRequest="24" HeightRequest="24" VerticalOptions="Center"/>
                                <VerticalStackLayout VerticalOptions="Center" IsVisible="{OnIdiom Phone=False, Default=True}">
                                    <Label Text="Usuń" TextColor="{StaticResource StatusRed}" FontSize="10" FontAttributes="Bold"/>
                                    <Label Text="grupę" TextColor="{StaticResource StatusRed}" FontSize="10" FontAttributes="Bold"/>
                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                        </HorizontalStackLayout>
                    </Grid>




                    <Border StrokeShape="RoundRectangle 24" BackgroundColor="{StaticResource SurfaceDark}"
                            Padding="0" StrokeThickness="0">
                        <VerticalStackLayout Spacing="0">


                            <Grid Padding="{OnIdiom Phone='15,20', Default='30,24'}" ColumnDefinitions="{OnIdiom Phone='*', Default='*, Auto'}" RowDefinitions="{OnIdiom Phone='Auto, Auto', Default='*'}" ColumnSpacing="20" RowSpacing="15">
                                <Label Grid.Row="0" Grid.Column="0" Text="{Binding GroupName}"
                                       FontSize="{OnIdiom Phone=32, Default=46}" FontAttributes="Bold"
                                       TextColor="White" LineBreakMode="TailTruncation"
                                       VerticalOptions="Center" HorizontalOptions="Start"/>

                                <Border Grid.Row="{OnIdiom Phone=1, Default=0}" Grid.Column="{OnIdiom Phone=0, Default=1}"
                                        StrokeShape="RoundRectangle 20"
                                        BackgroundColor="#0A000000"
                                        StrokeThickness="1" Stroke="#33ffffff"
                                        WidthRequest="{OnIdiom Phone=330, Default=280}" HeightRequest="44"
                                        Padding="15,0" VerticalOptions="Center">
                                    <SearchBar Placeholder="Wpisz szukaną osobę..."
                                               Text="{Binding MemberSearchText}"
                                               TextColor="White"
                                               PlaceholderColor="#888"
                                               BackgroundColor="Transparent"
                                               CancelButtonColor="{StaticResource TextSubtle}"
                                               Margin="-10,0,0,0"/>
                                </Border>
                            </Grid>

                                             <!-- Instagram-style Avatars Row (Members) -->
                            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Margin="0,10,0,20">
                                <HorizontalStackLayout BindableLayout.ItemsSource="{Binding FilteredMembers}" Spacing="15" Padding="20,0">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="dto:GroupMemberBalanceDto">
                                            <VerticalStackLayout Spacing="8" HorizontalOptions="Center" WidthRequest="70">
                                                <VerticalStackLayout.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:GroupDetailsViewModel}}, Path=ShowMemberDetailsCommand}" CommandParameter="{Binding .}" />
                                                </VerticalStackLayout.GestureRecognizers>

                                                <Grid HorizontalOptions="Center" HeightRequest="64" WidthRequest="64">
                                                    <Border HeightRequest="64" WidthRequest="64"
                                                        StrokeShape="RoundRectangle 32" StrokeThickness="2"
                                                        Stroke="#7F00FF"
                                                        BackgroundColor="#1E232D">
                                                        <Grid>
                                                            <Image Source="default_user_avatar.png" Aspect="AspectFill" IsVisible="{Binding AvatarUrl, Converter={StaticResource InverseStringNullOrEmptyConverter}}" />
                                                            <Image Source="{Binding AvatarUrl}" Aspect="AspectFill" />
                                                        </Grid>
                                                    </Border>

                                                    <Border HeightRequest="16" WidthRequest="16"
                                                        StrokeShape="RoundRectangle 8"
                                                        BackgroundColor="{StaticResource StatusGreen}"
                                                        Stroke="#1E232D" StrokeThickness="2"
                                                        HorizontalOptions="End" VerticalOptions="End"
                                                        TranslationX="-2" TranslationY="-2"
                                                        IsVisible="{Binding IsOnline}" />
                                                </Grid>
                                                <Label Text="{Binding FullName}"
                                                       FontSize="11" TextColor="White"
                                                       HorizontalOptions="Center" HorizontalTextAlignment="Center"
                                                       LineBreakMode="TailTruncation" MaxLines="1" />
                                            </VerticalStackLayout>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </HorizontalStackLayout>
                            </ScrollView>
                        </VerticalStackLayout>
                    </Border>


                    <Border StrokeShape="RoundRectangle 28" BackgroundColor="#7F00FF" Padding="0"
                            StrokeThickness="0" HeightRequest="56" WidthRequest="400" HorizontalOptions="Center" Margin="0,10"
                            IsVisible="{Binding IsNotArchived}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding AddExpenseCommand}"/>
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="10" VerticalOptions="Center">
                            <Image Source="plus_icon.png" WidthRequest="18" HeightRequest="18" VerticalOptions="Center" />
                            <Label Text="Dodaj nowe wydatki" TextColor="White" FontAttributes="Bold" FontSize="18" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Border>




                    <Border StrokeShape="RoundRectangle 24" BackgroundColor="{StaticResource SurfaceDark}"
                            Padding="0" StrokeThickness="0" Margin="0,0,0,40">
                        <VerticalStackLayout Spacing="0">


                            <VerticalStackLayout Padding="30,24" Spacing="16">
                                <Label Text="Lista Transakcji"
                                       FontSize="28" FontAttributes="Bold"
                                       TextColor="White"
                                       HorizontalOptions="Center"/>
                                <Grid ColumnDefinitions="Auto, *" ColumnSpacing="15">
                                    <Border Grid.Column="0" BackgroundColor="#15FFFFFF" StrokeThickness="0" StrokeShape="RoundRectangle 20" HeightRequest="44">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ToggleTransactionViewCommand}" />
                                        </Border.GestureRecognizers>
                                        <Label Text="Zmień widok" TextColor="White" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="Center" Padding="20,0"/>
                                    </Border>

                                    <Border Grid.Column="1"
                                            StrokeShape="RoundRectangle 20"
                                            BackgroundColor="#0A000000"
                                            StrokeThickness="1" Stroke="#33ffffff"
                                            HeightRequest="44" Padding="15,0">
                                        <SearchBar Placeholder="Wpisz szukaną transakcję..."
                                                   Text="{Binding TransactionSearchText}"
                                                   TextColor="White"
                                                   PlaceholderColor="#888"
                                                   BackgroundColor="Transparent"
                                                   CancelButtonColor="{StaticResource TextSubtle}"
                                                   Margin="-10,0,0,0"/>
                                    </Border>
                                </Grid>
                            </VerticalStackLayout>


                            <BoxView HeightRequest="1" Color="#11FFFFFF" Margin="30,0" />


                            <!-- WERSJA DLA TELEFONÓW (SZYBKA, BEZ FLEXLAYOUT I BEZ COLLECTIONVIEW KTÓRE WYWALA BŁĘDY NA DESKTOPIE) -->
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding TransactionSections}" Spacing="15" Margin="30,15,30,30" IsVisible="{OnIdiom Phone=True, Default=False}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TransactionGroup">
                                        <VerticalStackLayout Spacing="10">
                                            <Label Text="{Binding DateHeader}"
                                                   FontSize="20" FontAttributes="Bold"
                                                   TextColor="{StaticResource TextSubtle}"
                                                   HorizontalOptions="Center" Margin="0,5,0,5"/>

                                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding}" Spacing="15">
                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate x:DataType="dto:ExpenseSummaryDto">
                                                        <Border StrokeShape="RoundRectangle 16" BackgroundColor="#15FFFFFF" StrokeThickness="1" Stroke="#11FFFFFF" Padding="16,12">
                                                            <Border.GestureRecognizers>
                                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:GroupDetailsViewModel}}, Path=ShowExpenseDetailsCommand}" CommandParameter="{Binding .}"/>
                                                            </Border.GestureRecognizers>
                                                            <Grid ColumnDefinitions="Auto, *, *" ColumnSpacing="10">
                                                                <Label Grid.Column="0" Text="{Binding TotalAmount, StringFormat='{0:N2} zł'}" FontSize="15" FontAttributes="Bold" TextColor="White" VerticalOptions="Center"/>
                                                                <Label Grid.Column="1" Text="{Binding PayerName}" FontSize="13" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" HorizontalTextAlignment="Center"/>
                                                                <Label Grid.Column="2" Text="{Binding Title}" FontSize="12" TextColor="{StaticResource TextSubtle}" HorizontalOptions="End" VerticalOptions="Center" HorizontalTextAlignment="End" LineBreakMode="TailTruncation"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                            </VerticalStackLayout>
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                            <!-- WERSJA DLA DESKTOPU (ORYGINALNA Z FLEXLAYOUT) -->
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding TransactionSections}" Margin="0,15,0,30" IsVisible="{OnIdiom Phone=False, Default=True}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TransactionGroup">
                                        <VerticalStackLayout Spacing="15" Padding="30,10,30,20">
                                            <Label Text="{Binding DateHeader}"
                                                   FontSize="20" FontAttributes="Bold"
                                                   TextColor="{StaticResource TextSubtle}"
                                                   HorizontalOptions="Center" Margin="0,5"/>

                                            <FlexLayout BindableLayout.ItemsSource="{Binding}" Wrap="Wrap" JustifyContent="Start">
                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate x:DataType="dto:ExpenseSummaryDto">
                                                        <Border FlexLayout.Basis="31%" StrokeShape="RoundRectangle 16" BackgroundColor="#15FFFFFF" StrokeThickness="1" Stroke="#11FFFFFF" Padding="16,12" Margin="0,0,15,15">
                                                            <Border.GestureRecognizers>
                                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:GroupDetailsViewModel}}, Path=ShowExpenseDetailsCommand}" CommandParameter="{Binding .}"/>
                                                            </Border.GestureRecognizers>
                                                            <Grid ColumnDefinitions="Auto, *, *" ColumnSpacing="10">
                                                                <Label Grid.Column="0" Text="{Binding TotalAmount, StringFormat='{0:N2} zł'}" FontSize="15" FontAttributes="Bold" TextColor="White" VerticalOptions="Center"/>
                                                                <Label Grid.Column="1" Text="{Binding PayerName}" FontSize="13" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" HorizontalTextAlignment="Center"/>
                                                                <Label Grid.Column="2" Text="{Binding Title}" FontSize="12" TextColor="{StaticResource TextSubtle}" HorizontalOptions="End" VerticalOptions="Center" HorizontalTextAlignment="End" LineBreakMode="TailTruncation"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                            </FlexLayout>
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>



                </VerticalStackLayout>
            </ScrollView>
        </Grid>


        <Grid Grid.ColumnSpan="2" IsVisible="{Binding IsMenuVisible}"
              BackgroundColor="#CC121212" ZIndex="100">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding ToggleMenuCommand}" />
            </Grid.GestureRecognizers>
            <controls:SidebarMenu HorizontalOptions="Start" ActiveTab="Groups" WidthRequest="300"/>
        </Grid>


        <Grid Grid.ColumnSpan="2" IsVisible="{Binding IsBusy}"
              BackgroundColor="#CC121212" ZIndex="450">
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="16">
                <ActivityIndicator IsRunning="{Binding IsBusy}" Color="#7C3AED"
                                   WidthRequest="56" HeightRequest="56" />
                <Label Text="Wczytywanie grupy…" TextColor="White"
                       FontAttributes="Bold" FontSize="15" HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>

        <!-- EDIT GROUP POPUP -->
        <Grid Grid.ColumnSpan="2" IsVisible="{Binding IsEditGroupPopupVisible}" Style="{StaticResource PopupOverlayStyle}">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CancelEditGroupPopupCommand}" />
            </Grid.GestureRecognizers>
            <Border StrokeShape="RoundRectangle 10" Style="{StaticResource PopupContainerStyle}" WidthRequest="350">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="20">
                    <Label Text="Edytuj grupę" FontSize="22" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center"/>

                    <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                        <Border StrokeShape="RoundRectangle 10" Stroke="#7F00FF" StrokeThickness="2" HeightRequest="120" WidthRequest="120" HorizontalOptions="Center">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding PickEditAvatarPhotoCommand}" />
                            </Border.GestureRecognizers>
                            <Border.StrokeShape>
                                <RoundRectangle />
                            </Border.StrokeShape>
                            <Grid>
                                <BoxView Color="#2B2B3D" />
                                <Image Source="camera_icon.png" WidthRequest="40" HeightRequest="40" HorizontalOptions="Center" VerticalOptions="Center" />
                                <Image Source="{Binding SelectedEditAvatarSource}" Aspect="AspectFill" />
                            </Grid>
                        </Border>
                        <Label Text="Kliknij, aby zmienić zdjęcie" TextColor="#7F00FF" FontSize="12" HorizontalOptions="Center" />
                    </VerticalStackLayout>

                    <Entry Placeholder="Nazwa grupy" Text="{Binding NewGroupName}" PlaceholderColor="#888" TextColor="White" BackgroundColor="#2A303C" />

                    <Grid ColumnDefinitions="*, *" ColumnSpacing="15" Margin="0,10,0,0">
                        <controls:AppButton Grid.Column="0" Text="Anuluj" Command="{Binding CancelEditGroupPopupCommand}" ButtonBackgroundColor="{StaticResource SurfaceDark}" ButtonTextColor="{StaticResource TextMain}" />
                        <controls:AppButton Grid.Column="1" Text="Zapisz" Command="{Binding ConfirmEditGroupCommand}" ButtonBackgroundColor="{StaticResource StatusGreen}" ButtonTextColor="{StaticResource TextMain}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- MANAGE MEMBERS POPUP -->
        <Grid Grid.ColumnSpan="2" IsVisible="{Binding IsManageMembersPopupVisible}" Style="{StaticResource PopupOverlayStyle}">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CancelManageMembersPopupCommand}" />
            </Grid.GestureRecognizers>
            <Border StrokeShape="RoundRectangle 10" Style="{StaticResource PopupContainerStyle}" WidthRequest="400" MaximumHeightRequest="600">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer />
                </Border.GestureRecognizers>

                <ScrollView>
                    <VerticalStackLayout Spacing="25">
                        <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                            <Label Grid.Column="0" Text="Zarządzaj członkami" FontSize="22" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center"/>

                            <Grid Grid.Column="1" VerticalOptions="Center" Margin="0,10,10,0" IsVisible="{Binding PendingInvitationsCount, Converter={StaticResource IntToBoolConverter}}">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ShowPendingInvitationsCommand}" />
                                </Grid.GestureRecognizers>

                                <!-- PUDEŁKO / TŁO IKONY -->
                                <Border BackgroundColor="#2A303C" StrokeThickness="0" StrokeShape="RoundRectangle 10" WidthRequest="45" HeightRequest="45" VerticalOptions="Center">
                                    <Image Source="notifications_icon.png" WidthRequest="26" HeightRequest="26" HorizontalOptions="Center" VerticalOptions="Center" Aspect="AspectFit"/>
                                </Border>

                                <!-- CZERWONY ZNACZEK (BADGE) -->
                                <Border BackgroundColor="{StaticResource StatusRed}" StrokeThickness="0"
                                        WidthRequest="20" HeightRequest="20" StrokeShape="RoundRectangle 10"
                                        HorizontalOptions="End" VerticalOptions="Start"
                                        Margin="0,-5,-5,0"
                                        IsVisible="{Binding PendingInvitationsCount, Converter={StaticResource IntToBoolConverter}}">
                                    <Label Text="{Binding PendingInvitationsCount}" TextColor="White" FontSize="10" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                            </Grid>
                        </Grid>

                        <!-- SEKCJA: Szybkie zapraszanie znajomych -->
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Szybko zaproś znajomych" FontSize="14" TextColor="{StaticResource TextSubtle}" FontAttributes="Bold"/>

                            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Default">
                                <HorizontalStackLayout BindableLayout.ItemsSource="{Binding FriendsList}" Spacing="15" Padding="0,0,0,15">
                                    <BindableLayout.EmptyView>
                                        <Label Text="Brak znajomych do zaproszenia" TextColor="#666" FontSize="12" FontAttributes="Italic" Padding="10,0"/>
                                    </BindableLayout.EmptyView>
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="dto:FriendListResponse">
                                            <VerticalStackLayout Spacing="5" WidthRequest="70" HorizontalOptions="Center">
                                                <VerticalStackLayout.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding BindingContext.InviteFriendCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}" CommandParameter="{Binding .}"/>
                                                </VerticalStackLayout.GestureRecognizers>

                                                <Grid WidthRequest="60" HeightRequest="60">
                                                    <Border WidthRequest="60" HeightRequest="60" StrokeShape="RoundRectangle 30" StrokeThickness="2" Stroke="#333" BackgroundColor="#2A303C">
                                                        <Grid>
                                                            <Image Source="default_user_avatar.png" Aspect="AspectFill" IsVisible="{Binding AvatarUrl, Converter={StaticResource InverseStringNullOrEmptyConverter}}" />
                                                            <Image Source="{Binding AvatarUrl}" Aspect="AspectFill"/>
                                                        </Grid>
                                                    </Border>
                                                    <!-- Ikonka plusa -->
                                                    <Border StrokeShape="RoundRectangle 10" WidthRequest="20" HeightRequest="20" BackgroundColor="{StaticResource StatusGreen}" StrokeThickness="0"
                                                            HorizontalOptions="End" VerticalOptions="End" TranslationX="2" TranslationY="2">
                                                        <Image Source="plus_icon.png" WidthRequest="12" HeightRequest="12" HorizontalOptions="Center" VerticalOptions="Center"/>
                                                    </Border>
                                                </Grid>
                                                <Label Text="{Binding FullName}" FontSize="10" TextColor="#AAA" HorizontalOptions="Center" HorizontalTextAlignment="Center" MaxLines="2" LineBreakMode="TailTruncation"/>
                                            </VerticalStackLayout>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </HorizontalStackLayout>
                            </ScrollView>

                            <Label Text="LUB" TextColor="{StaticResource TextSubtle}" HorizontalOptions="Center" FontSize="12" FontAttributes="Bold" Margin="0,5"/>

                            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                                <Entry Grid.Column="0" Placeholder="Wpisz email lub nick..." Text="{Binding InviteSearchText}" PlaceholderColor="#888" TextColor="White" BackgroundColor="#2A303C" HeightRequest="40" VerticalOptions="Center"/>
                                <controls:AppButton Grid.Column="1" Text="Zaproś" Command="{Binding InviteUserBySearchCommand}" ButtonBackgroundColor="{StaticResource StatusGreen}" ButtonTextColor="{StaticResource TextMain}" ButtonHeight="40" ButtonPadding="15,0" VerticalOptions="Center"/>
                            </Grid>
                        </VerticalStackLayout>

                        <BoxView HeightRequest="1" Color="#333" Margin="0,5"/>

                        <!-- SEKCJA: Lista obecnych członków -->
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Obecni członkowie grupy" FontSize="14" TextColor="{StaticResource TextSubtle}" FontAttributes="Bold"/>

                            <Border StrokeShape="RoundRectangle 8" BackgroundColor="#2A303C" StrokeThickness="0" Padding="10,0" HeightRequest="40">
                                <Grid ColumnDefinitions="Auto, *">
                                    <Image Grid.Column="0" Source="search_icon.png" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" Margin="0,0,10,0" Opacity="0.5"/>
                                    <Entry Grid.Column="1" Placeholder="Szukaj członka..." Text="{Binding PopupMembersSearchText}" TextColor="White" PlaceholderColor="#888" BackgroundColor="Transparent" VerticalOptions="Center" />
                                </Grid>
                            </Border>

                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding FilteredActiveMembersList}" Spacing="10" Padding="0,0,15,0">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="dto:GroupMemberResponse">
                                        <Border StrokeShape="RoundRectangle 12" BackgroundColor="#2A303C" StrokeThickness="0" Padding="10">
                                            <Grid ColumnDefinitions="Auto, *, Auto, Auto" ColumnSpacing="10">
                                                <Border Grid.Column="0" WidthRequest="40" HeightRequest="40" StrokeShape="RoundRectangle 20" StrokeThickness="0" VerticalOptions="Center" BackgroundColor="#1E232D">
                                                    <Grid>
                                                        <Image Source="default_user_avatar.png" Aspect="AspectFill" IsVisible="{Binding AvatarUrl, Converter={StaticResource InverseStringNullOrEmptyConverter}}" />
                                                        <Image Source="{Binding AvatarUrl}" Aspect="AspectFill"/>
                                                    </Grid>
                                                </Border>

                                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                                    <Label Text="{Binding FullName}" FontSize="14" FontAttributes="Bold" TextColor="White" LineBreakMode="TailTruncation"/>
                                                    <Label Text="{Binding Role}" FontSize="10" TextColor="{StaticResource StatusGreen}" FontAttributes="Bold"/>
                                                </VerticalStackLayout>

                                                <!-- Zmiana Roli -->
                                                <ImageButton Grid.Column="2" Source="star_icon_fav.png" BackgroundColor="Transparent" Padding="5,5" WidthRequest="35" HeightRequest="35"
                                                        Command="{Binding BindingContext.ChangeMemberRoleCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                                        CommandParameter="{Binding .}"
                                                        ToolTipProperties.Text="Zmień rolę"
                                                        IsVisible="{Binding BindingContext.IsAdminOrFounder, Source={RelativeSource AncestorType={x:Type ContentPage}}}"/>

                                                <!-- Usunięcie -->
                                                <ImageButton Grid.Column="3" Source="delete_icon.png" BackgroundColor="Transparent" Padding="5,5" WidthRequest="35" HeightRequest="35"
                                                        Command="{Binding BindingContext.KickMemberCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                                        CommandParameter="{Binding .}"
                                                        ToolTipProperties.Text="Usuń z grupy"
                                                        IsVisible="{Binding BindingContext.IsAdminOrFounder, Source={RelativeSource AncestorType={x:Type ContentPage}}}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>

                        <controls:AppButton Text="Zamknij" Command="{Binding CancelManageMembersPopupCommand}" ButtonBackgroundColor="{StaticResource SurfaceDark}" ButtonTextColor="{StaticResource TextMain}" Margin="0,10,0,0"/>
                    </VerticalStackLayout>
                </ScrollView>
            </Border>
        </Grid>

        <!-- EXPENSE DETAILS POPUP -->
        <Grid Grid.ColumnSpan="2" IsVisible="{Binding IsExpenseDetailsPopupVisible}" Style="{StaticResource PopupOverlayStyle}" ZIndex="300">
            <Border StrokeShape="RoundRectangle 10" Style="{StaticResource PopupContainerStyle}" MaximumWidthRequest="450" HorizontalOptions="Center" VerticalOptions="Center">
                <VerticalStackLayout Spacing="20">
                    <Label Text="Szczegóły transakcji" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource TextMain}" HorizontalOptions="Center"/>

                    <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto, Auto" RowSpacing="15" ColumnSpacing="15">

                        <!-- Nazwa & Kategoria -->
                        <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="4">
                            <Label Text="Nazwa" TextColor="{StaticResource TextSubtle}" FontSize="12"/>
                            <Label Text="{Binding SelectedExpenseDetails.Title}" TextColor="{StaticResource TextMain}" FontSize="15" FontAttributes="Bold"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="4">
                            <Label Text="Kategoria" TextColor="{StaticResource TextSubtle}" FontSize="12"/>
                            <Label Text="{Binding SelectedExpenseDetails.Category}" TextColor="{StaticResource TextMain}" FontSize="15" FontAttributes="Bold"/>
                        </VerticalStackLayout>

                        <!-- Data & Kwota -->
                        <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="4">
                            <Label Text="Data zakupu" TextColor="{StaticResource TextSubtle}" FontSize="12"/>
                            <Label Text="{Binding SelectedExpenseDetails.Date, StringFormat='{0:dd.MM.yyyy}'}" TextColor="{StaticResource TextMain}" FontSize="15" FontAttributes="Bold"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="4">
                            <Label Text="Łączna kwota" TextColor="{StaticResource TextSubtle}" FontSize="12"/>
                            <Label Text="{Binding SelectedExpenseDetails.TotalAmount, StringFormat='{0:N2} zł'}" TextColor="{StaticResource PrimaryViolet}" FontSize="15" FontAttributes="Bold"/>
                        </VerticalStackLayout>

                        <!-- Płatnik (Cała szerokość) -->
                        <VerticalStackLayout Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Spacing="8">
                            <BoxView HeightRequest="1" Color="{StaticResource Border}" Margin="0,5"/>
                            <Label Text="Opłacił(a)" TextColor="{StaticResource TextSubtle}" FontSize="12"/>
                            <Grid ColumnDefinitions="Auto, *, Auto, Auto" ColumnSpacing="10">
                                <Border Grid.Column="0" WidthRequest="36" HeightRequest="36" StrokeShape="RoundRectangle 18" StrokeThickness="0" VerticalOptions="Center">
                                    <Grid>
                                        <Image Source="default_user_avatar.png" Aspect="AspectFill" IsVisible="{Binding SelectedExpenseDetails.PayerAvatarUrl, Converter={StaticResource InverseStringNullOrEmptyConverter}}" />
                                        <Image Source="{Binding SelectedExpenseDetails.PayerAvatarUrl}" Aspect="AspectFill" />
                                    </Grid>
                                </Border>

                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="{Binding SelectedExpenseDetails.PayerName}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextMain}"/>
                                    <Label Text="{Binding SelectedExpenseDetails.PayerPhoneNumber}" FontSize="12" TextColor="{StaticResource TextSubtle}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding SelectedExpenseDetails.PayerPhoneNumber}" Value="{x:Null}">
                                                <Setter Property="IsVisible" Value="False"/>
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding SelectedExpenseDetails.PayerPhoneNumber}" Value="">
                                                <Setter Property="IsVisible" Value="False"/>
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </VerticalStackLayout>

                                <!-- Phone Copy Button -->
                                <Grid Grid.Column="2" VerticalOptions="Center" WidthRequest="28" HeightRequest="28" BackgroundColor="Transparent" ToolTipProperties.Text="Kopiuj numer telefonu">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="IsVisible" Value="True"/>
                                            <Style.Triggers>
                                                <DataTrigger TargetType="Grid" Binding="{Binding SelectedExpenseDetails.PayerPhoneNumber}" Value="{x:Null}">
                                                    <Setter Property="IsVisible" Value="False"/>
                                                </DataTrigger>
                                                <DataTrigger TargetType="Grid" Binding="{Binding SelectedExpenseDetails.PayerPhoneNumber}" Value="">
                                                    <Setter Property="IsVisible" Value="False"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding BindingContext.CopyToClipboardCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}" CommandParameter="{Binding SelectedExpenseDetails.PayerPhoneNumber}"/>
                                    </Grid.GestureRecognizers>
                                    <!-- Phone icon -->
                                    <Path Data="M6.62,10.79C8.06,13.62 10.38,15.94 13.21,17.38L15.41,15.18C15.69,14.9 16.08,14.82 16.43,14.93C17.55,15.3 18.75,15.5 20,15.5C20.55,15.5 21,15.95 21,16.5V20C21,20.55 20.55,21 20,21C10.06,21 2,12.94 2,3C2,2.45 2.45,2 3,2H6.5C7.05,2 7.5,2.45 7.5,3C7.5,4.25 7.7,5.45 8.07,6.57C8.18,6.92 8.1,7.31 7.82,7.59L6.62,10.79Z" Fill="{StaticResource TextSubtle}" Aspect="Uniform" WidthRequest="18" HeightRequest="18" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Grid>

                                <!-- IBAN Copy Button -->
                                <Grid Grid.Column="3" VerticalOptions="Center" WidthRequest="28" HeightRequest="28" BackgroundColor="Transparent" ToolTipProperties.Text="Kopiuj numer konta">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="IsVisible" Value="True"/>
                                            <Style.Triggers>
                                                <DataTrigger TargetType="Grid" Binding="{Binding SelectedExpenseDetails.PayerIBAN}" Value="{x:Null}">
                                                    <Setter Property="IsVisible" Value="False"/>
                                                </DataTrigger>
                                                <DataTrigger TargetType="Grid" Binding="{Binding SelectedExpenseDetails.PayerIBAN}" Value="">
                                                    <Setter Property="IsVisible" Value="False"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding BindingContext.CopyToClipboardCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}" CommandParameter="{Binding SelectedExpenseDetails.PayerIBAN}"/>
                                    </Grid.GestureRecognizers>
                                    <!-- Bank account / Credit card icon -->
                                    <Path Data="M20 4H4C2.89 4 2.01 4.89 2.01 6L2 18C2 19.11 2.89 20 4 20H20C21.11 20 22 19.11 22 18V6C22 4.89 21.11 4 20 4M20 18H4V12H20V18M20 8H4V6H20V8Z" Fill="{StaticResource TextSubtle}" Aspect="Uniform" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Grid>
                            </Grid>
                        </VerticalStackLayout>
                    </Grid>

                    <BoxView HeightRequest="1" Color="{StaticResource Border}" Margin="0,5"/>

                    <Label Text="Podział kosztów" FontSize="14" TextColor="{StaticResource TextSubtle}" Margin="0,0,0,-5"/>

                    <ScrollView MaximumHeightRequest="180">
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding SelectedExpenseDetails.Participants}" Spacing="10" Padding="0,0,15,0">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="dto:ExpenseParticipantDto">
                                    <Grid ColumnDefinitions="Auto, *, Auto, Auto" ColumnSpacing="12" Padding="0,5,5,5">
                                        <Border Grid.Column="0" WidthRequest="32" HeightRequest="32" StrokeShape="RoundRectangle 16" StrokeThickness="0" VerticalOptions="Center">
                                            <Grid>
                                                <Image Source="default_user_avatar.png" Aspect="AspectFill" IsVisible="{Binding AvatarUrl, Converter={StaticResource InverseStringNullOrEmptyConverter}}" />
                                                <Image Source="{Binding AvatarUrl}" Aspect="AspectFill" />
                                            </Grid>
                                        </Border>
                                        <Label Grid.Column="1" Text="{Binding FullName}" FontSize="14" TextColor="{StaticResource TextMain}" VerticalOptions="Center" LineBreakMode="TailTruncation"/>
                                        <Label Grid.Column="2" Text="{Binding OwedAmount, StringFormat='{0:N2} zł'}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextMain}" VerticalOptions="Center" HorizontalOptions="End"/>
                                        <Grid Grid.Column="3" VerticalOptions="Center" WidthRequest="28" HeightRequest="28" BackgroundColor="Transparent" ToolTipProperties.Text="Kopiuj kwotę">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding BindingContext.CopyToClipboardCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}" CommandParameter="{Binding OwedAmount, StringFormat='{0:N2}'}"/>
                                            </Grid.GestureRecognizers>
                                            <Path Data="M19,21H8V7H19M19,5H8C6.9,5 6,5.9 6,7V21C6,22.1 6.9,23 8,23H19C20.1,23 21,22.1 21,21V7C21,5.9 20.1,5 19,5M16,1H4C2.9,1 2,1.9 2,3V17H4V3H16V1Z" Fill="{StaticResource TextSubtle}" Aspect="Uniform" WidthRequest="16" HeightRequest="16" HorizontalOptions="Center" VerticalOptions="Center"/>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </ScrollView>

                    <controls:AppButton Text="Wyświetl zdjęcia" Command="{Binding ShowExpensePhotosCommand}" ButtonBackgroundColor="{StaticResource SurfaceDark}" ButtonTextColor="{StaticResource TextMain}" Margin="0,10,0,0" IsVisible="{Binding HasExpensePhotos}"/>

                    <controls:AppButton Text="Edytuj" Command="{Binding ShowEditExpensePopupCommand}" ButtonBackgroundColor="{StaticResource SurfaceDark}" ButtonTextColor="{StaticResource TextMain}" Margin="0,10,0,0">
                        <controls:AppButton.IsVisible>
                            <MultiBinding Converter="{StaticResource AllTrueConverter}">
                                <Binding Path="IsAdminOrFounder" />
                                <Binding Path="IsNotArchived" />
                            </MultiBinding>
                        </controls:AppButton.IsVisible>
                    </controls:AppButton>

                    <Border HeightRequest="48" StrokeShape="RoundRectangle 12" BackgroundColor="{StaticResource SurfaceDark}" StrokeThickness="0" Margin="0,5,0,0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CloseExpenseDetailsPopupCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="Zamknij" TextColor="{StaticResource TextMain}" HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold" />
                    </Border>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- PHOTO VIEWER POPUP -->
        <Grid Grid.ColumnSpan="2" IsVisible="{Binding IsPhotoViewerVisible}" Style="{StaticResource PopupOverlayStyle}" ZIndex="500">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding ClosePhotoViewerCommand}" />
            </Grid.GestureRecognizers>
            <Border StrokeShape="RoundRectangle 10" Style="{StaticResource PopupContainerStyle}" MaximumWidthRequest="1200" MaximumHeightRequest="900" HorizontalOptions="Center" VerticalOptions="Center">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer />
                </Border.GestureRecognizers>
                <Grid RowDefinitions="Auto, *, Auto, Auto" RowSpacing="10" Padding="15">
                    <!-- Title -->
                    <Label Grid.Row="0" Text="{Binding PhotoViewerTitle}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource TextMain}" HorizontalOptions="Center"/>

                    <!-- Main Image -->
                    <Grid Grid.Row="1" MinimumHeightRequest="500">
                        <Image Source="{Binding SelectedExpensePhotoUrl}" Aspect="AspectFit">
                            <Image.GestureRecognizers>
                                <SwipeGestureRecognizer Direction="Left" Command="{Binding PhotoSwipeLeftCommand}" />
                                <SwipeGestureRecognizer Direction="Right" Command="{Binding PhotoSwipeRightCommand}" />
                            </Image.GestureRecognizers>
                        </Image>
                    </Grid>

                    <!-- Thumbnails -->
                    <CollectionView Grid.Row="2" ItemsSource="{Binding ExpensePhotosToView}"
                                    HeightRequest="60" HorizontalOptions="Center" Margin="0,5">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Border WidthRequest="50" HeightRequest="50" StrokeShape="RoundRectangle 8" StrokeThickness="2" Stroke="Transparent" BackgroundColor="#1E232D" Opacity="0.5">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding BindingContext.SelectPhotoThumbnailCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}" CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Image Source="{Binding .}" Aspect="AspectFill" />
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- Close Button -->
                    <Border Grid.Row="3" HeightRequest="48" StrokeShape="RoundRectangle 12" BackgroundColor="{StaticResource SurfaceDark}" StrokeThickness="0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ClosePhotoViewerCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="Zamknij" TextColor="{StaticResource TextMain}" HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold" />
                    </Border>
                </Grid>
            </Border>
        </Grid>


        <Grid Grid.ColumnSpan="2" IsVisible="{Binding IsEditExpensePopupVisible}" Style="{StaticResource PopupOverlayStyle}" ZIndex="400">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CancelEditExpensePopupCommand}" />
            </Grid.GestureRecognizers>
            <Border StrokeShape="RoundRectangle 10" Style="{StaticResource PopupContainerStyle}" WidthRequest="380" MaximumHeightRequest="600">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer />
                </Border.GestureRecognizers>

                <Grid RowDefinitions="Auto, *, Auto" RowSpacing="20">
                    <VerticalStackLayout Grid.Row="0" Spacing="15">
                        <Label Text="Edytuj Wydatek" FontSize="22" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center"/>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="15">
                            <VerticalStackLayout Grid.Column="0" Spacing="8">
                                <Label Text="Nazwa" TextColor="{StaticResource TextSubtle}" FontSize="12"/>
                                <Entry Text="{Binding EditExpenseName}" PlaceholderColor="#888" TextColor="White" BackgroundColor="#2A303C" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="8">
                                <Label Text="Kategoria" TextColor="{StaticResource TextSubtle}" FontSize="12"/>
                                <Entry Text="{Binding EditExpenseCategory}" PlaceholderColor="#888" TextColor="White" BackgroundColor="#2A303C" />
                            </VerticalStackLayout>
                        </Grid>

                        <VerticalStackLayout Spacing="8">
                            <Label Text="Łączna kwota wydatku" TextColor="{StaticResource TextSubtle}" FontSize="12"/>
                            <Entry Text="{Binding EditExpenseTotalAmount, Mode=TwoWay}" Keyboard="Numeric" TextColor="White" BackgroundColor="#2A303C" />
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*,Auto" Margin="0,5,0,0">
                            <Label Grid.Column="0" Text="Podział" FontSize="16" FontAttributes="Bold" TextColor="White" VerticalOptions="Center"/>
                            <Label Grid.Column="1" Text="{Binding RemainingAmountToSplit, StringFormat='Pozostało: {0:N2} zł'}"
                                   FontSize="14" FontAttributes="Bold" VerticalOptions="Center" TextColor="{StaticResource StatusRed}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding RemainingAmountToSplit}" Value="0">
                                        <Setter Property="TextColor" Value="{StaticResource StatusGreen}"/>
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Grid>
                    </VerticalStackLayout>

                    <ScrollView Grid.Row="1">
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding EditExpenseSplits}" Spacing="10" Padding="0,0,15,0">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:EditableExpenseSplit">
                                    <Border BackgroundColor="#2A303C" Padding="10" HeightRequest="60" StrokeShape="RoundRectangle 10" Stroke="Transparent">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                            <Border Grid.Column="0" WidthRequest="36" HeightRequest="36" StrokeShape="RoundRectangle 18" StrokeThickness="0" VerticalOptions="Center">
                                                <Grid>
                                                    <Image Source="default_user_avatar.png" Aspect="AspectFill" IsVisible="{Binding AvatarUrl, Converter={StaticResource InverseStringNullOrEmptyConverter}}" />
                                                    <Image Source="{Binding AvatarUrl}" Aspect="AspectFill" />
                                                </Grid>
                                            </Border>
                                            <Label Grid.Column="1" Text="{Binding FullName}" TextColor="White" VerticalOptions="Center" FontSize="14" LineBreakMode="TailTruncation" />
                                            <Entry Grid.Column="2" Text="{Binding OwedAmount, Mode=TwoWay}" Keyboard="Numeric" WidthRequest="80" TextColor="White" HorizontalTextAlignment="End" VerticalOptions="Center" BackgroundColor="#1E232B" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </ScrollView>

                    <Grid Grid.Row="2" ColumnDefinitions="*, *, *" ColumnSpacing="15">
                        <controls:AppButton Grid.Column="0" Text="Anuluj" Command="{Binding CancelEditExpensePopupCommand}" ButtonBackgroundColor="{StaticResource SurfaceDark}" ButtonTextColor="{StaticResource TextMain}" />
                        <controls:AppButton Grid.Column="1" Text="Usuń" Command="{Binding DeleteExpenseCommand}" ButtonBackgroundColor="{StaticResource StatusRed}" ButtonTextColor="White" />
                        <controls:AppButton Grid.Column="2" Text="Zapisz" Command="{Binding ConfirmEditExpenseCommand}" ButtonBackgroundColor="{StaticResource StatusGreen}" ButtonTextColor="{StaticResource TextMain}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- CUSTOM ALERT POPUP -->
        <Grid IsVisible="{Binding IsCustomAlertVisible}" Style="{StaticResource PopupOverlayStyle}" ZIndex="500">
            <Border StrokeShape="RoundRectangle 10" Style="{StaticResource PopupContainerStyle}" MaximumWidthRequest="400">
                <VerticalStackLayout Spacing="15">
                    <Label Text="{Binding CustomAlertTitle}" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource TextMain}" HorizontalOptions="Center"/>
                    <Label Text="{Binding CustomAlertMessage}" FontSize="14" TextColor="{StaticResource TextSubtle}" LineBreakMode="WordWrap" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,15,0,0">
                        <controls:AppButton Grid.Column="0" Text="{Binding CustomAlertCancelText}" Command="{Binding CloseAlertCommand}" CommandParameter="False" ButtonBackgroundColor="{StaticResource SurfaceDark}" ButtonTextColor="{StaticResource TextMain}" IsVisible="{Binding IsCustomAlertCancelVisible}"/>
                        <controls:AppButton Grid.Column="{Binding AlertAcceptColumn}" Grid.ColumnSpan="{Binding AlertAcceptColumnSpan}" Text="{Binding CustomAlertAcceptText}" Command="{Binding CloseAlertCommand}" CommandParameter="True" ButtonBackgroundColor="{StaticResource PrimaryViolet}" ButtonTextColor="{StaticResource TextMain}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- ACTION SHEET POPUP -->
        <Grid IsVisible="{Binding IsActionSheetVisible}" Style="{StaticResource PopupOverlayStyle}" ZIndex="600">
            <Border StrokeShape="RoundRectangle 10" Style="{StaticResource PopupContainerStyle}" MaximumWidthRequest="400">
                <VerticalStackLayout Spacing="15">
                    <Label Text="{Binding ActionSheetTitle}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource TextMain}" HorizontalOptions="Center"/>

                    <CollectionView ItemsSource="{Binding ActionSheetOptions}" MaximumHeightRequest="250">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <ContentView Padding="0,0,0,10">
                                    <Border StrokeShape="RoundRectangle 10" BackgroundColor="#251E38" Stroke="Transparent" Padding="15">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:GroupDetailsViewModel}}, Path=SelectActionSheetOptionCommand}" CommandParameter="{Binding .}"/>
                                        </Border.GestureRecognizers>
                                        <Label Text="{Binding .}" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center"/>
                                    </Border>
                                </ContentView>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <controls:AppButton Text="Anuluj" Command="{Binding CancelActionSheetCommand}" ButtonBackgroundColor="{StaticResource SurfaceDark}" ButtonTextColor="{StaticResource TextMain}" Margin="0,10,0,0"/>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- MEMBER DETAILS POPUP -->
        <Grid Grid.ColumnSpan="2" IsVisible="{Binding IsMemberDetailsPopupVisible}" Style="{StaticResource PopupOverlayStyle}" ZIndex="500">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseMemberDetailsPopupCommand}" />
            </Grid.GestureRecognizers>
            <Border StrokeShape="RoundRectangle 10" Style="{StaticResource PopupContainerStyle}" WidthRequest="340" MaximumHeightRequest="600" BindingContext="{Binding SelectedMemberDetails}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="0" x:DataType="dto:GroupMemberBalanceDto">

                    <Grid Padding="0,0,0,15" ColumnDefinitions="Auto, *, Auto">
                        <Border Grid.Column="0" HeightRequest="40" WidthRequest="40"
                                StrokeShape="RoundRectangle 20" StrokeThickness="0"
                                BackgroundColor="#1E232D" Margin="0,0,12,0">
                            <Grid>
                                <Image Source="default_user_avatar.png" Aspect="AspectFill" IsVisible="{Binding AvatarUrl, Converter={StaticResource InverseStringNullOrEmptyConverter}}" />
                                <Image Source="{Binding AvatarUrl}" Aspect="AspectFill" />
                            </Grid>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" HorizontalOptions="Start" Spacing="2">
                            <Label Text="{Binding FullName}" FontSize="18" FontAttributes="Bold" TextColor="White" />
                            <Label Text="{Binding Nickname, StringFormat='@{0}'}" FontSize="13" TextColor="{StaticResource TextSubtle}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="✕" FontSize="24" TextColor="{StaticResource TextSubtle}" VerticalOptions="Center" HorizontalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:GroupDetailsViewModel}}, Path=CloseMemberDetailsPopupCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>

                    <BoxView HeightRequest="1" Color="{StaticResource Border}" Margin="0,0,0,10" />

                    <!-- Linie rozliczeń -->
                    <ScrollView MaximumHeightRequest="300">
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Lines}" Spacing="5" Padding="0,0,15,0">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="dto:GroupMemberDebtLineDto">
                                    <Grid ColumnDefinitions="36, *, Auto" ColumnSpacing="12" Padding="0,10">
                                        <Border Grid.Column="0" HeightRequest="32" WidthRequest="32" StrokeShape="RoundRectangle 16" BackgroundColor="#1E232D" StrokeThickness="0">
                                            <Grid>
                                                <Image Source="default_user_avatar.png" Aspect="AspectFill" IsVisible="{Binding AvatarUrl, Converter={StaticResource InverseStringNullOrEmptyConverter}}" />
                                                <Image Source="{Binding AvatarUrl}" Aspect="AspectFill" />
                                            </Grid>
                                        </Border>
                                        <Label Grid.Column="1" Text="{Binding CounterpartyName}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextMain}" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                                        <Label Grid.Column="2" Text="{Binding Amount, StringFormat='{0:N2} zł'}" FontSize="15" FontAttributes="Bold" VerticalOptions="Center">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding MemberOwes}" Value="True">
                                                    <Setter Property="TextColor" Value="{StaticResource StatusRed}"/>
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding MemberOwes}" Value="False">
                                                    <Setter Property="TextColor" Value="{StaticResource StatusGreen}"/>
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </ScrollView>

                    <BoxView HeightRequest="1" Color="{StaticResource Border}" Margin="0,10" />
                    <Label Text="{Binding LinesTotal, StringFormat='Suma: {0:N2} zł'}" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource TextMain}" HorizontalOptions="End"/>
                </VerticalStackLayout>
            </Border>
    </Grid>
        <Grid Grid.ColumnSpan="2" IsVisible="{Binding IsPendingInvitationsPopupVisible}" Style="{StaticResource PopupOverlayStyle}" ZIndex="350">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding HidePendingInvitationsCommand}" />
            </Grid.GestureRecognizers>
            <Border StrokeShape="RoundRectangle 10" Style="{StaticResource PopupContainerStyle}" WidthRequest="350" MaximumHeightRequest="400" HorizontalOptions="Center" VerticalOptions="Center">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="20">
                    <Label Text="Wysłane Zaproszenia" FontSize="20" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center"/>

                    <ScrollView>
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding PendingInvitations}" Spacing="10">
                            <BindableLayout.EmptyView>
                                <Label Text="Brak oczekujących zaproszeń." TextColor="#888" HorizontalOptions="Center" Margin="0,20"/>
                            </BindableLayout.EmptyView>
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="dto:AllGroupPendingInvitationResponse">
                                    <Border StrokeShape="RoundRectangle 10" BackgroundColor="#2A303C" StrokeThickness="0" Padding="15,10">
                                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="15" VerticalOptions="Center">

                                            <!-- AVATAR -->
                                            <Border Grid.Column="0" WidthRequest="40" HeightRequest="40" StrokeShape="RoundRectangle 20" StrokeThickness="0" VerticalOptions="Center">
                                                <Image Source="{Binding AvatarUrl}" Aspect="AspectFill" WidthRequest="40" HeightRequest="40" VerticalOptions="Center" />
                                            </Border>

                                            <!-- INFO -->
                                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                                <Label Text="{Binding FullName, StringFormat='{0} {1}'}" FontSize="14" FontAttributes="Bold" TextColor="White" LineBreakMode="TailTruncation">
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label" Binding="{Binding Name}" Value="{x:Null}">
                                                            <Setter Property="Text" Value="{Binding Nickname}"/>
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                                <Label Text="{Binding Nickname, StringFormat='{0} {1}'}" FontSize="10" TextColor="{StaticResource StatusYellow}" FontAttributes="Bold"/>
                                            </VerticalStackLayout>

                                            <!-- USUŃ -->
                                            <ImageButton Grid.Column="2" Source="delete_icon.png" WidthRequest="32" HeightRequest="32" BackgroundColor="Transparent" Padding="4" VerticalOptions="Center"
                                                         Command="{Binding BindingContext.CancelInviteCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                                         CommandParameter="{Binding .}"
                                                         ToolTipProperties.Text="Anuluj zaproszenie"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </ScrollView>

                    <controls:AppButton Text="Zamknij" Command="{Binding HidePendingInvitationsCommand}" ButtonBackgroundColor="{StaticResource SurfaceDark}" ButtonTextColor="{StaticResource TextMain}" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>



